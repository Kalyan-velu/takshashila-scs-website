---
export const prerender = false;

import { getQuizzes } from "@/lib/currentAffairs.ts";

const DATE_FORMAT = new Intl.DateTimeFormat("en-IN", {
  day: "numeric",
  month: "short",
  year: "numeric",
});

const quizzes = await getQuizzes(30);

// This island is the only non-static part of the (build-time compiled) /quiz
// page — cache it at the edge so it still updates through the day without a full rebuild.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=1800, stale-while-revalidate=86400",
);
---

<div class="px-4 py-16 md:px-6 max-w-7xl mx-auto w-full">
  {
    quizzes.length === 0 ? (
      <div class="text-center py-20 bg-gray-100/20 border border-dashed border-gray-200 rounded-3xl max-w-md mx-auto px-6">
        <h3 class="text-xl font-medium mb-2">No Quizzes Available</h3>
        <p class="text-gray-600 font-light text-sm">
          We are currently preparing today's quiz. Please check back soon.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {quizzes.map((quiz) => (
          <a
            href={`/quiz/${quiz.id}/`}
            class="flex flex-col h-full bg-white rounded-3xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow duration-300 p-6 gap-4"
          >
            <div class="flex items-center justify-between gap-3">
              <p class="text-xs font-medium text-primary-500">
                {DATE_FORMAT.format(new Date(quiz.date))}
              </p>
              <span class="text-xs font-medium text-gray-600 bg-gray-100/60 border border-gray-200 rounded-full px-3 py-1 whitespace-nowrap">
                {quiz.questionCount} Question{quiz.questionCount === 1 ? "" : "s"}
              </span>
            </div>

            <h3 class="font-medium text-gray-900 tracking-tight leading-snug text-lg md:text-xl flex-grow">
              {quiz.title}
            </h3>

            {quiz.categories.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {quiz.categories.map((c) => (
                  <span class="text-xs font-medium text-gray-600 bg-gray-100/60 border border-gray-200 rounded-full px-3 py-1">
                    {c.name}
                  </span>
                ))}
              </div>
            )}

            <span class="inline-flex w-full h-11 items-center justify-center rounded-2xl bg-primary-500 text-white hover:bg-primary-500/95 transition-colors font-semibold text-sm">
              Start Quiz
            </span>
          </a>
        ))}
      </div>
    )
  }
</div>
