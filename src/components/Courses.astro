---
import { Check, ArrowRight } from 'lucide-react';

const courses = [
  {
    title: "UPSC Foundation Online",
    description: "Enroll now to secure the Early Bird discount for this course at Takshashila, the best coaching institute for UPSC in Guwahati.",
    price: "Starts from ₹25,000",
    popular: false,
  },
  {
    title: "UPSC Foundation Offline",
    description: "Comprehensive in-person training with expert mentors at our Guwahati center, providing the best environment for UPSC aspirants.",
    price: "Starts from ₹62,500",
    popular: true,
  },
  {
    title: "APSC Foundation Online",
    description: "Flexible online learning tailored for APSC syllabus, ensuring equal opportunities for success from the comfort of your home.",
    price: "Starts from ₹22,000",
    popular: false,
  },
  {
    title: "APSC Foundation Offline",
    description: "Dedicated offline coaching for APSC at Takshashila, the best APSC coaching centre in Guwahati.",
    price: "₹42,500",
    popular: false,
  },
  {
    title: "ADRE Online (New)",
    description: "New specialized online course for ADRE, designed to give you a competitive edge in state government exams.",
    price: "Starts from ₹1,999",
    popular: false,
  },
  {
    title: "ONE YEAR UPSC BATCH",
    description: "“Enroll now to secure the Early Bird discount for this course at Takshashila, the best coaching institute for UPSC in Guwahati!”",
    popular: false,
  },
  {
    title: "ONE YEAR APSC BATCH",
    description: "“Enroll now to secure the Early Bird discount for this course with Takshashila, the best APSC coaching centre in Guwahati!”",
    popular: false,
  },
  {
    title: "THREE YEARS BATCH",
    description: "“Enroll now to secure the Early Bird discount for this course at Takshashila, the best IAS coaching institute in Guwahati!”",
    popular: false,
  }
];

const { id } = Astro.props;
---

<section id={id} class="py-24 bg-muted/20">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-left mb-16">
      <h2 class="text-3xl md:text-5xl font-light tracking-tight text-foreground mb-4">
        Our Popular Courses
      </h2>
      <p class="text-muted-foreground  font-light text-lg max-w-2xl leading-relaxed">
        Join the most comprehensive civil services coaching programs in Guwahati designed for your success.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8  mx-auto">
      {courses.map((course) => (
        <div class={`relative flex flex-col justify-between p-8 rounded-3xl border ${course.popular ? 'border-primary shadow-sm bg-primary/5' : 'border-border bg-card'}`}>
          {course.popular && (
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-primary text-primary-foreground px-4 py-1 rounded-full text-sm font-semibold tracking-wide">
              Most Popular
            </div>
          )}
          
          <div>
            <h3 class="text-2xl font-medium tracking-tight mb-4 mt-2">{course.title}</h3>
            <div class="h-1 w-12 bg-primary/20 rounded-full mb-6">
              <div class="h-1 w-6 bg-primary rounded-full"></div>
            </div>
            {course.price && (
              <div class="mb-4">
                <span class="text-xl font-bold text-primary">{course.price}</span>
              </div>
            )}
            <p class="text-muted-foreground mb-8 font-light italic text-sm md:text-base leading-relaxed">
              {course.description}
            </p>
          </div>
          
          <a href="#enroll" class={`inline-flex h-12 items-center justify-center rounded-xl px-6 text-sm font-medium transition-all w-full gap-2 ${course.popular ? 'bg-primary text-primary-foreground hover:bg-primary/90' : 'border border-border bg-background hover:bg-muted/50 cursor-pointer'}`}>
            Enroll Now
            <ArrowRight className="w-4 h-4" />
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
