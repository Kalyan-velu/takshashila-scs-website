---
import { Picture } from "astro:assets";
import {
  EMAIL,
  PHONE_DISPLAY,
  PHONE_HREF,
  CURRENT_AFFAIRS_URL,
  socials,
} from "@/config/CONSTANTS.ts";
import contentData from "@/data/content.json";

const { footer } = contentData;
---

<footer class="bg-white pt-20 pb-10 border-t border-gray-200">
  <div class="px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <div class="flex flex-col gap-6 lg:col-span-1">
        <a href="/" class="flex items-center gap-2">
          <Picture
            src="/logo.webp"
            formats={["avif", "webp"]}
            alt="Takshasheela Logo"
            class="h-10 object-contain w-auto"
            width={160}
            height={40}
          />
          <span class="font-semibold tracking-tight text-xl">Takshasheela</span>
        </a>
        <p class="text-gray-600 font-light text-sm leading-relaxed">
          {footer.description}
        </p>
        <div class="flex gap-4">
          <a
            href={socials.FACEBOOK}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-600 hover:bg-primary-500 hover:text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
            >
              <path d="M0 0h24v24H0z" fill="none"></path>
              <path
                fill="currentColor"
                d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95"
              ></path>
            </svg>
          </a>
          <a
            href={socials.TWITTER}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter/X"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-600 hover:bg-primary-500 hover:text-white transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
            >
              <path d="M0 0h24v24H0z" fill="none"></path>
              <path
                fill="currentColor"
                d="M22.46 6c-.77.35-1.6.58-2.46.69c.88-.53 1.56-1.37 1.88-2.38c-.83.5-1.75.85-2.72 1.05C18.37 4.5 17.26 4 16 4c-2.35 0-4.27 1.92-4.27 4.29c0 .34.04.67.11.98C8.28 9.09 5.11 7.38 3 4.79c-.37.63-.58 1.37-.58 2.15c0 1.49.75 2.81 1.91 3.56c-.71 0-1.37-.2-1.95-.5v.03c0 2.08 1.48 3.82 3.44 4.21a4.2 4.2 0 0 1-1.93.07a4.28 4.28 0 0 0 4 2.98a8.52 8.52 0 0 1-5.33 1.84q-.51 0-1.02-.06C3.44 20.29 5.7 21 8.12 21C16 21 20.33 14.46 20.33 8.79c0-.19 0-.37-.01-.56c.84-.6 1.56-1.36 2.14-2.23"
              ></path>
            </svg>
          </a>
          <a
            href={socials.INSTAGRAM}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-muted text-muted-foreground hover:bg-primary hover:text-primary-foreground transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
            >
              <path d="M0 0h24v24H0z" fill="none"></path>
              <path
                fill="currentColor"
                d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4zm9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8A1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5a5 5 0 0 1-5 5a5 5 0 0 1-5-5a5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3a3 3 0 0 0 3 3a3 3 0 0 0 3-3a3 3 0 0 0-3-3"
              ></path>
            </svg>
          </a>
          <a
            href={socials.YOUTUBE}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-muted text-muted-foreground hover:bg-primary hover:text-primary-foreground transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 576 512"
            >
              <path
                fill="currentColor"
                d="M549.7 124.1c-6.3-23.7-24.8-42.3-48.3-48.6C458.8 64 288 64 288 64S117.2 64 74.6 75.5c-23.5 6.3-42 24.9-48.3 48.6-11.4 42.9-11.4 132.3-11.4 132.3s0 89.4 11.4 132.3c6.3 23.7 24.8 41.5 48.3 47.8C117.2 448 288 448 288 448s170.8 0 213.4-11.5c23.5-6.3 42-24.2 48.3-47.8 11.4-42.9 11.4-132.3 11.4-132.3s0-89.4-11.4-132.3zm-317.5 213.5V175.2l142.7 81.2-142.7 81.2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      {/* Quick Links */}
      <div>
        <h4 class="font-medium tracking-tight text-lg mb-6">Quick Links</h4>
        <ul class="space-y-3">
          {
            [
              { label: "Home", href: "/" },
              { label: "Team", href: "/team" },
              { label: "About us", href: "/about" },
              {
                label: "Current Affairs",
                href: CURRENT_AFFAIRS_URL,
              },
              { label: "UPSC- APSC", href: "/courses" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-600 hover:text-primary-500 text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Legal Links */}
      <div>
        <h4 class="font-medium tracking-tight text-lg mb-6">Legal</h4>
        <ul class="space-y-3">
          {
            [
              { label: "Privacy Policy", href: "/privacy-policy" },
              { label: "Payment Terms", href: "/payment-terms" },
              { label: "Refund & Cancellation", href: "/refunds-policy" },
              { label: "Disclaimer", href: "/disclaimer" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-600 hover:text-primary-500 text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Contact */}
      <div id="contact">
        <h4 class="font-medium tracking-tight text-lg mb-6">Contact us</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <!--<Phone className="w-5 h-5 text-primary-500 shrink-0 mt-0.5" />-->
            <div>
              <span class="block text-sm font-medium text-gray-900">Phone:</span
              >
              <a
                href={PHONE_HREF}
                class="text-gray-600 hover:text-primary-500 text-sm transition-colors"
                >{PHONE_DISPLAY}</a
              >
            </div>
          </li>
          <li class="flex items-start gap-3">
            <!--<MapPin className="w-5 h-5 text-primary-500 shrink-0 mt-0.5" />-->
            <div>
              <span class="block text-sm font-medium text-gray-900"
                >Address:</span
              >
              <span class="text-gray-600 text-sm">{footer.address}</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <!--<Mail className="w-5 h-5 text-primary-500 shrink-0 mt-0.5" />-->
            <div>
              <span class="block text-sm font-medium text-gray-900"
                >Email address:</span
              >
              <a
                href={`mailto:${EMAIL}`}
                class="text-gray-600 hover:text-primary-500 text-sm transition-colors"
                >{EMAIL}
              </a>
            </div>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="flex flex-col md:flex-row items-center justify-between border-t border-gray-200 pt-8 mt-8"
    >
      <p class="text-sm font-light text-gray-600 mb-4 md:mb-0">
        Copyright © {new Date().getFullYear()} - Takshasheela School of Civil Services
      </p>
    </div>
  </div>
</footer>
