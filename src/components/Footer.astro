---
import { Picture } from "astro:assets";
import {
  EMAIL,
  PHONE_DISPLAY,
  PHONE_HREF,
  CURRENT_AFFAIRS_URL,
  socials,
} from "@/config/CONSTANTS.ts";
import contentData from "@/data/content.json";
import Logo from "@/assets/taksheelascs_logo.png";
const { footer } = contentData;
---

<footer class="bg-white pt-20 pb-10 border-t border-gray-200">
  <div class="px-4 md:px-6 max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      {/* Brand Column */}
      <div class="flex flex-col gap-6 lg:col-span-1">
        <a href="/" class="flex items-center gap-2">
          <Picture
            src={Logo}
            formats={["avif", "webp"]}
            alt="Takshasheela Logo"
            class="object-contain"
            width={260}
            height={70}
          />
          <!--<span class="font-semibold tracking-tight text-xl">Takshasheela</span>-->
        </a>
        <p class="text-gray-600 font-light text-sm leading-relaxed">
          {footer.description}
        </p>
        <div class="flex gap-3">
          <a
            href={socials.FACEBOOK}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-600 hover:bg-primary-500 hover:text-white transition-colors"
          >
            <iconify-icon icon="lucide:facebook" class="text-lg"></iconify-icon>
          </a>
          <a
            href={socials.TWITTER}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Twitter/X"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-600 hover:bg-primary-500 hover:text-white transition-colors"
          >
            <iconify-icon icon="ri:twitter-x-fill" class="text-lg"
            ></iconify-icon>
          </a>
          <a
            href={socials.INSTAGRAM}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-600 hover:bg-primary-500 hover:text-white transition-colors"
          >
            <iconify-icon icon="lucide:instagram" class="text-lg"
            ></iconify-icon>
          </a>
          <a
            href={socials.YOUTUBE}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="YouTube"
            class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-100 text-gray-600 hover:bg-primary-500 hover:text-white transition-colors"
          >
            <iconify-icon icon="lucide:youtube" class="text-lg"></iconify-icon>
          </a>
        </div>
      </div>

      {/* Quick Links */}
      <div>
        <h4 class="font-medium tracking-tight text-lg mb-6">Quick Links</h4>
        <ul class="space-y-3">
          {
            [
              { label: "Home", href: "/" },
              { label: "Team", href: "/team" },
              { label: "About us", href: "/about" },
              {
                label: "Current Affairs",
                href: CURRENT_AFFAIRS_URL,
              },
              { label: "UPSC- APSC", href: "/courses" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-600 hover:text-primary-500 text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Legal Links */}
      <div>
        <h4 class="font-medium tracking-tight text-lg mb-6">Legal</h4>
        <ul class="space-y-3">
          {
            [
              { label: "Privacy Policy", href: "/privacy-policy" },
              { label: "Payment Terms", href: "/payment-terms" },
              { label: "Refund & Cancellation", href: "/refunds-policy" },
              { label: "Disclaimer", href: "/disclaimer" },
            ].map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-gray-600 hover:text-primary-500 text-sm transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <button
              type="button"
              onclick="window.dispatchEvent(new CustomEvent('open-cookie-consent'))"
              class="text-gray-600 hover:text-primary-500 text-sm transition-colors cursor-pointer text-left"
            >
              Cookie Settings
            </button>
          </li>
        </ul>
      </div>

      {/* Contact */}
      <div id="contact">
        <h4 class="font-medium tracking-tight text-lg mb-6">Contact us</h4>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <iconify-icon
              icon="lucide:phone"
              class="text-primary-500 text-lg shrink-0 mt-0.5"></iconify-icon>
            <div>
              <span class="block text-sm font-medium text-gray-900">Phone:</span
              >
              <a
                href={PHONE_HREF}
                class="text-gray-600 hover:text-primary-500 text-sm transition-colors"
              >
                {PHONE_DISPLAY}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <iconify-icon
              icon="lucide:map-pin"
              class="text-primary-500 text-lg shrink-0 mt-0.5"></iconify-icon>
            <div>
              <span class="block text-sm font-medium text-gray-900"
                >Address:</span
              >
              <span class="text-gray-600 text-sm">{footer.address}</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <iconify-icon
              icon="lucide:mail"
              class="text-primary-500 text-lg shrink-0 mt-0.5"></iconify-icon>
            <div>
              <span class="block text-sm font-medium text-gray-900"
                >Email address:</span
              >
              <a
                href={`mailto:${EMAIL}`}
                class="text-gray-600 hover:text-primary-500 text-sm transition-colors"
              >
                {EMAIL}
              </a>
            </div>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom Bar */}
    <div
      class="flex flex-col md:flex-row items-center justify-between border-t border-gray-200 pt-8 mt-8 text-center md:text-left gap-4"
    >
      <p class="text-sm font-light text-gray-600">
        Copyright © {new Date().getFullYear()} Takshasheela School of Civil Services.
        All rights reserved.
      </p>
      <p class="text-xs text-gray-500 font-light">
        A unit of <strong>Takshashila Educational Trust</strong> (Formerly known as
        <em>Takshashila School of Civil Services</em>)
      </p>
    </div>
  </div>
</footer>
