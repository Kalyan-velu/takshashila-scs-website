---
import { getGalleryImagesPage } from "@/lib/currentAffairs.ts";

const PAGE_SIZE = 6;

const { images: initialImages, pagination } = await getGalleryImagesPage(
  1,
  PAGE_SIZE,
);

function captionFor(image: (typeof initialImages)[number]) {
  return image.title || image.categories.map((c) => c.name).join(", ") || "Gallery";
}

function altFor(image: (typeof initialImages)[number]) {
  return (
    image.altTitle ||
    image.title ||
    "Takshasheela School of Civil Services gallery photo"
  );
}
---

<section id="gallery" class="pb-12 bg-white">
  <div class="px-4 md:px-6">
    <div class="mb-12 flex items-end justify-between">
      <div>
        <h2
          class="text-3xl md:text-5xl font-light tracking-tight text-gray-900 mb-4"
        >
          Our Gallery
        </h2>
        <p class="text-gray-600 font-light text-lg">
          Glimpses of life at Takshasheela School of Civil Services.
        </p>
      </div>
    </div>

    {
      initialImages.length === 0 ? (
        <div class="text-center py-20 bg-gray-100/20 border border-dashed border-gray-200 rounded-3xl max-w-md mx-auto px-6">
          <h3 class="text-xl font-medium mb-2">No Photos Available</h3>
          <p class="text-gray-600 font-light text-sm">
            We are currently updating our gallery. Please check back soon.
          </p>
        </div>
      ) : (
        <>
          <div
            class="home-gallery-grid grid grid-cols-2 md:grid-cols-3 gap-4 auto-rows-50 md:auto-rows-75"
            data-page-size={PAGE_SIZE}
            data-next-page={pagination?.hasNextPage ? 2 : ""}
          >
            {initialImages.map((image, index) => (
              <div
                class={`group relative overflow-hidden rounded-2xl bg-gray-100 ${index === 0 ? "md:col-span-2 md:row-span-2" : ""} ${index === 3 ? "md:col-span-2" : ""}`}
              >
                <img
                  src={image.imageUrl}
                  alt={altFor(image)}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
                  <h3 class="text-white font-medium tracking-tight text-lg md:text-xl translate-y-4 group-hover:translate-y-0 transition-transform duration-300 line-clamp-2">
                    {captionFor(image)}
                  </h3>
                </div>
              </div>
            ))}
          </div>

          {pagination?.hasNextPage && (
            <div class="mt-8 flex justify-center">
              <button
                type="button"
                class="home-gallery-more inline-flex items-center gap-2 rounded-full border border-gray-200 px-6 py-2.5 text-sm font-medium text-gray-700 transition-colors hover:border-primary-500 hover:text-primary-500 disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <span class="home-gallery-more-label">View more</span>
              </button>
            </div>
          )}
        </>
      )
    }
  </div>
</section>

<script>
  const grid = document.querySelector<HTMLElement>(".home-gallery-grid");
  const moreBtn = document.querySelector<HTMLButtonElement>(".home-gallery-more");
  const moreLabel = moreBtn?.querySelector<HTMLElement>(".home-gallery-more-label");

  if (grid && moreBtn && moreLabel) {
    const pageSize = Number(grid.dataset.pageSize) || 6;

    function fallbackAlt() {
      return "Takshasheela School of Civil Services gallery photo";
    }

    function captionFor(image: {
      title: string | null;
      categories: { name: string }[];
    }) {
      return (
        image.title ||
        image.categories.map((c) => c.name).join(", ") ||
        "Gallery"
      );
    }

    function altFor(image: { altTitle: string | null; title: string | null }) {
      return image.altTitle || image.title || fallbackAlt();
    }

    function renderItem(image: {
      imageUrl: string;
      title: string | null;
      altTitle: string | null;
      categories: { name: string }[];
    }) {
      const item = document.createElement("div");
      item.className =
        "group relative overflow-hidden rounded-2xl bg-gray-100";

      const img = document.createElement("img");
      img.src = image.imageUrl;
      img.alt = altFor(image);
      img.loading = "lazy";
      img.decoding = "async";
      img.className =
        "h-full w-full object-cover transition-transform duration-500 group-hover:scale-110";

      const overlay = document.createElement("div");
      overlay.className =
        "absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6";

      const caption = document.createElement("h3");
      caption.className =
        "text-white font-medium tracking-tight text-lg md:text-xl translate-y-4 group-hover:translate-y-0 transition-transform duration-300 line-clamp-2";
      caption.textContent = captionFor(image);

      overlay.appendChild(caption);
      item.appendChild(img);
      item.appendChild(overlay);
      grid.appendChild(item);
    }

    moreBtn.addEventListener("click", async () => {
      const nextPage = Number(grid.dataset.nextPage);
      if (!nextPage) return;

      moreBtn.disabled = true;
      const originalLabel = moreLabel.textContent;
      moreLabel.textContent = "Loading…";

      try {
        const res = await fetch(
          `/api/gallery/?page=${nextPage}&limit=${pageSize}`,
        );
        if (!res.ok) throw new Error(`Request failed: ${res.status}`);
        const body = await res.json();

        (body.images ?? []).forEach(renderItem);

        if (body.pagination?.hasNextPage) {
          grid.dataset.nextPage = String(nextPage + 1);
          moreBtn.disabled = false;
          moreLabel.textContent = originalLabel;
        } else {
          moreBtn.remove();
        }
      } catch (err) {
        console.error("Failed to load more gallery images:", err);
        moreBtn.disabled = false;
        moreLabel.textContent = originalLabel;
      }
    });
  }
</script>
