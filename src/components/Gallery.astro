---
import { Image } from 'astro:assets';

const galleryItems = [
  { title: "Special Events", image: "https://images.unsplash.com/photo-1540575467063-178a50c2df87" },
  { title: "Group photo", image: "https://images.unsplash.com/photo-1529156069898-49953e39b3ac" },
  { title: "Library", image: "https://images.unsplash.com/photo-1568667256549-094345857637" },
  { title: "Class room 1", image: "https://images.unsplash.com/photo-1577896851231-70ef18881754" },
  { title: "Students ready for class", image: "https://images.unsplash.com/photo-1523240795612-9a054b0db644" },
  { title: "Online test", image: "https://images.unsplash.com/photo-1516321318423-f06f85e504b3" },
];
---

<section class="py-24 bg-background">
  <div class="container mx-auto px-4 md:px-6">
    <div class="mb-12 flex items-end justify-between">
      <div>
        <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-foreground mb-4">
          Our Gallery
        </h2>
        <p class="text-muted-foreground text-lg">
          Glimpses of life at Takshashila School of Civil Services.
        </p>
      </div>
      
      <div class="hidden md:block">
        <span class="text-sm font-medium text-muted-foreground mr-2">Slide 6 of 14</span>
      </div>
    </div>
    
    <!-- Using a CSS Grid approach to mimic masonry or a nice gallery layout without external JS libs -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 auto-rows-[200px] md:auto-rows-[300px]">
      {galleryItems.map((item, index) => (
        <div class={`group relative overflow-hidden rounded-2xl bg-muted ${index === 0 ? 'md:col-span-2 md:row-span-2' : ''} ${index === 3 ? 'md:col-span-2' : ''}`}>
          <Image 
            src={item.image} 
            alt={item.title} 
            width={800}
            height={600}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
            <h3 class="text-white font-bold text-lg md:text-xl translate-y-4 group-hover:translate-y-0 transition-transform duration-300">{item.title}</h3>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
