---
import { Image } from "astro:assets";

const galleryItems = [
  {
    title: "Special Events",
    alt: "UPSC and APSC students and faculty at a special event at Takshasheela School of Civil Services, Guwahati",
    image: "/storage/2024/04/1689672210_imresizer-1689598168606-scaled.jpg",
  },
  {
    title: "Group photo",
    alt: "Group photo of UPSC and APSC aspirants at Takshasheela coaching institute in Guwahati",
    image: "/storage/2025/06/students-1.jpg",
  },
  {
    title: "Library",
    alt: "Advanced library with UPSC and APSC study material at Takshasheela School of Civil Services, Guwahati",
    image: "/storage/2024/04/IMG_20240408_110125-scaled.jpg",
  },
  {
    title: "Class room 1",
    alt: "UPSC students in a smart classroom at Takshasheela Guwahati",
    image: "/storage/2025/03/IMG_5529-scaled.webp",
  },
  {
    title: "Students ready for class",
    alt: "APSC and UPSC aspirants attending a coaching class at Takshasheela Guwahati",
    image: "/storage/2025/06/students-2.jpg",
  },
  {
    title: "Online test",
    alt: "Students taking an online APSC and UPSC mock test at Takshasheela Guwahati",
    image: "/storage/2025/06/students-3.jpg",
  },
];
---

<section id="gallery" class="pb-12 bg-white">
  <div class="px-4 md:px-6">
    <div class="mb-12 flex items-end justify-between">
      <div>
        <h2
          class="text-3xl md:text-5xl font-light tracking-tight text-gray-900 mb-4"
        >
          Our Gallery
        </h2>
        <p class="text-gray-600 font-light text-lg">
          Glimpses of life at Takshasheela School of Civil Services.
        </p>
      </div>
    </div>

    <div
      class="grid grid-cols-2 md:grid-cols-3 gap-4 auto-rows-50 md:auto-rows-75"
    >
      {
        galleryItems.map((item, index) => (
          <div
            class={`group relative overflow-hidden rounded-2xl bg-gray-100 ${index === 0 ? "md:col-span-2 md:row-span-2" : ""} ${index === 3 ? "m7d:col-span-2" : ""}`}
          >
            <Image
              src={item.image}
              alt={item.alt}
              width={800}
              height={600}
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
              <h3 class="text-white font-medium tracking-tight text-lg md:text-xl translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                {item.title}
              </h3>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
