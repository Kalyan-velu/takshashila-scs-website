---
import {
  CURRENT_AFFAIRS_URL,
  PHONE_DISPLAY,
  PHONE_HREF,
  socials,
} from '@/config/CONSTANTS.ts';

const faqs = [
  {
    q: 'Does Takshasheela offer online coaching for UPSC, APSC, SSC CGL, RRB NTPC, CUET, ADRE and other state-level exams?',
    a: `<div class="space-y-3 pt-0 text-slate-700 leading-relaxed">
  <p>
    Yes! We coach students for a wide range of competitive exams, including:
  </p>
  <ul class="space-y-1.5 list-disc pl-5 marker:text-slate-400">
    <li>
      <span class="font-semibold text-slate-900">Civil Services:</span> <a href="/courses/upsc/" class="text-primary-500 font-medium underline underline-offset-2 hover:text-primary-600">UPSC CSE</a> and <a href="/courses/apsc/" class="text-primary-500 font-medium underline underline-offset-2 hover:text-primary-600">APSC CCE</a>
    </li>
    <li>
      <span class="font-semibold text-slate-900">Banking & Railways:</span> SSC CGL and RRB NTPC
    </li>
    <li>
      <span class="font-semibold text-slate-900">University Entrance:</span> CUET
    </li>
    <li>
      <span class="font-semibold text-slate-900">State-Level:</span> <a href="/courses/adre/" class="text-primary-500 font-medium underline underline-offset-2 hover:text-primary-600">ADRE</a> and <a href="/courses/" class="text-primary-500 font-medium underline underline-offset-2 hover:text-primary-600">other state government exams</a>
    </li>
  </ul>
  <p>
    Every program is delivered through high-definition live interactive online classes with 24/7 access to recorded lectures, digital study material, exam-specific mock test series, and 1-on-1 online mentorship.
  </p>
</div>`,
  },
  {
    q: 'What is the fee structure and installment options for APSC & UPSC courses?',
    a: `<div class="space-y-3 pt-0 text-slate-700 leading-relaxed">
  <p>
    Our foundation programs offer affordable pricing with flexible installment plans:
  </p>
  <ul class="space-y-1.5 list-disc pl-5 marker:text-slate-400">
    <li>
      <span class="font-semibold text-slate-900"><a href="/courses/apsc/" class="text-primary-500 underline underline-offset-2 hover:text-primary-600">APSC Foundation</a>:</span> Online from ₹22,000 (offline ₹42,500 after discount)
    </li>
    <li>
      <span class="font-semibold text-slate-900"><a href="/courses/upsc/" class="text-primary-500 underline underline-offset-2 hover:text-primary-600">UPSC Foundation</a>:</span> Online from ₹25,000 (offline ₹62,500 after discount)
    </li>
  </ul>
  <p>
    Call <a href="${PHONE_HREF}" class="text-primary-500 font-medium underline underline-offset-2 hover:text-primary-600">${PHONE_DISPLAY}</a> for detailed fee charts and scholarship options.
  </p>
</div>`,
  },
  {
    q: 'What are Grade III (Grade 3) and Grade IV (Grade 4) ADRE batches?',
    a: `<div class="space-y-3 pt-0 text-slate-700 leading-relaxed">
  <p>
    Our dedicated <a href="/courses/adre/" class="text-primary-500 font-medium underline underline-offset-2 hover:text-primary-600">ADRE 2026 batch</a> is a specialized 100% online coaching course starting from ₹1999, covering the complete syllabus for:
  </p>
  <ul class="space-y-1.5 list-disc pl-5 marker:text-slate-400">
    <li>
      <span class="font-semibold text-slate-900">Grade III:</span> Graduate & HSSLC level state government posts
    </li>
    <li>
      <span class="font-semibold text-slate-900">Grade IV:</span> State government posts
    </li>
  </ul>
</div>`,
  },
  {
    q: 'Where is Takshasheela School of Civil Services located in Guwahati?',
    a: `<div class="space-y-3 pt-0 text-slate-700 leading-relaxed">
  <p>
    We are located at House no. 65, RG Baruah Rd, AIDC, Ambikagirinagar, Guwahati, Assam 781024 <span class="font-semibold text-slate-900">(Landmark: Daman Medicos)</span>, in close proximity to the Assam Secretariat.
  </p>
  <p>
    <a href="https://www.google.com/maps/search/?api=1&query=Takshasheela+School+of+Civil+Services+RG+Baruah+Rd+AIDC+Ambikagirinagar+Guwahati" target="_blank" rel="noopener noreferrer" class="text-primary-500 font-medium underline underline-offset-2 hover:text-primary-600">Get directions on Google Maps</a>
  </p>
</div>`,
  },
  {
    q: 'Does Takshasheela provide study materials, monthly magazines, and mock tests?',
    a: `<div class="space-y-3 pt-0 text-slate-700 leading-relaxed">
  <p>
    Yes. Depending on your enrolled program, students receive:
  </p>
  <ul class="space-y-1.5 list-disc pl-5 marker:text-slate-400">
    <li>
      <span class="font-semibold text-slate-900">Study Materials:</span> Comprehensive printed and digital study modules tailored to your syllabus.
    </li>
    <li>
      <span class="font-semibold text-slate-900">Current Affairs:</span> Monthly magazines alongside dedicated daily newspaper analysis.
    </li>
    <li>
      <span class="font-semibold text-slate-900">Mock Tests:</span> Regular, exam-specific test series (both sectional and full-length) with detailed evaluations and feedback.
    </li>
  </ul>
</div>`,
  },
  {
    q: 'How can I keep up with current affairs, and how does Takshasheela SCS help students prepare for it?',
    a: `<div class="space-y-3 pt-0 text-slate-700 leading-relaxed">
  <p>
    Staying current with daily news and events is one of the toughest parts of exam preparation. Takshasheela SCS addresses this challenge by offering:
  </p>
  <ul class="space-y-1.5 list-disc pl-5 marker:text-slate-400">
    <li>
      <span class="font-semibold text-slate-900">Daily Current Affairs & Quizzes:</span> Available through our app and <a href="${CURRENT_AFFAIRS_URL}" target="_blank" rel="noopener noreferrer" class="text-primary-500 font-medium underline underline-offset-2 hover:text-primary-600">website</a>, along with integrated discussions tailored to your exam.
    </li>
    <li>
      <span class="font-semibold text-slate-900">Daily Newspaper Analysis:</span> Aspirants also benefit from our faculty's daily newspaper analysis on <a href="${socials.YOUTUBE}" target="_blank" rel="noopener noreferrer" class="text-primary-500 font-medium underline underline-offset-2 hover:text-primary-600">YouTube</a>.
    </li>
  </ul>
</div>`,
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section
  id='faq'
  class='py-16 md:py-24 bg-white border-t border-gray-100 relative z-10'
>
  <div class='px-4 md:px-6 max-w-4xl mx-auto flex flex-col gap-10 md:gap-14'>
    <!-- Section Header -->
    <div class='flex flex-col items-center text-center gap-3'>
      <div
        class='inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary-500/10 text-primary-500 text-xs font-semibold tracking-wide uppercase'
      >
        <iconify-icon
          icon='lucide:help-circle'
          class='text-sm'
        ></iconify-icon>
        FAQ & Guidance
      </div>
      <h2
        class='text-3xl md:text-5xl font-light tracking-tight text-gray-900 leading-tight'
      >
        Frequently Asked <span class='text-primary-500 font-medium italic'
          >Questions</span
        >
      </h2>
      <p
        class='text-base md:text-lg text-gray-600 font-light max-w-xl leading-relaxed'
      >
        Everything you need to know about our UPSC, APSC, and ADRE coaching
        programs, online batches, and admission guidance.
      </p>
    </div>

    <!-- Minimalist Accordion List -->
    <div class='flex flex-col gap-3.5'>
      {
        faqs.map((f) => (
          <details class='group rounded-2xl border border-gray-200/80 bg-gray-50/50 hover:bg-white hover:border-gray-300 transition-all duration-200 px-6 py-4.5 shadow-xs'>
            <summary class='cursor-pointer list-none flex items-center justify-between gap-4 text-base md:text-lg font-medium text-gray-900 group-hover:text-primary-500 transition-colors'>
              <span class='leading-snug'>{f.q}</span>
              <div class='w-8 h-8 rounded-full bg-white border border-gray-200 flex items-center justify-center text-gray-500 group-hover:text-primary-500 group-hover:border-primary-500/30 shrink-0 transition-transform duration-300 group-open:rotate-180'>
                <iconify-icon
                  icon='lucide:chevron-down'
                  class='text-lg'
                />
              </div>
            </summary>
            <div
              set:html={f.a}
              class='mt-3 text-sm md:text-base font-light text-gray-600 leading-relaxed border-t border-gray-100/80 pt-3'
            />
          </details>
        ))
      }
    </div>
  </div>
</section>

<script
  type='application/ld+json'
  set:html={JSON.stringify(faqSchema)}
/>
