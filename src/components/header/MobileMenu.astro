---
import { aboutItems, coursesItems } from "@/data/navigation.ts";
import { CURRENT_AFFAIRS_URL, EMAIL, PHONE_DISPLAY, PHONE_HREF } from "@/config/CONSTANTS.ts";
---

<div class="w-full relative z-40 lg:hidden transition-all duration-300 overflow-hidden bg-white dark:bg-slate-950 border-b border-gray-100 dark:border-slate-900 max-height-0 opacity-0 js-mobile-drawer" style="max-height: 0rem;">
  <div class="w-[200%] flex transition-transform duration-300 ease-out js-mobile-slider-wrapper">
    
    <!-- Level 1: Main links (w-1/2) -->
    <div class="w-1/2 px-5 py-6 overflow-y-auto max-h-[80vh] flex flex-col justify-between shrink-0">
      <div>
        <div class="inline-flex items-center space-x-2 mb-6">
          <div class="bg-primary-500 w-1.5 h-1.5 rounded-full animate-pulse"></div>
          <div class="font-medium text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider">Navigation Menu</div>
        </div>
        <ul class="flex flex-col space-y-4 w-full">
          <li class="relative w-full border-b border-gray-100 dark:border-slate-900/60 pb-3">
            <button class="w-full flex justify-between items-center text-left text-2xl font-bold tracking-tight text-gray-900 dark:text-white cursor-pointer js-mobile-sub-trigger-courses">
              <span>UPSC - APSC Programs</span>
              <iconify-icon icon="lucide:chevron-right" class="text-xl text-gray-400 dark:text-gray-500"></iconify-icon>
            </button>
          </li>
          <li class="relative w-full border-b border-gray-100 dark:border-slate-900/60 pb-3">
            <a href="/team/" class="js-mobile-link block w-full text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Team Faculty</a>
          </li>
          <li class="relative w-full border-b border-gray-100 dark:border-slate-900/60 pb-3">
            <button class="w-full flex justify-between items-center text-left text-2xl font-bold tracking-tight text-gray-900 dark:text-white cursor-pointer js-mobile-sub-trigger-about">
              <span>About Center</span>
              <iconify-icon icon="lucide:chevron-right" class="text-xl text-gray-400 dark:text-gray-500"></iconify-icon>
            </button>
          </li>
          <li class="relative w-full border-b border-gray-100 dark:border-slate-900/60 pb-3">
            <a target="_blank" href={CURRENT_AFFAIRS_URL} class="js-mobile-link block w-full text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Current Affairs</a>
          </li>
          <li class="relative w-full border-b border-gray-100 dark:border-slate-900/60 pb-3">
            <a href="/magazine/" class="js-mobile-link block w-full text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Magazines</a>
          </li>
          <li class="relative w-full border-b border-gray-100 dark:border-slate-900/60 pb-3">
            <a href="/contact/" class="js-mobile-link block w-full text-2xl font-bold tracking-tight text-gray-900 dark:text-white">Contact</a>
          </li>
        </ul>

        <!-- Promo card -->
        <div class="mt-6 p-4 rounded-2xl bg-primary-50/50 dark:bg-slate-900/40 border border-primary-500/10 flex flex-col items-start gap-2">
          <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-primary-100 dark:bg-primary-950/40 text-primary-600 dark:text-primary-400 uppercase tracking-wider">Now Enrolling</span>
          <h4 class="text-base font-semibold text-gray-900 dark:text-white">ADRE 2026 Admissions Open</h4>
          <p class="text-xs text-gray-600 dark:text-gray-400 font-light leading-relaxed mb-1">
            Guwahati's premier preparation batch for Assam Direct Recruitment Exams. Both online and offline study programs are available.
          </p>
          <a href="/courses/adre/" class="js-mobile-link inline-flex px-4 py-2 rounded-full text-xs font-semibold text-white bg-primary-500 hover:bg-primary-600 transition-colors">Learn More &rarr;</a>
        </div>
      </div>

      <!-- Bottom details -->
      <div class="mt-8 pt-4 border-t border-gray-100 dark:border-slate-900">
        <div class="flex flex-col space-y-2 mb-3">
          <a href={PHONE_HREF} class="flex items-center gap-2.5 text-gray-600 dark:text-gray-400 hover:text-primary-500 text-sm">
            <iconify-icon icon="lucide:phone" class="text-[15px] shrink-0"></iconify-icon>
            <span>{PHONE_DISPLAY}</span>
          </a>
          <a href={`mailto:${EMAIL}`} class="flex items-center gap-2.5 text-gray-600 dark:text-gray-400 hover:text-primary-500 text-sm">
            <iconify-icon icon="lucide:mail" class="text-[15px] shrink-0"></iconify-icon>
            <span>{EMAIL}</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Level 2: Sub-lists (w-1/2) -->
    <div class="w-1/2 px-5 py-6 overflow-y-auto max-h-[80vh] flex flex-col justify-between shrink-0">
      <div>
        <button class="inline-flex items-center gap-2 text-primary-500 dark:text-primary-400 text-sm font-semibold mb-6 uppercase tracking-wider cursor-pointer js-mobile-back-button">
          <iconify-icon icon="lucide:chevron-left" class="text-base"></iconify-icon>
          Go back
        </button>

        <!-- Courses list -->
        <div class="js-mobile-sub-list-courses hidden">
          <h3 class="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-4">UPSC - APSC Programs</h3>
          <ul class="flex flex-col space-y-4">
            {coursesItems.map((item) => (
              <li class="border-b border-gray-100 dark:border-slate-900/60 pb-3">
                <a href={item.url} class="js-mobile-link block text-xl font-bold tracking-tight text-gray-900 dark:text-white">{item.title}</a>
              </li>
            ))}
            <li class="pb-3">
              <a href="/courses/" class="js-mobile-link block text-xl font-bold text-primary-500 dark:text-primary-400">View all Programs &rarr;</a>
            </li>
          </ul>
        </div>

        <!-- About list -->
        <div class="js-mobile-sub-list-about hidden">
          <h3 class="text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider mb-4">About our Academy</h3>
          <ul class="flex flex-col space-y-4">
            {aboutItems.map((item) => (
              <li class="border-b border-gray-100 dark:border-slate-900/60 pb-3">
                <a href={item.url} class="js-mobile-link block text-xl font-bold tracking-tight text-gray-900 dark:text-white">{item.title}</a>
              </li>
            ))}
            <li class="border-b border-gray-100 dark:border-slate-900/60 pb-3">
              <a href="/#gallery" class="js-mobile-link block text-xl font-bold tracking-tight text-gray-900 dark:text-white">Campus Gallery</a>
            </li>
          </ul>
        </div>
      </div>
      
      <div class="mt-8 pt-4 border-t border-gray-100 dark:border-slate-900 text-center text-xs text-gray-500">
        Takshasheela School of Civil Services
      </div>
    </div>

  </div>
</div>

<script>
  const drawer          = document.querySelector(".js-mobile-drawer")           as HTMLElement;
  const slider          = document.querySelector(".js-mobile-slider-wrapper")   as HTMLElement;
  const toggle          = document.querySelector(".js-mobile-menu-toggle")      as HTMLElement;
  const logoOverlay     = document.querySelector(".js-logo-scroll-overlay")     as HTMLElement;
  const coursesTrigger  = document.querySelector(".js-mobile-sub-trigger-courses") as HTMLElement;
  const aboutTrigger    = document.querySelector(".js-mobile-sub-trigger-about")   as HTMLElement;
  const backButton      = document.querySelector(".js-mobile-back-button")      as HTMLElement;
  const coursesList     = document.querySelector(".js-mobile-sub-list-courses") as HTMLElement;
  const aboutList       = document.querySelector(".js-mobile-sub-list-about")   as HTMLElement;
  const mobileLinks     = document.querySelectorAll(".js-mobile-link");
  const line1           = document.querySelector(".js-hamburger-line-1");
  const line2           = document.querySelector(".js-hamburger-line-2");
  const line3           = document.querySelector(".js-hamburger-line-3");

  let isOpen = false;

  function openDrawer() {
    isOpen = true;
    // Close menus + search without triggering header:close-mobile (avoids closing self)
    document.dispatchEvent(new CustomEvent("header:close-megamenus"));
    document.dispatchEvent(new CustomEvent("header:close-search"));

    drawer.style.maxHeight = "85vh";
    drawer.classList.remove("opacity-0");
    drawer.classList.add("opacity-100");
    line1?.classList.add("rotate-45", "translate-y-1.25");
    line2?.classList.add("opacity-0");
    line3?.classList.add("-rotate-45", "-translate-y-1.25");
    logoOverlay?.classList.remove("pointer-events-none");
  }

  function closeDrawer() {
    isOpen = false;
    drawer.style.maxHeight = "0rem";
    drawer.classList.remove("opacity-100");
    drawer.classList.add("opacity-0");
    line1?.classList.remove("rotate-45", "translate-y-1.25");
    line2?.classList.remove("opacity-0");
    line3?.classList.remove("-rotate-45", "-translate-y-1.25");
    logoOverlay?.classList.add("pointer-events-none");
    slider.style.transform = "translateX(0%)";
    setTimeout(() => {
      coursesList?.classList.add("hidden");
      aboutList?.classList.add("hidden");
    }, 300);
  }

  // Hamburger toggle
  toggle?.addEventListener("click", () => (isOpen ? closeDrawer() : openDrawer()));

  // Level 2 — Courses
  coursesTrigger?.addEventListener("click", () => {
    coursesList?.classList.remove("hidden");
    aboutList?.classList.add("hidden");
    slider.style.transform = "translateX(-50%)";
  });

  // Level 2 — About
  aboutTrigger?.addEventListener("click", () => {
    aboutList?.classList.remove("hidden");
    coursesList?.classList.add("hidden");
    slider.style.transform = "translateX(-50%)";
  });

  // Back to Level 1
  backButton?.addEventListener("click", () => {
    slider.style.transform = "translateX(0%)";
    setTimeout(() => {
      coursesList?.classList.add("hidden");
      aboutList?.classList.add("hidden");
    }, 300);
  });

  // Close on any mobile nav link click
  mobileLinks.forEach(link => link.addEventListener("click", closeDrawer));

  // Close when scroll or search opens (dispatched by header.ts)
  document.addEventListener("header:close-mobile", closeDrawer);
</script>
