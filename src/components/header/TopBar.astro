---
import {
  EMAIL,
  PHONE_DISPLAY,
  PHONE_HREF,
  socials,
} from '@/config/CONSTANTS.ts';
---

<div
  class='hidden lg:flex items-center justify-between w-full bg-primary-500 dark:bg-slate-950 text-white js-top-bar-wrapper z-45 relative px-8 py-1.5 text-xs font-light'
>
  <!-- Left Side: Phone, Email, Socials -->
  <div
    class='flex items-center gap-x-6 gap-y-2 w-auto justify-start'
  >
    <div class='flex items-center space-x-6'>
      <a
        href={PHONE_HREF}
        class='flex items-center gap-1.5 hover:text-gold-400 transition-colors whitespace-nowrap'
      >
        <iconify-icon
          icon='lucide:phone'
          class='text-[13px] text-gold-500'
        ></iconify-icon>
        {PHONE_DISPLAY}
      </a>
      <a
        href={`mailto:${EMAIL}`}
        class='flex items-center gap-1.5 hover:text-gold-400 transition-colors whitespace-nowrap'
      >
        <iconify-icon
          icon='lucide:mail'
          class='text-[13px] text-gold-500'
        ></iconify-icon>
        {EMAIL}
      </a>
    </div>
    <div class='flex items-center space-x-4'>
      <a
        href={socials.FACEBOOK}
        class='hover:text-gold-400 transition-colors'
        target='_blank'
        aria-label='Facebook'
      >
        <iconify-icon
          icon='lucide:facebook'
          class='text-[14px]'
        ></iconify-icon>
      </a>
      <a
        href={socials.TWITTER}
        class='hover:text-gold-400 transition-colors'
        target='_blank'
        aria-label='Twitter/X'
      >
        <iconify-icon
          icon='ri:twitter-x-fill'
          class='text-[14px]'
        ></iconify-icon>
      </a>
      <a
        href={socials.INSTAGRAM}
        class='hover:text-gold-400 transition-colors'
        target='_blank'
        aria-label='Instagram'
      >
        <iconify-icon
          icon='lucide:instagram'
          class='text-[14px]'
        ></iconify-icon>
      </a>
    </div>
  </div>

  <!-- Right Side: Sitemap, Search -->
  <div
    class='flex items-center space-x-4 mt-2 lg:mt-0 w-full lg:w-auto justify-center lg:justify-end'
  >
    <button
      class='inline-flex w-7 h-7 md:w-8 md:h-8 items-center justify-center rounded-full transition-colors cursor-pointer bg-gold-500 text-primary-900 hover:bg-gold-400 js-search-toggle'
      title='Search Site'
    >
      <span class='sr-only'>Toggle search</span>
      <iconify-icon
        icon='lucide:search'
        class='text-[14px] block js-search-icon-search'
      ></iconify-icon>
      <iconify-icon
        icon='lucide:x'
        class='text-[14px] hidden js-search-icon-close'
      ></iconify-icon>
    </button>
    <a
      href='/sitemap/'
      class='hover:text-gold-400 transition-colors font-medium'
      >Sitemap</a
    >
  </div>
</div>
