---
import { EMAIL, PHONE_DISPLAY, PHONE_HREF, socials } from "@/config/CONSTANTS.ts";
import AnnouncementTicker from "./AnnouncementTicker.astro";
---

<div class="flex items-stretch w-full border-b border-gray-100 dark:border-slate-900 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md js-top-bar-wrapper overflow-hidden z-45 relative">
  
  <!-- Left Side (Top Bar Content) - Hidden on Mobile -->
  <div class="hidden lg:flex items-center relative z-10 bg-white dark:bg-slate-950 pl-6 pr-8 py-1.5 text-[11px] lg:text-xs font-light text-gray-600 dark:text-gray-300">
    <div class="flex items-center space-x-6 mr-6">
      <a href={PHONE_HREF} class="flex items-center gap-1.5 hover:text-primary-500 transition-colors whitespace-nowrap">
        <iconify-icon icon="lucide:phone" class="text-[13px]"></iconify-icon>
        {PHONE_DISPLAY}
      </a>
      <a href={`mailto:${EMAIL}`} class="flex items-center gap-1.5 hover:text-primary-500 transition-colors whitespace-nowrap">
        <iconify-icon icon="lucide:mail" class="text-[13px]"></iconify-icon>
        {EMAIL}
      </a>
    </div>
    <div class="flex items-center space-x-4 pr-2">
      <a href={socials.FACEBOOK} class="hover:text-primary-500 transition-colors" target="_blank" aria-label="Facebook">
        <iconify-icon icon="lucide:facebook" class="text-[14px]"></iconify-icon>
      </a>
      <a href={socials.TWITTER} class="hover:text-primary-500 transition-colors" target="_blank" aria-label="Twitter/X">
        <iconify-icon icon="ri:twitter-x-fill" class="text-[14px]"></iconify-icon>
      </a>
      <a href={socials.INSTAGRAM} class="hover:text-primary-500 transition-colors" target="_blank" aria-label="Instagram">
        <iconify-icon icon="lucide:instagram" class="text-[14px]"></iconify-icon>
      </a>
    </div>
    
    <!-- The Slant (/) Design -->
    <div class="absolute top-0 -right-4 h-full w-8 bg-white dark:bg-slate-950 origin-bottom transform skew-x-[25deg] border-r border-gray-200 dark:border-slate-800" style="z-index: -1;"></div>
  </div>

  <!-- Right Side (Announcement) - Full width on Mobile, remaining on Desktop -->
  <div class="flex-1 flex items-center relative z-0 overflow-hidden w-full">
    <AnnouncementTicker />
  </div>

</div>
