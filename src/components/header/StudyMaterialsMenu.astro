---
import { CURRENT_AFFAIRS_URL } from '@/config/CONSTANTS.ts';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  const normalized = (path: string) => path.replace(/\/+$/, '') || '/';
  return normalized(href) === normalized(currentPath);
}

const items = [
  {
    title: 'Magazine',
    description: 'Curated reads and exam-oriented insights',
    url: '/magazine/',
    icon: 'lucide:book-open',
  },
  {
    title: 'Current Affairs',
    description: 'Daily UPSC & APSC focused news summaries',
    url: CURRENT_AFFAIRS_URL,
    icon: 'lucide:newspaper',
    target: '_blank',
  },
  {
    title: 'Quiz',
    description: 'Test your prep with quick daily quizzes',
    url: '/quiz/',
    icon: 'lucide:brain-circuit',
  },
];
---

<div
  id='mega-menu-study-materials'
  class='absolute left-0 right-0 z-20 w-full bg-white dark:bg-slate-900 border-b border-gray-200 dark:border-slate-800 shadow-2xl invisible opacity-0 -translate-y-4 pointer-events-none transition-all duration-300 overflow-hidden js-mega-menu-study-materials'
>
  <div class='max-w-7xl mx-auto px-6 py-10 md:py-12'>
    <h3
      class='text-xs font-bold text-gray-800 dark:text-gray-200 uppercase tracking-wider mb-5 border-b border-gray-100 dark:border-slate-800 pb-2'
    >
      Free Study Materials
    </h3>
    <div class='grid grid-cols-1 md:grid-cols-3 gap-4'>
      {
        items.map((item) => (
          <a
            href={item.url}
            target={item.target}
            aria-current={isActive(item.url) ? 'page' : undefined}
            class={`js-mega-link group flex items-start gap-3 p-4 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800/40 transition-colors ${isActive(item.url) ? 'bg-gray-50 dark:bg-slate-800/40' : ''}`}
          >
            <span class='flex items-center justify-center w-10 h-10 rounded-full bg-primary-50 dark:bg-slate-800 text-primary-500 shrink-0'>
              <iconify-icon icon={item.icon} class='text-[18px]' />
            </span>
            <div class='flex flex-col'>
              <span
                class={`text-base transition-colors ${isActive(item.url) ? 'font-bold text-gray-900 dark:text-white' : 'font-medium text-gray-700 dark:text-gray-200 group-hover:text-gray-900 dark:group-hover:text-white'}`}
              >
                {item.title}
              </span>
              <span class='text-xs text-gray-600 dark:text-gray-400 mt-0.5 font-light'>
                {item.description}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>
