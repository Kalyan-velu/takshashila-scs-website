---
import {
  coursesItems,
  coursesFeatured,
  aboutItems,
  aboutFeatured,
} from "@/data/navigation.ts";
import { CURRENT_AFFAIRS_URL } from "@/config/CONSTANTS.ts";

interface Props {
  menuId: number;
}

const { menuId } = Astro.props;

// Determine menu column properties
const isCourses = menuId === 7;
const col1Title = isCourses ? "Coaching Programs" : "Who We Are";
const col2Title = isCourses ? "Prep Resources" : "Life at Takshasheela";
const containerClass = isCourses
  ? "js-mega-menu-courses"
  : "js-mega-menu-about";

const itemsList1 = isCourses ? coursesItems : aboutItems;

const itemsList2 = isCourses
  ? [
      {
        title: "Daily Current Affairs",
        description: "UPSC and APSC focused daily news summaries",
        url: CURRENT_AFFAIRS_URL,
      },
      {
        title: "Syllabus & Guidelines",
        description: "Latest exam syllabus and official notification guides",
        url: "/courses/",
      },
      {
        title: "Free Daily Mock Tests",
        description: "Assess your preparation with regular mini mock exams",
        url: CURRENT_AFFAIRS_URL,
      },
    ]
  : [
      {
        title: "Photo Gallery",
        description: "Take a tour of our classrooms, library, and campus",
        url: "/#gallery",
      },
      {
        title: "Success Stories",
        description: "Hear from our students who cleared UPSC & APSC",
        url: "/about/",
      },
      {
        title: "Why Choose Takshasheela",
        description: "What makes us Guwahati's premier coaching center",
        url: "/#about",
      },
    ];

const featuredItem = isCourses ? coursesFeatured : aboutFeatured;
---

<div
  id={isCourses ? "mega-menu-courses" : "mega-menu-about"}
  class={`absolute left-0 right-0 z-20 w-full bg-white dark:bg-slate-900 border-b border-gray-200 dark:border-slate-800 shadow-2xl invisible opacity-0 -translate-y-4 pointer-events-none transition-all duration-300 overflow-hidden ${containerClass}`}
>
  <div
    class="max-w-7xl mx-auto px-6 py-10 md:py-12 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12"
  >
    <div class="md:col-span-4">
      <h3
        class="text-xs font-bold text-primary-500 dark:text-primary-400 uppercase tracking-wider mb-5 border-b border-gray-100 dark:border-slate-800 pb-2"
      >
        {col1Title}
      </h3>
      <div class="flex flex-col space-y-1">
        {
          itemsList1.map((item) => (
            <a
              href={item.url}
              class="js-mega-link group flex flex-col p-3 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800/40 transition-colors"
            >
              <div class="flex items-center justify-between">
                <span class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-primary-500 transition-colors">
                  {item.title}
                </span>
                <iconify-icon
                  icon="lucide:chevron-right"
                  class="text-[16px] text-gray-400 dark:text-gray-500 transform group-hover:translate-x-1 transition-all opacity-0 group-hover:opacity-100"
                />
              </div>
              <span class="text-xs text-gray-600 dark:text-gray-400 mt-0.5 font-light line-clamp-1">
                {item.description}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="md:col-span-4">
      <h3
        class="text-xs font-bold text-primary-500 dark:text-primary-400 uppercase tracking-wider mb-5 border-b border-gray-100 dark:border-slate-800 pb-2"
      >
        {col2Title}
      </h3>
      <div class="flex flex-col space-y-1">
        {
          itemsList2.map((item) => (
            <a
              href={item.url}
              class="js-mega-link group flex flex-col p-3 rounded-xl hover:bg-gray-50 dark:hover:bg-slate-800/40 transition-colors"
            >
              <div class="flex items-center justify-between">
                <span class="text-base font-semibold text-gray-900 dark:text-white group-hover:text-primary-500 transition-colors">
                  {item.title}
                </span>
                <iconify-icon
                  icon="lucide:chevron-right"
                  class="text-[16px] text-gray-400 dark:text-gray-500 transform group-hover:translate-x-1 transition-all opacity-0 group-hover:opacity-100"
                />
              </div>
              <span class="text-xs text-gray-600 dark:text-gray-400 mt-0.5 font-light line-clamp-1">
                {item.description}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <div class="md:col-span-4">
      <h3
        class="text-xs font-bold text-primary-500 dark:text-primary-400 uppercase tracking-wider mb-5 border-b border-gray-100 dark:border-slate-800 pb-2"
      >
        Featured Preview
      </h3>
      <a
        href={featuredItem.url}
        class="js-mega-link group block relative overflow-hidden rounded-2xl bg-gray-50 dark:bg-slate-800/30 border border-gray-100 dark:border-slate-800/60 p-4 hover:border-primary-500/30 hover:shadow-md transition-all duration-300"
      >
        <div
          class="relative overflow-hidden rounded-xl aspect-[16/9] mb-4 bg-gray-200 dark:bg-slate-850"
        >
          <img
            src={featuredItem.image}
            alt={featuredItem.title}
            loading="lazy"
            class="w-full h-full object-cover transform group-hover:scale-103 transition-transform duration-500"
          />
          <div
            class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent pointer-events-none"
          >
          </div>
        </div>
        <div class="flex items-center justify-between">
          <h4
            class="text-base font-semibold text-gray-900 group-hover:text-primary-500 transition-colors"
          >
            {featuredItem.title}
          </h4>
          <span
            class="dark:text-primary-400 font-semibold text-sm group-hover:translate-x-1 transition-transform flex items-center gap-1 select-none"
          >
            Explore &rarr;
          </span>
        </div>
        <p
          class="text-xs text-gray-600 dark:text-gray-400 mt-1 font-light line-clamp-2"
        >
          {featuredItem.description}
        </p>
      </a>
    </div>
  </div>
</div>
