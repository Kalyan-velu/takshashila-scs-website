---
import TopBar from './TopBar.astro';
import DesktopNav from './DesktopNav.astro';
import HeaderActions from './HeaderActions.astro';
import MegaMenu from './MegaMenu.astro';
import StudyMaterialsMenu from './StudyMaterialsMenu.astro';
import SearchDropdown from './SearchDropdown.astro';
import MobileMenu from './MobileMenu.astro';
import { Image } from 'astro:assets';
import Logo from '@/assets/taksheelascs_logo.png';
---

<TopBar />
<div
  class={`sticky top-0 w-full inline-flex  isolate flex-col items-center z-40 js-header-container group`}
>
  <div class='w-full js-header-wrapper'>
    <header
      class='flex flex-nowrap items-center justify-between relative z-30 transition-all duration-300 py-1.5 js-header bg-white/95 backdrop-blur-md dark:bg-black/95 border-gray-200 dark:border-black shadow-sm w-full md:px-4'
    >
      <div
        class='absolute top-0 left-0 w-full h-full lg:hidden js-logo-scroll-overlay pointer-events-none'
      >
      </div>

      <div class='mx-4 relative z-10 shrink-0'>
        <a
          href='/'
          class='transition-opacity rounded-xl hover:opacity-90 block'
        >
          <div class='sr-only'>Takshasheela Logo link to home page</div>
          <Image
            src={Logo}
            alt='Takshasheela Logo'
            fetchpriority='high'
            widths={[224, 448]}
            sizes='(max-width: 48rem) 11rem, 14rem'
            class='h-auto transition-all bg-transparent duration-300 w-44 sm:w-40 md:w-66 js-header-logo'
          />
        </a>
      </div>
      <DesktopNav />
      <HeaderActions />
    </header>
    <SearchDropdown />
    <MegaMenu menuId={7} />
    <MegaMenu menuId={5} />
    <StudyMaterialsMenu />
    <MobileMenu />
  </div>
</div>

<script>
  import './header.ts';
</script>
