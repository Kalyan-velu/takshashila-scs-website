---
import type { Fragment } from 'react';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  const normalized = (path: string) => path.replace(/\/+$/, '') || '/';
  return normalized(href) === normalized(currentPath);
}

const isCoursesActive = currentPath.startsWith('/courses');
const isAboutActive = isActive('/about/');
const isStudyMaterialsActive = isActive('/magazine/') || isActive('/quiz/');

const dropdownNavItems = [
  {
    label: 'Courses',
    triggerClass: 'js-menu-trigger-courses',
    chevronClass: 'js-chevron-courses',
    controlsId: 'mega-menu-courses',
    active: isCoursesActive,
  },
  {
    label: 'About',
    triggerClass: 'js-menu-trigger-about',
    chevronClass: 'js-chevron-about',
    controlsId: 'mega-menu-about',
    active: isAboutActive,
  },
  {
    label: 'Free Study Materials',
    triggerClass: 'js-menu-trigger-study-materials',
    chevronClass: 'js-chevron-study-materials',
    controlsId: 'mega-menu-study-materials',
    active: isStudyMaterialsActive,
  },
];

const directNavItems = [
  {
    label: 'Faculty',
    href: '/faculty/',
  },
  {
    label: 'Blogs',
    href: '/blogs/',
  },
  {
    label: 'Gallery',
    href: '/gallery/',
  },
  {
    label: 'Contact',
    href: '/contact/',
  },
];

const navLinkClass =
  'nav-link font-medium text-base  leading-tight transition-colors  text-gray-800  dark:text-gray-200  hover:text-primary-500  dark:hover:text-primary-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 rounded-sm';

const dropdownNavLinkClass = `${navLinkClass} flex items-center gap-1 cursor-pointer bg-transparent border-0 p-0`;

const activeClass = 'nav-link-active text-primary-500 dark:text-primary-400';
---

<nav class='hidden lg:inline-flex items-center h-full'>
  <ul
    class='flex items-center flex-wrap justify-center space-x-4 md:space-x-8 h-full'
  >
    {
      dropdownNavItems.map((item) => (
        <li class={`relative flex items-center h-full py-4`}>
          <button
            type='button'
            aria-expanded='false'
            aria-haspopup='true'
            aria-controls={item.controlsId}
            class={`${dropdownNavLinkClass}  ${item.triggerClass} ${item.active ? activeClass : ''}`}
          >
            {item.label}
            <iconify-icon
              icon='lucide:chevron-down'
              class={`text-[14px] transition-transform duration-300 ${item.chevronClass}`}
            />
          </button>
        </li>
      ))
    }

    {
      directNavItems.map((item) => (
        <li class='relative flex items-center h-full py-4 js-menu-trigger-direct'>
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class={`${navLinkClass} ${isActive(item.href) ? activeClass : ''}`}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  @reference "../../styles/globals.css";

  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    width: 100%;
    transform: scaleX(0);
    height: 2px;
    bottom: -4px;
    left: 0;
    background-color: var(--color-primary-500);
    transform-origin: bottom center;
    transition: transform 0.25s ease-out;
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after,
  .nav-link-active::after {
    transform: scaleX(1);
  }
</style>
