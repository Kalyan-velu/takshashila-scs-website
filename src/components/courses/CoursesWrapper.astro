---
import CoursesCarousel from "@/components/courses/CoursesCarousel.vue";
import { CATEGORIES } from "@/data/category.ts";
import { getCollection } from "astro:content";
import { SITE_URL } from "@/config/CONSTANTS.ts";

interface Props {
  id?: string;
}

const { id = "courses" } = Astro.props;

const allEntries = await getCollection("courses");
const aboutCourseEntries = allEntries.filter(
  (e) => e.data.type === "about-course" && e.data.courses,
);
const courses = aboutCourseEntries.flatMap((e) =>
  (e.data.courses ?? []).map((c) => ({
    ...c,
    url: `/courses/${e.data.courseSlug}/`,
    parentPrice: e.data.price,
    parentPricePeriod: e.data.pricePeriod,
  })),
);

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: aboutCourseEntries.map((e, index) => {
    const firstItem = e.data.courses?.[0];
    const hasCourseInstance = [];
    if (firstItem?.prices?.online) {
      hasCourseInstance.push({
        "@type": "CourseInstance",
        courseMode: "online",
        offers: {
          "@type": "Offer",
          price: String(
            firstItem.prices.online.original - firstItem.prices.online.discount,
          ),
          priceCurrency: "INR",
        },
      });
    }
    if (firstItem?.prices?.offline) {
      hasCourseInstance.push({
        "@type": "CourseInstance",
        courseMode: "onsite",
        offers: {
          "@type": "Offer",
          price: String(
            firstItem.prices.offline.original -
              firstItem.prices.offline.discount,
          ),
          priceCurrency: "INR",
        },
      });
    }
    if (hasCourseInstance.length === 0 && firstItem?.modes) {
      firstItem.modes.forEach((mode) =>
        hasCourseInstance.push({
          "@type": "CourseInstance",
          courseMode: mode === "offline" ? "onsite" : "online",
        }),
      );
    }

    return {
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Course",
        name: e.data.title,
        description: e.data.seoDescription ?? e.data.description,
        url: `${SITE_URL}/courses/${e.data.courseSlug}/`,
        provider: { "@id": `${SITE_URL}/#organization` },
        hasCourseInstance,
      },
    };
  }),
};
---

<section
  id={id}
  class="py-16 md:py-24 bg-white relative z-10 border-t border-gray-100"
>
  <div class="px-4 md:px-6 max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-12">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary-500/10 text-primary-500 text-xs font-semibold uppercase tracking-wider mb-4"
      >
        <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
        Explore Our Offerings
      </div>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-light tracking-tight text-gray-900 leading-tight"
      >
        Our Courses at <span class="text-primary-500 italic font-medium"
          >Takshashila SCS</span
        >
      </h2>
      <p
        class="mt-4 text-base md:text-lg text-gray-600 font-light leading-relaxed"
      >
        Comprehensive APSC CCE, UPSC CSE, and ADRE preparation modules
        engineered with top Delhi & Assam faculty, structured test series, and
        dedicated mentorship.
      </p>
    </div>

    <!-- Courses Carousel Vue Island -->
    <CoursesCarousel
      client:load="vue"
      courses={courses}
      categories={CATEGORIES}
    />
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
