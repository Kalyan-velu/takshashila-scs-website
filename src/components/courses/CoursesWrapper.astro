---
// import CoursesCarousel from "@/components/courses/CoursesCarousel.vue";
import { CATEGORIES, CATEGORY_MAP } from "@/data/category.ts";
import { getCollection } from "astro:content";
import { SITE_URL } from "@/config/CONSTANTS.ts";

const { id } = Astro.props;

const allEntries = await getCollection("courses");
const aboutCourseEntries = allEntries.filter(
  (e) => e.data.type === "about-course" && e.data.courses,
);
const courses = aboutCourseEntries.flatMap((e) =>
  (e.data.courses ?? []).map((c) => ({
    ...c,
    url: `/courses/${e.data.courseSlug}/`,
  })),
);

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  itemListElement: aboutCourseEntries.map((e, index) => {
    const firstItem = e.data.courses?.[0];
    const hasCourseInstance = [];
    if (firstItem?.prices?.online) {
      hasCourseInstance.push({
        "@type": "CourseInstance",
        courseMode: "online",
        offers: {
          "@type": "Offer",
          price: String(
            firstItem.prices.online.original - firstItem.prices.online.discount,
          ),
          priceCurrency: "INR",
        },
      });
    }
    if (firstItem?.prices?.offline) {
      hasCourseInstance.push({
        "@type": "CourseInstance",
        courseMode: "onsite",
        offers: {
          "@type": "Offer",
          price: String(
            firstItem.prices.offline.original -
              firstItem.prices.offline.discount,
          ),
          priceCurrency: "INR",
        },
      });
    }
    if (hasCourseInstance.length === 0 && firstItem?.modes) {
      firstItem.modes.forEach((mode) =>
        hasCourseInstance.push({
          "@type": "CourseInstance",
          courseMode: mode === "offline" ? "onsite" : "online",
        }),
      );
    }

    return {
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Course",
        name: e.data.title,
        description: e.data.seoDescription ?? e.data.description,
        url: `${SITE_URL}/courses/${e.data.courseSlug}/`,
        provider: { "@id": `${SITE_URL}/#organization` },
        hasCourseInstance,
      },
    };
  }),
};
---

<section id={id} class="pb-12 scroll-pt-4 lg:pb-32 bg-background">
  <div class="px-4 md:px-6 max-w-7xl mx-auto">
    <div class="flex-col lg:flex-row flex lg:items-center lg:justify-between">
      <div class="text-left mb-10">
        <h2
          class="text-3xl md:text-5xl font-light tracking-tight text-gray-900 mb-4"
        >
          Our APSC, UPSC &amp; ADRE Coaching Courses
        </h2>
        <p class="text-gray-600 font-light text-lg max-w-2xl leading-relaxed">
          Join the most comprehensive civil services coaching programs in
          Guwahati designed for your success.
        </p>
      </div>

      <div
        class="flex items-center gap-3 mb-10 overflow-x-auto hide-scrollbar pb-2"
      >
        {
          CATEGORIES.map((tab, i) => (
            <button
              class={`course-tab whitespace-nowrap shrink-0 px-6 py-2.5 rounded-full border text-sm md:text-base font-medium transition-colors ${i === 0 ? "bg-primary-500 text-white border-primary-500" : "bg-white border-gray-200 text-gray-600 hover:border-primary-500/50"}`}
              data-target={CATEGORY_MAP[tab]}
            >
              {CATEGORY_MAP[tab]
                .replace(/-/g, " ")
                .split(" ")
                .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
                .join(" ")}
            </button>
          ))
        }
      </div>
    </div>
    <!--<CoursesCarousel courses={courses} client:only="vue" />-->
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>

<script>
  function setupCourseTabs() {
    const tabs = document.querySelectorAll(
      ".course-tab",
    ) as NodeListOf<HTMLButtonElement>;

    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        // Active tab styling
        tabs.forEach((t) => {
          t.classList.remove(
            "bg-primary-500",
            "text-white",
            "border-primary-500",
          );
          t.classList.add("bg-white", "border-gray-200", "text-gray-600");
        });
        tab.classList.remove("bg-white", "border-gray-200", "text-gray-600");
        tab.classList.add("bg-primary-500", "text-white", "border-primary-500");

        const target = tab.getAttribute("data-target");
        window.dispatchEvent(
          new CustomEvent("course-tab-change", { detail: { tab: target } }),
        );
      });
    });
  }

  // Run on initial load and view transitions
  setupCourseTabs();
  document.addEventListener("astro:page-load", setupCourseTabs);
</script>
