---
import { getFacultyList } from "@/lib/team";

interface Props {
  id?: string;
}

const { id = "faculty" } = Astro.props;

const facultyList = getFacultyList();
---

<section id={id} class="py-16 md:py-24 bg-white relative z-10 border-t border-gray-100">
  <div class="px-4 md:px-6 max-w-7xl mx-auto">
    <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary-500/10 text-primary-500 text-xs font-semibold uppercase tracking-wider mb-4">
        <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
        Meet Your Mentors
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-light tracking-tight text-gray-900 leading-tight">
        Learn From <span class="text-primary-500 italic font-medium">Delhi & Assam's Top Faculty</span>
      </h2>
      <p class="mt-4 text-base md:text-lg text-gray-600 font-light leading-relaxed">
        Every mentor at Takshasheela brings 3-10+ years of classroom experience from institutes like Unacademy, Drishti IAS, and Vision IAS — now teaching in Guwahati.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6">
      {
        facultyList.map((member) => (
          <a
            href={`/faculty/${member.slug}/`}
            class="group flex flex-col rounded-2xl border border-gray-200 bg-white overflow-hidden shadow-xs hover:shadow-xl hover:border-primary-500/40 transition-all duration-300 hover:-translate-y-1"
          >
            <div class="relative aspect-4/5 w-full overflow-hidden bg-gray-100">
              <img
                src={member.image}
                alt={`${member.name} — Faculty at Takshashila School of Civil Services`}
                width="400"
                height="500"
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              />
            </div>

            <div class="p-4 flex flex-col bg-white border-t border-gray-100">
              <h3 class="font-semibold text-gray-900 text-base tracking-tight group-hover:text-primary-500 transition-colors">
                {member.name}
              </h3>
              <div class="flex flex-wrap gap-1 mt-1.5">
                {member.expertise.slice(0, 2).map((subject) => (
                  <span class="inline-block px-2 py-0.5 bg-primary-500/10 text-primary-500 text-[10px] font-semibold rounded-full">
                    {subject}
                  </span>
                ))}
              </div>
              {member.associations[0] && (
                <p class="text-xs text-gray-500 font-light mt-2 flex items-center gap-1">
                  <iconify-icon icon="lucide:badge-check" class="text-emerald-600 text-xs shrink-0" />
                  <span class="truncate">{member.associations[0]}</span>
                </p>
              )}
            </div>
          </a>
        ))
      }
    </div>

    <div class="flex justify-center mt-10">
      <a
        href="/faculty/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary-500 text-white font-medium text-sm hover:bg-primary-600 transition-colors shadow-md hover:shadow-lg"
      >
        View All Faculty
        <iconify-icon icon="lucide:arrow-right" class="text-base"></iconify-icon>
      </a>
    </div>
  </div>
</section>
