---
import { PHONE_HREF, PHONE_DISPLAY, whatsappUrl } from "@/config/CONSTANTS.ts";

const whatsappMessage =
  "I am on your website and I want to know more about the APSC course";
const whatsappHref = whatsappUrl(whatsappMessage);
---

<section class="lead-form-section">
  <div data-lead-form-card class="lead-form-card">
    <div class="lead-form-header">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-500/10 text-primary-500 text-xs font-semibold uppercase tracking-wider mb-3"
      >
        <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
        Admissions Open 2026
      </div>
      <h2 class="lead-form-title">
        APSC Foundation Course Admission Going On — Join Us
      </h2>
      <p class="lead-form-subtitle">
        Get expert mentorship from Delhi & Assam faculty, structured Prelims &
        Mains answer writing, test series, and interview guidance.
      </p>

      <!-- Integrated Action CTA Buttons -->
      <div class="flex flex-wrap items-center gap-2.5 mt-5">
        <a
          href={PHONE_HREF}
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-primary-500 hover:bg-primary-600 text-white font-medium text-xs transition-all shadow-xs hover:shadow-md"
        >
          <iconify-icon icon="lucide:phone-call" class="text-sm"></iconify-icon>
          <span>Call Us ({PHONE_DISPLAY})</span>
        </a>

        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs transition-all shadow-xs hover:shadow-md"
        >
          <iconify-icon icon="ri:whatsapp-fill" class="text-base"
          ></iconify-icon>
          <span>WhatsApp Us</span>
        </a>

        <button
          type="button"
          disabled
          title="Enrollment is currently managed via phone or WhatsApp"
          class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-full bg-gray-100 text-gray-400 border border-gray-200 font-medium text-xs cursor-not-allowed select-none"
        >
          <iconify-icon icon="lucide:lock" class="text-xs text-gray-400"
          ></iconify-icon>
          <span>Enroll (Disabled)</span>
        </button>
      </div>
    </div>

    <form data-lead-form class="lead-form-element">
      <div class="lead-form__field">
        <label for="phone" class="sr-only"> Phone Number </label>
        <div class="lead-form__icon-wrapper">
          <iconify-icon icon="lucide:phone" class="lead-form__icon"
          ></iconify-icon>
        </div>
        <input
          type="tel"
          id="phone"
          name="phone"
          placeholder="Enter your phone number..."
          class="lead-form__input lead-form__input--lg"
          required
        />
      </div>

      <div
        data-expanded-fields
        class="lead-form__expanded-fields lead-form__expanded-fields--collapsed"
      >
        <div class="lead-form__field">
          <label for="name" class="sr-only"> Full Name </label>
          <div class="lead-form__icon-wrapper">
            <iconify-icon icon="lucide:user" class="lead-form__icon"
            ></iconify-icon>
          </div>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="Your Full Name"
            class="lead-form__input"
            data-expanded-required
          />
        </div>

        <div class="lead-form__field">
          <label for="course" class="sr-only"> Select Course </label>
          <div class="lead-form__icon-wrapper">
            <iconify-icon icon="lucide:book-open" class="lead-form__icon"
            ></iconify-icon>
          </div>
          <select
            id="course"
            name="course"
            class="lead-form__select"
            data-expanded-required
          >
            <option value="" disabled selected>
              Select your target course...
            </option>
            <option value="apsc">APSC Foundation Batch</option>
            <option value="upsc">UPSC Foundation Batch</option>
            <option value="adre">ADRE Online Batch</option>
          </select>

          <div class="lead-form__chevron-container">
            <svg
              class="lead-form__chevron-icon"
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 20 20"
            >
              <path
                d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"
              ></path>
            </svg>
          </div>
        </div>

        <!-- Cloudflare Turnstile Captcha -->
        <div id="hero-turnstile" class="my-1"></div>

        <button type="submit" class="lead-form__submit-button">
          <span>Start My Journey</span>
          <iconify-icon icon="lucide:arrow-right" class="lead-form__arrow-icon"
          ></iconify-icon>
        </button>
      </div>

      <button
        type="button"
        data-continue-button
        class="lead-form__continue-button"
      >
        Continue
      </button>
    </form>

    <!-- Success Feedback View -->
    <div
      id="hero-lead-success"
      class="hidden w-full text-center py-6 px-4 space-y-6"
    >
      <div
        class="w-14 h-14 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 flex items-center justify-center mx-auto shadow-sm"
      >
        <iconify-icon icon="lucide:check-circle-2" class="text-3xl"
        ></iconify-icon>
      </div>
      <div class="space-y-2">
        <h3 class="text-2xl font-medium text-gray-900 tracking-tight">
          Query Submitted!
        </h3>
        <p
          class="text-gray-600 font-light text-base max-w-lg mx-auto leading-relaxed"
        >
          Thank you for submitting your query. Someone from our end will contact
          you shortly.
        </p>
      </div>
      <div
        class="pt-4 border-t border-gray-100 flex flex-wrap items-center justify-center gap-3"
      >
        <a
          href="/about"
          class="px-4 py-2 rounded-full bg-primary-500/10 text-primary-500 hover:bg-primary-500 hover:text-white transition-all text-xs font-medium"
        >
          Know More About Us
        </a>
        <a
          href="/courses/upsc"
          class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-primary-500 hover:text-white transition-all text-xs font-medium"
        >
          UPSC Courses
        </a>
        <a
          href="/courses/apsc"
          class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-primary-500 hover:text-white transition-all text-xs font-medium"
        >
          APSC Courses
        </a>
        <a
          href="/courses"
          class="px-4 py-2 rounded-full bg-gray-100 text-gray-700 hover:bg-primary-500 hover:text-white transition-all text-xs font-medium"
        >
          All Courses
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "@/lib/gsap.ts";
  import { submitLead } from "@/lib/submitLead";
  import variables from "@/config/variables";

  let turnstileToken: string | null = null;
  const siteKey = variables.CLOUDFLARE_SITE_KEY;

  const renderTurnstile = () => {
    const container = document.getElementById("hero-turnstile");
    if (!container || !window.turnstile) return;

    window.turnstile.render(container, {
      sitekey: siteKey,
      callback: (token: string) => {
        turnstileToken = token;
      },
      "expired-callback": () => {
        turnstileToken = null;
      },
      "error-callback": () => {
        turnstileToken = null;
      },
    });
  };

  const mountTurnstile = () => {
    if (window.turnstile) {
      renderTurnstile();
      return;
    }
    const existing = document.querySelector('script[src*="turnstile"]');
    if (existing) {
      existing.addEventListener("load", renderTurnstile);
      return;
    }
    const script = document.createElement("script");
    script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js";
    script.async = true;
    script.defer = true;
    script.onload = renderTurnstile;
    document.head.appendChild(script);
  };

  const formCard = document.querySelector("[data-lead-form-card]");
  const form = document.querySelector(
    "[data-lead-form]",
  ) as HTMLFormElement | null;
  const formHeader = document.querySelector(".lead-form-header");
  const heroSuccess = document.querySelector("#hero-lead-success");
  const phoneInput = document.querySelector(
    "#phone",
  ) as HTMLInputElement | null;
  const expandedFields = document.querySelector("[data-expanded-fields]");
  const continueButton = document.querySelector("[data-continue-button]");
  const requiredFields = document.querySelectorAll("[data-expanded-required]");

  let isTurnstileMounted = false;

  const expandForm = () => {
    if (!expandedFields || !continueButton) return;

    expandedFields.classList.remove("lead-form__expanded-fields--collapsed");
    expandedFields.classList.add("lead-form__expanded-fields--expanded");
    continueButton.setAttribute("hidden", "");

    requiredFields.forEach((field) => {
      field.setAttribute("required", "");
    });

    if (!isTurnstileMounted) {
      isTurnstileMounted = true;
      mountTurnstile();
    }
  };

  phoneInput?.addEventListener("input", () => {
    if (phoneInput.value.trim().length > 0) {
      expandForm();
    }
  });

  continueButton?.addEventListener("click", expandForm);

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const submitBtn = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement | null;
    const submitText = submitBtn?.querySelector("span");

    if (submitBtn && submitText) {
      submitBtn.disabled = true;
      submitText.textContent = "Submitting...";
    }

    const formData = new FormData(form);
    const rawPhone = (formData.get("phone") as string) || "";
    const rawName = (formData.get("name") as string) || "";
    const course = (formData.get("course") as string) || "";

    const name = rawName.trim() || "Aspirant";
    let phone = rawPhone.trim();
    if (phone && !phone.startsWith("+")) {
      const digits = phone.replace(/\D/g, "");
      phone = `+91${digits}`;
    }

    const digitsOnly = phone.replace(/\D/g, "") || "6001657575";
    const email = `${digitsOnly}@phone.takshashilascs.com`;

    try {
      await submitLead({
        name,
        phone,
        email,
        course,
        address: null,
        source: "homepage-hero-form",
        cfTurnstileResponse: turnstileToken || "turnstile-passed",
      });
    } catch (err) {
      console.error("Hero lead submission error:", err);
    } finally {
      if (form) form.classList.add("hidden");
      if (formHeader) formHeader.classList.add("hidden");
      if (heroSuccess) heroSuccess.classList.remove("hidden");
    }
  });

  if (formCard) {
    gsap.from(formCard, {
      y: 32,
      opacity: 0,
      duration: 0.8,
      ease: "power3.out",
    });
  }
</script>

<style>
  @reference "@/styles/globals.css";

  .lead-form-section {
    @apply relative w-full px-4 sm:px-6 z-20 flex justify-center pb-24;
  }

  .lead-form-card {
    @apply w-full xl:flex space-x-4 items-start xl:max-w-6xl -mt-32 bg-white border border-gray-100 p-6 sm:p-10 shadow-xl rounded-2xl;
    border-top: 4px solid var(--color-gold-500) !important;
  }

  .lead-form-header {
    @apply mb-8 xl:mb-0 xl:w-1/2 pr-0 xl:pr-6;
  }

  .lead-form-title {
    @apply text-xl lg:text-2xl font-medium text-primary-500 mb-2 leading-tight;
  }

  .lead-form-subtitle {
    @apply text-gray-500 text-sm lg:text-base font-light leading-relaxed;
  }

  .lead-form-element {
    @apply w-full xl:w-1/2 flex flex-col gap-5;
  }

  .lead-form__field {
    @apply relative;
  }

  .lead-form__icon-wrapper {
    @apply absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-gray-400;
  }

  .lead-form__icon {
    @apply h-5 w-5;
  }

  .lead-form__input {
    @apply w-full pl-12 pr-4 py-3.5 bg-gray-50 border border-gray-200 text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:bg-white transition-all duration-300 placeholder:text-gray-400 text-sm rounded-xl;
  }

  .lead-form__input--lg {
    @apply py-4 text-base;
  }

  .lead-form__select {
    @apply w-full pl-12 pr-10 py-3.5 bg-gray-50 border border-gray-200 text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:bg-white transition-all duration-300 appearance-none cursor-pointer text-sm rounded-xl;
  }

  .lead-form__chevron-container {
    @apply absolute inset-y-0 right-0 pr-4 flex items-center pointer-events-none text-gray-500;
  }

  .lead-form__chevron-icon {
    @apply h-4 w-4 fill-current;
  }

  .lead-form__expanded-fields {
    @apply flex flex-col gap-5 overflow-hidden transition-all duration-500 ease-in-out;
  }

  .lead-form__expanded-fields--collapsed {
    @apply max-h-0 opacity-0;
  }

  .lead-form__expanded-fields--expanded {
    @apply max-h-125 opacity-100 mt-2;
  }

  .lead-form__submit-button {
    @apply w-full mt-2 inline-flex items-center justify-center bg-primary-500 hover:bg-primary-600 text-white font-medium py-4 transition-all duration-300 cursor-pointer gap-2 rounded-xl;
  }

  .lead-form__submit-button:hover .lead-form__arrow-icon {
    transform: translateX(4px);
  }

  .lead-form__arrow-icon {
    @apply h-5 w-5 transition-transform;
  }

  .lead-form__continue-button {
    @apply w-full inline-flex items-center justify-center bg-gray-900 hover:bg-gray-800 text-white font-medium py-4 transition-all duration-300 cursor-pointer rounded-xl;
  }
</style>
