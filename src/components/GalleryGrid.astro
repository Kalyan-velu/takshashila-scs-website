---
export const prerender = false;

import { getGalleryCategories, getGalleryImages } from "@/lib/currentAffairs.ts";

const UNCATEGORIZED_ID = "uncategorized";

const [categories, images] = await Promise.all([
  getGalleryCategories(),
  getGalleryImages(),
]);

const hasUncategorized = images.some((img) => img.categories.length === 0);

const tabs = [
  { id: "all", name: "All" },
  ...categories.map((c) => ({ id: c.id, name: c.name })),
  ...(hasUncategorized ? [{ id: UNCATEGORIZED_ID, name: "Uncategorized" }] : []),
];

// This island is the only non-static part of the (build-time compiled) /gallery
// page — cache it at the edge so it still updates through the day without a full rebuild.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=1800, stale-while-revalidate=86400",
);
---

<div class="gallery-grid px-4 py-16 md:px-6 max-w-7xl mx-auto w-full">
  {
    images.length === 0 ? (
      <div class="text-center py-20 bg-gray-100/20 border border-dashed border-gray-200 rounded-3xl max-w-md mx-auto px-6">
        <h3 class="text-xl font-medium mb-2">No Photos Available</h3>
        <p class="text-gray-600 font-light text-sm">
          We are currently updating our gallery. Please check back soon.
        </p>
      </div>
    ) : (
      <>
        <div
          class="gallery-tabs flex flex-nowrap md:flex-wrap gap-2 mb-10 overflow-x-auto md:overflow-visible scroll-smooth hide-scrollbar"
          role="tablist"
          aria-label="Filter gallery by category"
        >
          {tabs.map((tab, i) => (
            <button
              type="button"
              class="gallery-tab-btn shrink-0 rounded-full border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700 transition-colors hover:border-primary-500 hover:text-primary-500 aria-selected:bg-primary-500 aria-selected:text-white aria-selected:border-primary-500"
              data-filter={tab.id}
              role="tab"
              aria-selected={i === 0 ? "true" : "false"}
            >
              {tab.name}
            </button>
          ))}
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {images.map((image) => {
            const categoryIds = image.categories.length
              ? image.categories.map((c) => c.id)
              : [UNCATEGORIZED_ID];
            const categoryNames = image.categories.length
              ? image.categories.map((c) => c.name).join(", ")
              : "Uncategorized";
            const caption = image.title || categoryNames;
            const alt =
              image.altTitle ||
              image.title ||
              "Takshasheela School of Civil Services gallery photo";
            return (
              <button
                type="button"
                class="gallery-item group relative overflow-hidden rounded-2xl bg-gray-100 aspect-square"
                data-categories={categoryIds.join(",")}
                data-full={image.imageUrl}
                data-title={image.title ?? ""}
                data-description={image.description ?? ""}
                data-category-names={categoryNames}
                data-alt={alt}
              >
                <img
                  src={image.imageUrl}
                  alt={alt}
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4">
                  <span class="text-white font-medium tracking-tight text-sm text-left line-clamp-2">
                    {caption}
                  </span>
                </div>
              </button>
            );
          })}
        </div>

        <p class="gallery-empty hidden text-center text-gray-600 font-light text-sm py-16">
          No photos in this category yet.
        </p>

        <div
          class="gallery-lightbox fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4"
          role="dialog"
          aria-modal="true"
          aria-label="Gallery photo viewer"
        >
          <button
            type="button"
            class="gallery-lightbox-close absolute top-4 right-4 text-white text-3xl leading-none w-10 h-10 flex items-center justify-center rounded-full hover:bg-white/10 z-10"
            aria-label="Close"
          >
            &times;
          </button>

          <span class="gallery-lightbox-counter absolute top-4 left-4 text-white/70 text-sm font-medium tracking-wide" />

          <button
            type="button"
            class="gallery-lightbox-prev absolute left-1 md:left-4 top-1/2 -translate-y-1/2 text-white w-11 h-11 md:w-12 md:h-12 flex items-center justify-center rounded-full bg-white/5 hover:bg-white/15 transition-colors z-10"
            aria-label="Previous photo"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M15 18l-6-6 6-6" /></svg>
          </button>

          <button
            type="button"
            class="gallery-lightbox-next absolute right-1 md:right-4 top-1/2 -translate-y-1/2 text-white w-11 h-11 md:w-12 md:h-12 flex items-center justify-center rounded-full bg-white/5 hover:bg-white/15 transition-colors z-10"
            aria-label="Next photo"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M9 18l6-6-6-6" /></svg>
          </button>

          <figure class="max-w-5xl w-full max-h-full flex flex-col items-center gap-4">
            <div class="flex items-center justify-center w-full" style="max-height: 78vh;">
              <img class="gallery-lightbox-img max-h-[78vh] max-w-full object-contain rounded-lg" src="" alt="" />
            </div>
            <figcaption class="gallery-lightbox-caption text-center max-w-2xl px-4">
              <p class="gallery-lightbox-title text-white font-medium text-base leading-snug" />
              <p class="gallery-lightbox-description text-white/70 text-sm mt-1 leading-relaxed" />
            </figcaption>
          </figure>
        </div>
      </>
    )
  }
</div>

<script>
  const root = document.querySelector<HTMLElement>(".gallery-grid");
  if (root) {
    const tabButtons = root.querySelectorAll<HTMLButtonElement>(".gallery-tab-btn");
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>(".gallery-item"));
    const emptyState = root.querySelector<HTMLElement>(".gallery-empty");

    function applyFilter(filter: string) {
      let visibleCount = 0;
      items.forEach((item) => {
        const categories = (item.dataset.categories ?? "").split(",");
        const visible = filter === "all" || categories.includes(filter);
        item.classList.toggle("hidden", !visible);
        if (visible) visibleCount++;
      });
      emptyState?.classList.toggle("hidden", visibleCount !== 0);
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        tabButtons.forEach((b) => b.setAttribute("aria-selected", "false"));
        btn.setAttribute("aria-selected", "true");
        applyFilter(btn.dataset.filter ?? "all");
      });
    });

    const lightbox = root.querySelector<HTMLElement>(".gallery-lightbox");
    const lightboxImg = root.querySelector<HTMLImageElement>(".gallery-lightbox-img");
    const lightboxTitle = root.querySelector<HTMLElement>(".gallery-lightbox-title");
    const lightboxDescription = root.querySelector<HTMLElement>(".gallery-lightbox-description");
    const lightboxCounter = root.querySelector<HTMLElement>(".gallery-lightbox-counter");
    const lightboxClose = root.querySelector<HTMLButtonElement>(".gallery-lightbox-close");
    const lightboxPrev = root.querySelector<HTMLButtonElement>(".gallery-lightbox-prev");
    const lightboxNext = root.querySelector<HTMLButtonElement>(".gallery-lightbox-next");

    let currentIndex = -1;

    function visibleItems() {
      return items.filter((item) => !item.classList.contains("hidden"));
    }

    function renderItem(item: HTMLButtonElement) {
      if (!lightboxImg) return;
      lightboxImg.src = item.dataset.full ?? "";
      lightboxImg.alt = item.dataset.alt || "Gallery photo";

      const title = item.dataset.title?.trim();
      const description = item.dataset.description?.trim();
      const categoryNames = item.dataset.categoryNames?.trim();

      if (lightboxTitle) {
        lightboxTitle.textContent = title || (!description ? categoryNames || "" : "");
        lightboxTitle.classList.toggle("hidden", !lightboxTitle.textContent);
      }
      if (lightboxDescription) {
        lightboxDescription.textContent = description || "";
        lightboxDescription.classList.toggle("hidden", !description);
      }
    }

    function updateCounter() {
      if (!lightboxCounter) return;
      const list = visibleItems();
      const showNav = list.length > 1;
      lightboxPrev?.classList.toggle("hidden", !showNav);
      lightboxNext?.classList.toggle("hidden", !showNav);
      lightboxCounter.textContent = showNav ? `${currentIndex + 1} / ${list.length}` : "";
    }

    function openLightbox(item: HTMLButtonElement) {
      if (!lightbox) return;
      const list = visibleItems();
      currentIndex = list.indexOf(item);
      renderItem(item);
      updateCounter();
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
    }

    function showByIndex(index: number) {
      const list = visibleItems();
      if (list.length === 0) return;
      currentIndex = (index + list.length) % list.length;
      renderItem(list[currentIndex]);
      updateCounter();
    }

    function showNext() {
      if (currentIndex < 0) return;
      showByIndex(currentIndex + 1);
    }

    function showPrev() {
      if (currentIndex < 0) return;
      showByIndex(currentIndex - 1);
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      lightboxImg.src = "";
      currentIndex = -1;
      document.body.style.overflow = "";
    }

    items.forEach((item) => item.addEventListener("click", () => openLightbox(item)));
    lightboxClose?.addEventListener("click", closeLightbox);
    lightboxPrev?.addEventListener("click", showPrev);
    lightboxNext?.addEventListener("click", showNext);
    lightbox?.addEventListener("click", (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (e) => {
      if (lightbox?.classList.contains("hidden")) return;
      if (e.key === "Escape") closeLightbox();
      if (e.key === "ArrowRight") showNext();
      if (e.key === "ArrowLeft") showPrev();
    });
  }
</script>

<style>
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }

  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
