---
export const prerender = false;

import LatestArticles from "@/components/LatestArticles.vue";
import { getLatestPosts } from "@/lib/blogger";

const posts = await getLatestPosts(1, 3);

// This island is the only non-static part of the (build-time compiled) homepage —
// cache it at the edge so it still updates without a full rebuild.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=10800, stale-while-revalidate=86400",
);
---

<LatestArticles posts={posts} />
