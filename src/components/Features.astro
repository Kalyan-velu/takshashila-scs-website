---
// import { Users, BookOpenCheck, GraduationCap } from "lucide-react";
import contentData from "@/data/content.json";

const iconMap = {
  // Users: Users,
  // BookOpenCheck: BookOpenCheck,
  // GraduationCap: GraduationCap,
};

const features = contentData.features.map(f => ({
  ...f,
  // icon: iconMap[f.icon] || Users
}));
---

<section class="py-20 bg-gray-100/30">
  <div class="mx-auto px-4 md:px-6">
    <div class="grid md:grid-cols-3 gap-8">
      {
        features.map((feature) => (
          <div class="group relative overflow-hidden border border-gray-200 bg-white p-8 transition-all hover:border-primary-500/50">
            <div class="absolute inset-0 bg-linear-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />

            <div class="relative z-10">
              <div class="mb-5 inline-flex h-12 w-12 items-center justify-center bg-primary-500/10 text-primary-500">
                <!--<feature.icon className="h-6 w-6" />-->
              </div>
              <h3 class="mb-3 text-xl md:text-2xl font-medium tracking-tight text-gray-900">
                {feature.title}
              </h3>
              <p class="text-gray-600 font-light leading-relaxed text-sm md:text-base">
                {feature.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
