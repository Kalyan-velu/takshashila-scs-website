---
import { Users, BookOpenCheck, GraduationCap } from 'lucide-react';

const features = [
  {
    icon: Users,
    title: "Expert Faculty",
    description: "Top-tier faculties and mentors from Delhi and across India. Rich resources, expert guidance, and flexible recorded classes — all under one roof. That’s what makes Takshashila the best online UPSC coaching in Guwahati."
  },
  {
    icon: BookOpenCheck,
    title: "Study Materials",
    description: "Our course includes features to ensure success in your exams at Takshashila, which is renowned as the best UPSC coaching in Guwahati. If you are looking for the best UPSC and APSC coaching in Guwahati, Takshashila is the place for you."
  },
  {
    icon: GraduationCap,
    title: "Scholarships",
    description: "Merit basis Scholarship is available up to 100% at Takshashila, the best APSC coaching centre in Guwahati, for deserving students."
  }
];
---

<section class="py-20 bg-muted/30">
  <div class="mx-auto px-4 md:px-6">
    <div class="grid md:grid-cols-3 gap-8">
      {features.map(feature => (
        <div class="group relative overflow-hidden rounded-2xl border border-border bg-card p-8 transition-all hover:border-primary/50">
          <div class="absolute inset-0 bg-linear-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
          
          <div class="relative z-10">
            <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary">
              <feature.icon className="h-6 w-6" />
            </div>
            <h3 class="mb-3 text-xl md:text-2xl font-medium tracking-tight text-card-foreground">{feature.title}</h3>
            <p class="text-muted-foreground font-light leading-relaxed text-sm md:text-base">
              {feature.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
