---
import contentData from "@/data/content.json";

const iconMap: Record<string, string> = {
  Users: "lucide:users",
  BookOpenCheck: "lucide:book-open-check",
  GraduationCap: "lucide:graduation-cap",
};

const features = contentData.features.map(f => ({
  ...f,
  iconName: iconMap[f.icon] || "lucide:graduation-cap",
}));
---

<section class="py-20 bg-gray-50/50">
  <div class="mx-auto px-4 md:px-6 max-w-7xl">
    <div class="grid md:grid-cols-3 gap-8">
      {
        features.map((feature) => (
          <div class="group relative overflow-hidden rounded-2xl border border-gray-200 bg-white p-8 transition-all duration-300 hover:border-primary-500/40 hover:shadow-lg">
            <div class="absolute inset-0 bg-linear-to-br from-primary-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity" />

            <div class="relative z-10">
              <div class="mb-5 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-500/10 text-primary-500 group-hover:scale-110 transition-transform">
                <iconify-icon icon={feature.iconName} class="text-2xl"></iconify-icon>
              </div>
              <h3 class="mb-3 text-xl md:text-2xl font-medium tracking-tight text-gray-900 group-hover:text-primary-500 transition-colors">
                {feature.title}
              </h3>
              <p class="text-gray-600 font-light leading-relaxed text-sm md:text-base">
                {feature.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
