---
import { AcademicCap, Accessibility, Video, Building2, Library, BookOpenText } from 'lucide-react';

// Using alternative Lucide icons that exist
import { GraduationCap, AppWindow, PlaySquare, Building, BookMarked, Newspaper } from 'lucide-react';

const reasons = [
  {
    icon: GraduationCap,
    title: "Best Faculty",
    description: "Experienced faculty from Delhi and other states, with 5-20 years' experience, mentor aspirants at Takshashila School of Civil Services, the best coaching institute for UPSC in Guwahati."
  },
  {
    icon: AppWindow,
    title: "Accessibility",
    description: "We prioritize accessibility through online courses and accommodations for all, ensuring equal opportunities for success."
  },
  {
    icon: PlaySquare,
    title: "Recorded Classes",
    description: "Access recorded classes for flexible learning, enhancing understanding at your own pace at Takshashila, the best online UPSC coaching in Guwahati."
  },
  {
    icon: Building,
    title: "Infrastructure",
    description: "Cutting-edge infrastructure with smart classrooms, fostering a dynamic and interactive learning atmosphere for students at Takshashila, the best IAS coaching institute in Guwahati."
  },
  {
    icon: BookMarked,
    title: "Advanced Library",
    description: "Our advanced library offers a vast collection of resources, supporting comprehensive learning and research for civil service aspirants."
  },
  {
    icon: Newspaper,
    title: "Monthly Magazine",
    description: "Stay informed with our monthly magazine, packed with crucial updates and insightful articles for civil service aspirants."
  }
];

const { id } = Astro.props;
---

<section id={id} class="py-24 bg-background border-t border-border/50">
  <div class="container mx-auto px-4 md:px-6">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-foreground mb-6">
        Why Takshashila is the Best UPSC and APSC Coaching Center in Guwahati
      </h2>
      <p class="text-lg text-muted-foreground">
        Elevating aspirants towards civil service excellence
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {reasons.map((item, i) => (
        <div class="flex flex-col items-start p-6 rounded-2xl bg-card border border-border hover:shadow-sm transition-all hover:-translate-y-1 group">
          <div class="p-3 bg-primary/10 rounded-xl mb-6 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-colors duration-300">
            <item.icon className="w-6 h-6" />
          </div>
          <h3 class="text-xl font-bold mb-3">{item.title}</h3>
          <p class="text-muted-foreground leading-relaxed">
            {item.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
