---
import contentData from "@/data/content.json";

const iconMap: Record<string, string> = {
  GraduationCap: "lucide:graduation-cap",
  AppWindow: "lucide:app-window",
  PlaySquare: "lucide:square-play",
  Building: "lucide:building-2",
  BookMarked: "lucide:book-marked",
  Newspaper: "lucide:newspaper",
};

const reasons = contentData.whyChooseUs.reasons.map((r) => ({
  ...r,
  iconName: iconMap[r.icon] || r.icon || "lucide:graduation-cap",
}));

const { whyChooseUs } = contentData;
const { id } = Astro.props;
---

<section
  id={id}
  class="pb-12 lg:pb-32 lg:max-w-7xl mx-auto bg-white relative z-10"
>
  <div class="px-4 md:px-6">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-start">
      <div class="lg:col-span-5 sticky lg:top-40 flex flex-col gap-6 text-left">
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-light tracking-tight text-gray-900 leading-tight"
        >
          Why Choose the <span class="text-primary-500 italic"
            >Best UPSC and APSC Coaching</span
          > in Guwahati
        </h2>
        <p class="text-base text-gray-600 font-light leading-relaxed">
          {whyChooseUs.description}
        </p>
      </div>

      <div class="lg:col-span-7 flex flex-col gap-6 lg:gap-8 relative">
        {
          reasons.map((item, i) => (
            <div
              class="sticky w-full flex flex-col rounded-xl sm:flex-row items-start sm:items-center gap-6 md:gap-8 p-8 md:p-10 bg-white border border-gray-200 overflow-hidden transition-all duration-300"
              style={`bottom: calc(15vh - ${i * 24}px); z-index: ${1 - i};`}
            >
              <div
                class={`shrink-0 w-16 h-16 md:w-20 md:h-20 bg-white border border-gray-200 flex items-center justify-center relative z-10 text-primary-500`}
              >
                <iconify-icon
                  icon={item.iconName}
                  class="text-3xl md:text-4xl"
                />
              </div>

              <div class="flex flex-col gap-2 md:gap-3 relative z-10 flex-1">
                <h3 class="text-xl md:text-2xl font-medium text-gray-900 tracking-tight">
                  {item.title}
                </h3>
                <p class="text-base text-gray-600 font-light leading-relaxed pr-6 md:pr-10">
                  {item.description}
                </p>
              </div>

              <div class="absolute top-6 right-8 text-5xl md:text-7xl font-black italic tracking-tighter text-gray-600/10 pointer-events-none select-none" aria-hidden="true">
                0{i + 1}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
