---
// ResultsSection.astro — server-rendered social proof.
// All arrays below are intentionally empty. Fill them in with real,
// verifiable figures/names/videos before shipping — do not invent numbers.
interface Stat {
  value: string; // e.g. "120+"
  label: string; // e.g. "Selections in APSC, UPSC & ADRE"
}

interface Topper {
  name: string;
  rank: string; // e.g. "ACS Rank 12"
  exam?: string; // e.g. "APSC CCE 2023"
  image?: string; // e.g. "/Takshasheela/toppers/priya-das.webp"
}

interface TestimonialVideo {
  id: string; // YouTube video ID
  title: string;
}

import abhigyanGogoi from "../assets/selected-candidates/Abhigyan Gogoi.png";
import angshurajDas from "../assets/selected-candidates/Angshuraj Das.png";
import guninPegu from "../assets/selected-candidates/Gunin Pegu.png";
import himasriSarma from "../assets/selected-candidates/Himasri Sarma.png";
import hirakRajbongshi from "../assets/selected-candidates/Hirak Rajbongshi.png";
import kritarthaKashyap from "../assets/selected-candidates/Kitartha.png";
import manishBaruah from "../assets/selected-candidates/Manish Baruah.png";
import rahulDas from "../assets/selected-candidates/Rahul Das.png";

const stats: Stat[] = [
  { value: "20+", label: "Selections in APSC, UPSC & ADRE" },
  { value: "2,000+", label: "Students Trained" },
  { value: "10+", label: "Expert Faculty from Delhi & Assam" },
  { value: "500+", label: "Mock Tests Conducted" },
];

// Toppers without a matching photo in src/assets/selected-candidates are
// omitted here rather than shown without an image.
const toppers: Topper[] = [
  {
    name: "Kritartha Kashyap",
    rank: "ACS Rank 25",
    image: kritarthaKashyap.src,
  },
  { name: "Gunin Pegu", rank: "APS Rank 14", image: guninPegu.src },
  { name: "Angshuraj Das", rank: "IT Rank 12", image: angshurajDas.src },
  { name: "Manish Baruah", rank: "IT Rank 31", image: manishBaruah.src },
  { name: "Rahul Das", rank: "IE Rank 06", image: rahulDas.src },
  { name: "Abhigyan Gogoi", rank: "AEO Rank 11", image: abhigyanGogoi.src },
  { name: "Himasri Sarma", rank: "AAO Rank 02", image: himasriSarma.src },
  {
    name: "Hirak Rajbongshi",
    rank: "AAO Rank 03",
    image: hirakRajbongshi.src,
  },
];

const testimonialVideos: TestimonialVideo[] = [
  {
    id: "XXXXXXXXXXX",
    title: "Topper Name — ACS Rank 12 | Takshasheela Success Story",
  },
];

const hasAnyContent =
  stats.length > 0 || toppers.length > 0 || testimonialVideos.length > 0;
---

{
  hasAnyContent && (
    <section id="results" class="pb-12 lg:pb-24 bg-background">
      <div class="px-4 md:px-6 lg:max-w-7xl mx-auto">
        <h2 class="text-3xl md:text-5xl font-light tracking-tight text-foreground mb-4">
          Results That Make Us the Best APSC &amp; UPSC Coaching in Guwahati
        </h2>
        <p class="text-muted-foreground font-light text-lg max-w-2xl mb-12">
          Our students' selections in APSC CCE, UPSC CSE and ADRE speak for
          themselves.
        </p>

        {stats.length > 0 && (
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
            {stats.map((s) => (
              <div class="rounded-3xl border border-border bg-card p-6 text-center">
                <div class="text-3xl md:text-4xl font-medium text-primary mb-1">
                  {s.value}
                </div>
                <div class="text-sm font-light text-muted-foreground">
                  {s.label}
                </div>
              </div>
            ))}
          </div>
        )}

        {toppers.length > 0 && (
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 mb-16">
            {toppers.map((t) => (
              <div class="rounded-2xl overflow-hidden border border-border bg-card">
                {t.image && (
                  <img
                    src={t.image}
                    alt={`${t.name} — ${t.rank}${t.exam ? `, ${t.exam}` : ""} — Takshasheela School of Civil Services`}
                    width="300"
                    height="300"
                    loading="lazy"
                    decoding="async"
                    class="w-full aspect-square object-cover"
                  />
                )}
                <div class="p-3">
                  <div class="text-sm font-medium text-foreground">
                    {t.name}
                  </div>
                  <div class="text-xs text-muted-foreground">
                    {t.rank}
                    {t.exam ? ` · ${t.exam}` : ""}
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        {testimonialVideos.length > 0 && (
          <div class="grid md:grid-cols-3 gap-6">
            {testimonialVideos.map((v) => (
              <button
                type="button"
                class="yt-facade group relative aspect-video rounded-2xl overflow-hidden border border-border"
                data-yt-id={v.id}
                aria-label={`Play video: ${v.title}`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                  alt={v.title}
                  width="480"
                  height="360"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover"
                />
                <span class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/40 transition-colors">
                  <span class="w-14 h-14 rounded-full bg-primary flex items-center justify-center">
                    <svg
                      class="w-5 h-5 fill-white ml-0.5"
                      viewBox="0 0 384 512"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path d="M73 39c-14.8-9.1-33.4-9.4-48.5-.9S0 62.6 0 80V432c0 17.4 9.4 33.4 24.5 41.9s33.7 8.1 48.5-.9L361 297c14.3-8.7 23-24.2 23-41s-8.7-32.2-23-41L73 39z" />
                    </svg>
                  </span>
                </span>
              </button>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  function initYtFacades() {
    document
      .querySelectorAll<HTMLButtonElement>(".yt-facade")
      .forEach((btn) => {
        if (btn.dataset.bound === "1") return;
        btn.dataset.bound = "1";
        btn.addEventListener("click", () => {
          const id = btn.dataset.ytId;
          if (!id) return;
          const iframe = document.createElement("iframe");
          iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
          iframe.allow =
            "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
          iframe.allowFullscreen = true;
          iframe.className = "absolute inset-0 w-full h-full";
          iframe.title = btn.getAttribute("aria-label") ?? "Testimonial video";
          btn.replaceChildren(iframe);
        });
      });
  }
  initYtFacades();
  document.addEventListener("astro:page-load", initYtFacades);
</script>
