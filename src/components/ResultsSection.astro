---
import { Image as ImageComponent } from "astro:assets";
import YouTubeVideoGrid from "./YouTubeVideoGrid.astro";
import abhigyanGogoi from "../assets/selected-candidates/Abhigyan Gogoi.png";
import angshurajDas from "../assets/selected-candidates/Angshuraj Das.png";
import bituponDas from "../assets/selected-candidates/Bitupon Das.png";
import bulbulGuhain from "../assets/selected-candidates/Bulbul Guhain.png";
import guninPegu from "../assets/selected-candidates/Gunin Pegu.png";
import himasriSarma from "../assets/selected-candidates/Himasri Sarma.png";
import hirakRajbongshi from "../assets/selected-candidates/Hirak Rajbongshi.png";
import hiyaDeuri from "../assets/selected-candidates/Hiya Deuri.png";
import kritarthaKashyap from "../assets/selected-candidates/Kitartha.png";
import manishBaruah from "../assets/selected-candidates/Manish Baruah.png";
import nabanitaKalita from "../assets/selected-candidates/Nabanita Kalita.png";
import rahulDas from "../assets/selected-candidates/Rahul Das.png";

interface Stat {
  value: string;
  label: string;
  icon: string;
}

interface Topper {
  name: string;
  rank: string;
  exam?: string;
  image?: ImageMetadata;
}

interface TestimonialVideo {
  id: string;
  title: string;
}

const stats: Stat[] = [
  { value: "24+", label: "Selections in APSC, UPSC & ADRE", icon: "lucide:trophy" },
  { value: "2,000+", label: "Students Trained & Mentored", icon: "lucide:users" },
  { value: "10+", label: "Expert Faculty from Delhi & Assam", icon: "lucide:graduation-cap" },
  { value: "500+", label: "Mock Tests & Prelims Sessions", icon: "lucide:file-check-2" },
];

const toppers: Topper[] = [
  {
    name: "Kritartha Kashyap",
    rank: "ACS Rank 25",
    exam: "APSC CCE",
    image: kritarthaKashyap,
  },
  {
    name: "Gunin Pegu",
    rank: "APS Rank 14",
    exam: "APSC CCE",
    image: guninPegu,
  },
  {
    name: "Angshuraj Das",
    rank: "IT Rank 12",
    exam: "APSC CCE",
    image: angshurajDas,
  },
  {
    name: "Manish Baruah",
    rank: "IT Rank 31",
    exam: "APSC CCE",
    image: manishBaruah,
  },
  {
    name: "Rahul Das",
    rank: "IE Rank 06",
    exam: "APSC CCE",
    image: rahulDas,
  },
  {
    name: "Abhigyan Gogoi",
    rank: "AEO Rank 11",
    exam: "APSC CCE",
    image: abhigyanGogoi,
  },
  {
    name: "Himasri Sarma",
    rank: "AAO Rank 02",
    exam: "APSC CCE",
    image: himasriSarma,
  },
  {
    name: "Hirak Rajbongshi",
    rank: "AAO Rank 03",
    exam: "APSC CCE",
    image: hirakRajbongshi,
  },
  {
    name: "Nabanita Kalita",
    rank: "APSC Qualified",
    exam: "APSC CCE",
    image: nabanitaKalita,
  },
  {
    name: "Bitupon Das",
    rank: "APSC Qualified",
    exam: "APSC CCE",
    image: bituponDas,
  },
  {
    name: "Hiya Deuri",
    rank: "APSC Qualified",
    exam: "APSC CCE",
    image: hiyaDeuri,
  },
  {
    name: "Bulbul Guhain",
    rank: "APSC Qualified",
    exam: "APSC CCE",
    image: bulbulGuhain,
  },
];

const testimonialVideos: TestimonialVideo[] = [
  {
    id: "EHCGaJwiT3c",
    title:
      "APSC Mock Interview — Rank 32 Partha Jyoti Boruah | Inspector of Taxes | APSC CCE 2024",
  },
  {
    id: "B8qfuWnd2lY",
    title:
      "APSC Mock Interview — Rank 14 Gunin Pegu | Assam Police Service | APSC CCE 2024",
  },
  {
    id: "FIJ49tjut2g",
    title:
      "APSC Mock Interview — Rank 12 Angshuraj Das | Inspector of Taxes | APSC CCE 2024",
  },
];

const hasAnyContent =
  stats.length > 0 || toppers.length > 0 || testimonialVideos.length > 0;
---

{
  hasAnyContent && (
    <section id="results" class="py-16 md:py-24 bg-gradient-to-b from-white via-gray-50/60 to-white relative z-10">
      <div class="px-4 md:px-6 max-w-7xl mx-auto">
        <!-- Section Header -->
        <div class="flex flex-col items-center text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary-500/10 text-primary-500 text-xs font-semibold uppercase tracking-wider mb-4">
            <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse" />
            Proven Track Record
          </div>
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-light tracking-tight text-gray-900 leading-tight">
            Results That Make Us <span class="text-primary-500 italic font-medium">The Top Choice</span> in Guwahati
          </h2>
          <p class="mt-4 text-base md:text-lg text-gray-600 font-light leading-relaxed">
            Our students' consistent top ranks in APSC CCE, UPSC CSE, and ADRE are a testament to our quality guidance and dedicated mentorship.
          </p>
        </div>

       
        {stats.length > 0 && (
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 mb-16">
            {stats.map((s) => (
              <div class="group relative overflow-hidden rounded-2xl bg-white text-center transition-all duration-300">
                <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-primary-500/10 text-primary-500 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                  <iconify-icon icon={s.icon} class="text-2xl" />
                </div>
                <div class="text-3xl md:text-4xl tracking-tight text-gray-900 transition-colors">
                  {s.value}
                </div>
                <div class="text-xs md:text-sm font-light text-gray-600 mt-1">
                  {s.label}
                </div>
              </div>
            ))}
          </div>
        )}

        {toppers.length > 0 && (
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4 md:gap-6 mb-16">
            {toppers.map((t) => (
              <div class="group relative flex flex-col rounded-2xl border border-gray-200 bg-white overflow-hidden shadow-xs hover:shadow-xl hover:border-primary-500/40 transition-all duration-300 hover:-translate-y-1">
                {/* Image Container with Rank Badge */}
                <div class="relative aspect-[4/5] w-full overflow-hidden bg-gray-100">
                  {t.image ? (
                    <ImageComponent
                      src={t.image}
                      alt={`${t.name} — ${t.rank} — Takshashila School of Civil Services`}
                      width={400}
                      height={500}
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-gray-100 text-gray-400">
                      <iconify-icon icon="lucide:user" class="text-4xl" />
                    </div>
                  )}

                  {/* Rank Badge */}
                  <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-3 py-1 rounded-full text-xs font-semibold text-primary-500 shadow-md border border-primary-500/20 flex items-center gap-1.5">
                    <iconify-icon icon="lucide:award" class="text-sm text-primary-500" />
                    <span>{t.rank}</span>
                  </div>
                </div>

                {/* Info Container */}
                <div class="p-4 flex flex-col bg-white border-t border-gray-100">
                  <h4 class="font-semibold text-gray-900 text-base md:text-lg tracking-tight group-hover:text-primary-500 transition-colors">
                    {t.name}
                  </h4>
                  <div class="text-xs md:text-sm text-gray-500 font-light mt-0.5 flex items-center gap-1">
                    <iconify-icon icon="lucide:check-circle-2" class="text-emerald-600 text-xs" />
                    <span>{t.exam || "APSC CCE"}</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        )}

        <!-- Testimonials Videos Grid -->
        <YouTubeVideoGrid videos={testimonialVideos} />
      </div>
    </section>
  )
}
