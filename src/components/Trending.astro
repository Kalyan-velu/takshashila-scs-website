---
export const prerender = false;
import { getLatestPosts } from '../lib/wordpress';
import { ArrowUpRight } from 'lucide-react';
import { Image } from 'astro:assets';

const posts = await getLatestPosts(4);

// Fallback static posts if API fails or brings 0 posts
const defaultPosts: any[] = [
  { id: 1, title: { rendered: "Effective Strategies for UPSC Preparation" }, excerpt: { rendered: "Discover top strategies to effectively plan an optimized learning process." }, link: "#" },
  { id: 2, title: { rendered: "Improving Answer Writing Skills for UPSC Mains Exam" }, excerpt: { rendered: "Master the art of answer writing with these proven techniques and tips." }, link: "#" },
  { id: 3, title: { rendered: "History optional : Strategy and Important Point" }, excerpt: { rendered: "Key focus areas and strategy for candidates opting for History." }, link: "#" },
  { id: 4, title: { rendered: "Why Personality Development Programmes Matters" }, excerpt: { rendered: "A Takshashila School of Civil Services Perspective on PD programs." }, link: "#" },
];

const renderPosts = posts.length > 0 ? posts : defaultPosts;
---

<section class="py-24 bg-muted/30">
  <div class="container mx-auto px-4 md:px-6">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-6">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-5xl font-light tracking-tight text-foreground mb-4">
          Trending now
        </h2>
        <p class="text-muted-foreground font-light text-lg">
          Insights, updates, and articles from Takshashila to fuel your preparation.
        </p>
      </div>
      
      <a href="/blog" class="inline-flex items-center text-primary font-medium hover:underline w-fit">
        View all articles
        <ArrowUpRight className="ml-1 w-4 h-4" />
      </a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      {renderPosts.map((post) => {
        // Simple regex to strip HTML tags from excerpt if present
        const cleanExcerpt = post.excerpt?.rendered?.replace(/<\/?[^>]+(>|$)/g, "") || "";
        const fallbackImage = "https://images.unsplash.com/photo-1456324504439-367cee3b3c32";
        const imageUrl = post._embedded?.['wp:featuredmedia']?.[0]?.source_url || fallbackImage;

        return (
        <a href={post.link} class="group flex flex-col items-start bg-card rounded-2xl border border-border overflow-hidden hover:shadow-md transition-all hover:-translate-y-1 h-full">
          <div class="w-full aspect-video overflow-hidden bg-muted">
            <Image 
              src={imageUrl} 
              alt={post.title.rendered} 
              width={350}
              height={197}
              class="object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <div class="flex items-center gap-2 mb-3">
              <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary/10 text-primary">
                Article
              </span>
            </div>
            <h3 class="text-xl font-medium tracking-tight mb-3 line-clamp-2 group-hover:text-primary transition-colors h-[3.5rem]" set:html={post.title.rendered}></h3>
            <p class="text-muted-foreground font-light text-sm line-clamp-3 mb-4 flex-grow" set:html={cleanExcerpt}></p>
            
            <div class="mt-auto inline-flex items-center text-sm font-medium text-foreground group-hover:text-primary">
              Read More
              <ArrowUpRight className="ml-1 w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all" />
            </div>
          </div>
        </a>
      )})}
    </div>
  </div>
</section>
