---
const { class: className } = Astro.props;
---

<div class={`relative inline-block p-1 ${className || ""}`}>
  <svg
    class="absolute inset-0 w-full h-full pointer-events-none text-primary-500/60"
    preserveAspectRatio="none"
    viewBox="0 0 100 100"
  >
    <!-- Main rough border -->
    <path
      d="M2,2 Q50,0 98,3 Q100,50 97,98 Q50,100 3,97 Q0,50 2,2 Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"></path>
    <!-- Subtle secondary border for the 'sketch' feel -->
    <path
      d="M3,4 Q50,2 96,5 Q99,50 95,96 Q50,98 4,95 Q2,50 3,4 Z"
      fill="none"
      stroke="currentColor"
      stroke-width="0.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"
      class="opacity-50"></path>
  </svg>
  <div class="relative z-10 w-full h-full bg-white border border-gray-200">
    <slot />
  </div>
</div>
