---
export const prerender = false;

import { getMagazines } from "@/lib/currentAffairs.ts";

const MONTH_NAMES = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December",
];

const magazines = await getMagazines();

// This island is the only non-static part of the (build-time compiled) /magazine
// page — cache it at the edge so it still updates through the day without a full rebuild.
Astro.response.headers.set(
  "Cache-Control",
  "public, s-maxage=1800, stale-while-revalidate=86400",
);
---

<div class="px-4 py-16 md:px-6 max-w-7xl mx-auto w-full">
  {
    magazines.length === 0 ? (
      <div class="text-center py-20 bg-gray-100/20 border border-dashed border-gray-200 rounded-3xl max-w-md mx-auto px-6">
        <h3 class="text-xl font-medium mb-2">No Magazines Available</h3>
        <p class="text-gray-600 font-light text-sm">
          We are currently updating our repository. Please check back soon for
          our latest current affairs magazines.
        </p>
      </div>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        {magazines.map((magazine) => (
          <div class="flex flex-col h-full bg-white rounded-3xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow duration-300">
            <div class="aspect-3/4 overflow-hidden bg-gray-100/30 border-b border-gray-200">
              <img
                src={magazine.coverImg ?? undefined}
                alt={magazine.title}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
            </div>

            <div class="flex flex-col flex-grow p-6 justify-between gap-4">
              <div>
                <p class="text-xs font-medium text-primary-500 mb-1">
                  {MONTH_NAMES[magazine.month - 1] ?? ""} {magazine.year}
                </p>
                <h3 class="font-medium text-gray-900 tracking-tight leading-snug line-clamp-2 text-base md:text-lg">
                  {magazine.title}
                </h3>
              </div>

              {magazine.pdfUrl ? (
                <a
                  href={magazine.pdfUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex w-full h-11 items-center justify-center rounded-2xl bg-primary-500 text-white hover:bg-primary-500/95 transition-colors font-semibold text-sm"
                >
                  Download PDF
                </a>
              ) : (
                <button
                  disabled
                  class="inline-flex w-full h-11 items-center justify-center rounded-2xl bg-gray-100 text-gray-600 border border-gray-200 font-semibold text-sm cursor-not-allowed"
                >
                  Coming Soon
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    )
  }
</div>
