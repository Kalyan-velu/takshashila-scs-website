---
import {Image} from "astro:assets"
import { ArrowRight, BookOpen, Users, Award, GraduationCap, MapPin, Search } from 'lucide-react';
---

<section class="relative overflow-hidden bg-background">
  <div class=" mx-auto relative z-10 ">
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center lg:pl-24">
        <div class="flex flex-col px-8 -mt-28 md:mt-0 md:px-0 lg:mb-32 text-left">
            <div class="inline-flex items-center shrink-0 max-w-fit flex-nowrap rounded-full border border-border bg-muted px-3 py-1 text-sm font-medium text-muted-foreground mb-6">
                <span class="flex h-2 w-2 rounded-full bg-primary mr-2"></span>
                <span class="text-nowrap">
                Best UPSC & APSC Coaching in Guwahati
                </span>
            </div>

            <h1 class="text-4xl md:text-6xl lg:text-7xl font-light  tracking-tight text-foreground max-w-4xl mb-6">
                Turning civil service  <span class="text-primary relative lg:whitespace-nowrap">
            <span class="relative">aspirations into achievements</span></span>
            </h1>

            <p class="text-base md:text-lg text-muted-foreground max-w-2xl font-light mb-10 leading-relaxed ">
                At Takshashila School of Civil Services, we are committed to helping you achieve your dream of becoming a civil servant. We provide the perfect environment for your preparation journey.
            </p>

            <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
                <a href="#"
                   class="inline-flex relative group outline-none focus:outline-none text-sm font-medium text-primary-foreground "
                >
                    <div class="bg-primary w-auto inline-flex items-center justify-center relative leading-tight shadow-none overflow-hidden rounded-full  py-3.5 px-7">
                        <div class="relative inline-flex top-px shrink-0">
                            <div>
                                Get in touch
                            </div>
                        </div>
                    </div>
                    <div class="bg-primary shrink-0 overflow-hidden flex items-center justify-center -ml-1 rounded-full transform transition-transform | size-12 | xl:group-hover:translate-x-3  xl:group-hover:rotate-45">
                        <svg class="ml-0.5 size-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path d="M328 96h24v288h-48V177.9L81 401l-17 17-33.9-34 17-17 223-223H64V96h264z"></path></svg>
                    </div>
                </a>
                <a href="#about" class="inline-flex h-12 items-center justify-center rounded-full bg-background px-8 text-base font-medium text-foreground hover:bg-muted/50 transition-all ">
                    Download Brochure
                    <ArrowRight className="ml-2 w-4 h-4" />
                </a>
            </div>
        </div>
        <div class="relative block order-first sm:hidden lg:block lg:order-last  mb-8 lg:mt-0 lg:mb-0">
        <div class="relative z-10 w-full  max-w-full ">
          <div class=" clip-polygon overflow-hidden shadow-2xl bg-muted">
            <Image
              src="/Takshashila/students.jpg" 
              alt="Takshashila School of Civil Services Students" 
              class="aspect-square object-cover"
              loading={"eager"}
              height={400}
              width={800}
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
    @reference "../styles/globals.css";
    
    @layer utilities {
        .clip-polygon{
            clip-path: polygon(17% 0%, 100% 0%, 100% 100%, 2% 100%, 31.30% 33.79%);
            -webkit-mask-image: linear-gradient(to bottom,rgb(0, 0, 0) 50%,rgba(0,0,0,0) 99%);
            mask-image: linear-gradient(to bottom,rgb(0, 0, 0) 50%,rgba(0,0,0,0) 99%);
            -webkit-mask-position: center;
            mask-position: center;
            -webkit-mask-size: cover;
            mask-size: cover;
            -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
        }
    }
    
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
  
</style>
