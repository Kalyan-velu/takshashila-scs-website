---
import { ArrowRight, BookOpen } from 'lucide-react';
---

<section class="relative overflow-hidden bg-background pt-16 md:pt-24 pb-32">
  <div class="container mx-auto relative z-10 px-4 md:px-6 flex flex-col  text-left">
    <div class="inline-flex items-center shrink-0 max-w-fit rounded-full border border-border bg-muted px-3 py-1 text-sm font-medium text-muted-foreground mb-6">
      <span class="flex h-2 w-2 rounded-full bg-primary mr-2"></span>
      Best UPSC & APSC Coaching in Guwahati
    </div>
    
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-light tracking-tight text-foreground max-w-4xl mb-6">
      Making your vision <span class="text-primary relative whitespace-nowrap">
        <span class="relative">become a reality</span></span>
    </h1>
    
    <p class="text-base md:text-lg text-muted-foreground max-w-2xl font-light mb-10 leading-relaxed ">
      At Takshashila School of Civil Services, we are committed to helping you achieve your dream of becoming a civil servant. We provide the perfect environment for your preparation journey.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center gap-4">
        <a
                href="#"
                class="inline-flex relative group outline-none focus:outline-none text-sm font-medium text-primary-foreground "
        >
            <div class="bg-primary w-auto inline-flex items-center justify-center relative leading-tight shadow-none overflow-hidden rounded-full  py-3.5 px-7">
                <div class="relative inline-flex top-px shrink-0">
                    <div>
                        Free Demo Class
                    </div>
                </div>
            </div>
            <div class="bg-primary shrink-0 overflow-hidden flex items-center justify-center -ml-1 rounded-full transform transition-transform | size-12 | xl:group-hover:translate-x-3  xl:group-hover:rotate-45">
                <svg class="ml-0.5 size-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512"><path d="M328 96h24v288h-48V177.9L81 401l-17 17-33.9-34 17-17 223-223H64V96h264z"></path></svg>
            </div>
        </a>
      <a href="#about" class="inline-flex h-12 items-center justify-center rounded-full bg-background px-8 text-base font-medium text-foreground hover:bg-muted/50 transition-all ">
        Know More
        <ArrowRight className="ml-2 w-4 h-4" />
      </a>
    </div>
  </div>
</section>
