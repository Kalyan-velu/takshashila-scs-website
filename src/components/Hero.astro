<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
  .clip-polygon{
      clip-path: polygon(17% 0%, 100% 0%, 100% 100%, 2% 100%, 31.30% 33.79%);
  }
</style>
