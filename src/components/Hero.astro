---
import { Image } from "astro:assets";
import {
  ArrowRight,
  BookOpen,
  Users,
  Award,
  GraduationCap,
  MapPin,
  Search,
} from "lucide-react";
---

<section class="relative overflow-hidden bg-background">
  <div class="relative pb-16 md:pb-24 z-10">
    <div
      class="grid md:grid-cols-2 gap-4 sm:gap-8 lg:gap-12 items-center lg:pl-24"
    >
      <div
        class="flex flex-col px-4 sm:px-8 md:px-6 lg:px-0 -mt-52 sm:-mt-32 md:mt-0 lg:mb-32 text-left order-last md:order-first relative z-20"
      >
        <div
          class="inline-flex items-center shrink-0 max-w-fit flex-nowrap rounded-full border border-border bg-muted px-3 py-1 text-sm md:text-base font-medium text-muted-foreground mb-6"
        >
          <span class="flex h-2 w-2 rounded-full bg-primary mr-2 md:mr-3"
          ></span>
          <span class="text-nowrap">
            Best UPSC & APSC Coaching in Guwahati
          </span>
        </div>

        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-light tracking-tight text-foreground max-w-4xl mb-4 sm:mb-6 md:leading-[1.1]"
        >
          Turning civil service <span
            class="text-primary relative lg:whitespace-nowrap"
          >
            <span class="relative">aspirations into achievements</span></span
          >
        </h1>

        <p
          class="text-base sm:text-lg lg:text-xl text-muted-foreground max-w-2xl font-light mb-8 sm:mb-10 leading-relaxed"
        >
          At Takshashila School of Civil Services, we are committed to helping
          you achieve your dream of becoming a civil servant. We provide the
          perfect environment for your preparation journey.
        </p>

        <div class="flex flex-row items-center gap-4 sm:gap-6">
          <a
            href="/courses"
            class="inline-flex relative group outline-none focus:outline-none text-xs sm:text-sm md:text-base font-medium text-primary-foreground"
          >
            <div
              class="bg-primary w-auto inline-flex items-center justify-center relative leading-tight shadow-none overflow-hidden rounded-full py-3 px-5 sm:py-3.5 sm:px-7 md:py-4 md:px-8"
            >
              <div class="relative inline-flex top-px shrink-0">
                <div>Join a Course</div>
              </div>
            </div>
            <div
              class="bg-primary shrink-0 overflow-hidden flex items-center justify-center -ml-1 rounded-full transform transition-transform | size-10 sm:size-12 md:size-14 | xl:group-hover:translate-x-3 xl:group-hover:rotate-45"
            >
              <svg
                class="ml-0.5 size-3 sm:size-4 md:size-5 fill-current"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 384 512"
                ><path
                  d="M328 96h24v288h-48V177.9L81 401l-17 17-33.9-34 17-17 223-223H64V96h264z"
                ></path></svg
              >
            </div>
          </a>
          <a
            target="_blank"
            download="https://pub-4ee2c1b01a3c40788c1b264235b20a97.r2.dev/brand_site/pdfs/TSCS-Brochure-2026-new_compressed.pdf"
            href="https://pub-4ee2c1b01a3c40788c1b264235b20a97.r2.dev/brand_site/pdfs/TSCS-Brochure-2026-new_compressed.pdf"
            class="inline-flex h-10 sm:h-12 md:h-14 items-center justify-center rounded-full bg-background border border-border px-6 sm:px-8 text-xs sm:text-sm md:text-base lg:text-base font-medium text-foreground hover:bg-muted/50 transition-all"
          >
            Download Brochure
            <ArrowRight className="ml-2 w-3 sm:w-4 md:w-5 h-3 sm:h-4 md:h-5" />
          </a>
        </div>
      </div>

      <div
        class="relative w-full order-first md:order-last mb-8 md:mb-0 lg:mt-0 lg:mb-0 z-10 max-w-full"
      >
        <div class="clip-polygon overflow-hidden bg-muted">
          <Image
            src="/Takshashila/students.webp"
            alt="Takshashila School of Civil Services Students"
            class="aspect-square object-cover w-full h-full md:aspect-4/3 lg:aspect-square"
            loading={"eager"}
            height={400}
            width={800}
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @reference "../styles/globals.css";

  @layer utilities {
    .clip-polygon {
      clip-path: polygon(17% 0%, 100% 0%, 100% 100%, 2% 100%, 31.3% 33.79%);
      -webkit-mask-image: linear-gradient(
        to bottom,
        rgb(0, 0, 0) 50%,
        rgba(0, 0, 0, 0) 99%
      );
      mask-image: linear-gradient(
        to bottom,
        rgb(0, 0, 0) 50%,
        rgba(0, 0, 0, 0) 99%
      );
      -webkit-mask-position: center;
      mask-position: center;
      -webkit-mask-size: cover;
      mask-size: cover;
      -webkit-mask-repeat: no-repeat;
      mask-repeat: no-repeat;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }
  .animate-float {
    animation: float 4s ease-in-out infinite;
  }
</style>
