---
import { ArrowRight, BookOpen } from 'lucide-react';
---

<section class="relative overflow-hidden bg-background pt-16 md:pt-24 pb-32">
  <!-- Subtle background decoration -->
  <div class="absolute inset-0 z-0">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-primary/10 rounded-full blur-3xl opacity-50"></div>
    <div class="absolute top-1/2 -left-24 w-72 h-72 bg-secondary/20 rounded-full blur-3xl opacity-50"></div>
  </div>

  <div class="container mx-auto relative z-10 px-4 md:px-6 flex flex-col items-center text-center">
    <div class="inline-flex items-center rounded-full border border-border bg-muted px-3 py-1 text-sm font-medium text-muted-foreground mb-6">
      <span class="flex h-2 w-2 rounded-full bg-primary mr-2"></span>
      Best UPSC & APSC Coaching in Guwahati
    </div>
    
    <h1 class="text-4xl md:text-6xl lg:text-7xl font-extrabold tracking-tight text-foreground max-w-4xl mb-6">
      Making your vision <span class="text-primary relative whitespace-nowrap"><span class="relative">become a reality</span></span>
    </h1>
    
    <p class="text-lg md:text-xl text-muted-foreground max-w-2xl mb-10 leading-relaxed text-balance">
      At Takshashila School of Civil Services, we are committed to helping you achieve your dream of becoming a civil servant. We provide the perfect environment for your preparation journey.
    </p>
    
    <div class="flex flex-col sm:flex-row items-center gap-4">
      <a href="#demo" class="inline-flex h-12 items-center justify-center rounded-md bg-primary px-8 text-base font-medium text-primary-foreground hover:bg-primary/90 transition-all hover:scale-105 shadow-sm">
        Free Demo Class
        <BookOpen className="ml-2 w-4 h-4" />
      </a>
      <a href="#about" class="inline-flex h-12 items-center justify-center rounded-md border border-border bg-background px-8 text-base font-medium text-foreground hover:bg-muted/50 transition-all shadow-sm">
        Know More
        <ArrowRight className="ml-2 w-4 h-4" />
      </a>
    </div>
  </div>
</section>
