---
import Layout from "@/layouts/Layout.astro";
import teamData from "@/data/team.json";

const seoTitle = "Our Team | Takshashila School of Civil Services";
const seoDescription =
  "Meet the expert faculties and mentoring guiding our students to success in UPSC and APSC examinations.";
---

<Layout title={seoTitle} description={seoDescription}>
  <div class="bg-primary/5 py-12 md:py-20 border-b border-border">
    <div class="container mx-auto px-4 lg:px-24">
      <div
        class="inline-flex items-center shrink-0 max-w-fit flex-nowrap rounded-full border border-border bg-background px-3 py-1 text-sm font-medium text-muted-foreground mb-6 shadow-sm"
      >
        <span class="flex h-2 w-2 rounded-full bg-primary mr-2 animate-pulse"
        ></span>
        Our Faculties
      </div>
      <h1
        class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-foreground max-w-4xl mb-6 leading-tight"
      >
        Meet The <span class="text-primary font-medium">Team</span>
      </h1>
      <p
        class="text-lg md:text-xl text-muted-foreground max-w-2xl font-light mb-8 leading-relaxed"
      >
        Our highly experienced and dedicated team of experts bring decades of
        knowledge to guide your journey in cracking the toughest civil service
        exams.
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-24 py-16 md:py-24">
    <div class="flex flex-col gap-8 w-full">
      {
        teamData.faculty.map((member) => (
          <div class="group flex flex-col md:flex-row bg-card/30 backdrop-blur-sm border border-border/50 rounded-3xl overflow-hidden hover:shadow-2xl hover:border-primary/30 transition-all duration-500">
            {/* Faculty Photo */}
            <div class="relative w-full md:w-72 lg:w-80 aspect-square md:aspect-auto overflow-hidden bg-muted/20 shrink-0">
              <img
                src={member.image}
                alt={member.name}
                height="300"
                width="300"
                class="w-full h-full object-cover object-top transform scale-100 group-hover:scale-105 transition-transform duration-700 ease-in-out"
                loading="lazy"
              />
            </div>

            {/* Card Content Block */}
            <div class="p-6 md:p-8 flex flex-col flex-1 bg-background/50 justify-center">
              <span class="inline-block px-2.5 py-0.5 bg-primary/10 text-primary text-[10px] font-semibold rounded-md uppercase tracking-wider mb-2.5 w-fit">
                {member.designation}
              </span>
              <h3 class="text-xl font-bold text-foreground mb-3 leading-tight group-hover:text-primary transition-colors">
                {member.name}
              </h3>
              <p class="text-muted-foreground text-sm font-light leading-relaxed grow text-pretty whitespace-pre-wrap mb-4">
                {member.description}
              </p>

              {/* Social Links (if present) */}
              {member.socials && Object.keys(member.socials).length > 0 && (
                <div class="flex items-center gap-3 pt-3.5 border-t border-border/50 mt-auto">
                  {member.socials.linkedin && (
                    <a
                      href={member.socials.linkedin}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-muted-foreground hover:text-primary transition-colors"
                      aria-label={`${member.name}'s LinkedIn`}
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.779-1.75-1.75s.784-1.75 1.75-1.75 1.75.779 1.75 1.75-.784 1.75-1.75 1.75zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                      </svg>
                    </a>
                  )}
                  {member.socials.twitter && (
                    <a
                      href={member.socials.twitter}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-muted-foreground hover:text-primary transition-colors"
                      aria-label={`${member.name}'s Twitter`}
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/>
                      </svg>
                    </a>
                  )}
                  {member.socials.email && (
                    <a
                      href={`mailto:${member.socials.email}`}
                      class="text-muted-foreground hover:text-primary transition-colors"
                      aria-label={`Email ${member.name}`}
                    >
                      <svg class="w-4 h-4 fill-none stroke-current" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                        <polyline points="22,6 12,13 2,6"/>
                      </svg>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
