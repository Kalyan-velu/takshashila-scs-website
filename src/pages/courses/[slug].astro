---
import Layout from "@/layouts/Layout.astro";
import CourseTabs from "@/components/course/CourseTabs.vue";
import EnrollmentSidebar from "@/components/course/EnrollmentSidebar.vue";
import { getCollection, render } from "astro:content";
import GoogleTagManager from "@/lib/GTag/GoogleTagManager.astro";

export async function getStaticPaths() {
  const allCourses = await getCollection("courses");
  const slugs = [...new Set(allCourses.map((c) => c.data.courseSlug))];

  return slugs.map((slug) => {
    const entries = allCourses.filter((c) => c.data.courseSlug === slug);
    const main = entries.find((e) => e.data.type === "about-course");
    const aboutExam = entries.find((e) => e.data.type === "about-exam");
    const notification = entries.find((e) => e.data.type === "notification");

    return {
      params: { slug },
      props: {
        main,
        aboutExam,
        notification,
      },
    };
  });
}

const { main, aboutExam, notification } = Astro.props;
if (!main) throw new Error("Main course content not found");
if (!aboutExam) throw new Error("About Exam content not found");
if (!notification) throw new Error("Notification content not found");
const data = main?.data;

const { Content: AboutCourse } = await render(main);
const { Content: AboutExam } = await render(aboutExam);
const { Content: Notification } = await render(notification);

const courseItems = data.courses ?? [];
const availableModes = [...new Set(courseItems.flatMap((c) => c.modes))];
const hasModes = availableModes.length > 1;
---

<Layout
  title={data.seoTitle}
  description={data.seoDescription}
  keywords={data.seoKeywords}
  image={data.ogImage}
>
  <div class="bg-primary/5 py-12 md:py-20 border-b border-border">
    <div class="container mx-auto px-4 lg:px-24">
      <div
        class="inline-flex items-center shrink-0 max-w-fit flex-nowrap rounded-full border border-border bg-background px-3 py-1 text-sm font-medium text-muted-foreground mb-6 shadow-sm"
      >
        <span class="flex h-2 w-2 rounded-full bg-primary mr-2 animate-pulse"
        ></span>
        {data.badge}
      </div>
      <h1
        class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-foreground max-w-4xl mb-6 leading-tight"
      >
        Comprehensive <span class="text-primary font-medium"
          >{data.highlightWord}</span
        > Course
      </h1>
      <p
        class="text-lg md:text-xl text-muted-foreground max-w-2xl font-light mb-8 leading-relaxed"
      >
        {data.description}
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-24 py-8 md:py-16">
    <div
      class="flex flex-col lg:grid lg:grid-cols-12 gap-8 lg:gap-16 items-start"
    >
      <div class="lg:col-span-8 w-full min-w-0">
        <CourseTabs
          client:load
          hasModes={hasModes}
          availableModes={availableModes}
        >
          <div slot="about-course" class="markdown-content">
            <AboutCourse />
          </div>
          <div slot="about-exam" class="markdown-content">
            <AboutExam />
          </div>
          <div slot="notification" class="markdown-content">
            <Notification />
          </div>
        </CourseTabs>
      </div>
      <div
        class="lg:col-span-4 w-full sticky top-0 z-10 transition-all duration-500"
      >
        <EnrollmentSidebar
          client:load
          price={data.price}
          period={data.pricePeriod}
          features={data.features}
          courseItems={courseItems}
          hasModes={hasModes}
        />
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .markdown-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-foreground, #333);
  }

  .dark .markdown-content {
    color: var(--color-foreground, #ccc);
  }

  .markdown-content h1,
  .markdown-content h2,
  .markdown-content h3,
  .markdown-content h4 {
    color: var(--color-primary, #6b21a8);
    font-weight: 400;
    letter-spacing: -0.025em;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .markdown-content h2 {
    font-size: 1.875rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.5rem;
  }

  .markdown-content h3 {
    font-size: 1.5rem;
    color: var(--color-foreground);
    font-weight: 500;
  }

  .markdown-content p {
    margin-bottom: 1.25rem;
  }

  .markdown-content a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .markdown-content ul,
  .markdown-content ol {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .markdown-content li {
    margin-bottom: 0.5rem;
  }

  .markdown-content ul {
    list-style-type: disc;
  }

  .markdown-content table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    overflow-x: auto;
    display: block;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .markdown-content table {
      display: table;
      white-space: normal;
    }
  }

  .markdown-content th,
  .markdown-content td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .markdown-content th {
    background-color: var(--color-muted);
    font-weight: 600;
    color: var(--color-foreground);
  }

  .markdown-content strong {
    font-weight: 600;
    color: var(--color-foreground);
  }

  .markdown-content hr {
    border-color: var(--color-border);
    margin: 2rem 0;
  }
</style>

+
