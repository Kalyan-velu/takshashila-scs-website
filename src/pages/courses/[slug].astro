---
import CourseTabs from "@/components/course/CourseTabs.vue";
import Enroll from "@/components/course/EnrollmentSidebar.vue";
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const allCourses = await getCollection("courses");
  const slugs = [...new Set(allCourses.map((c) => c.data.courseSlug))];

  return slugs.map((slug) => {
    const entries = allCourses.filter((c) => c.data.courseSlug === slug);
    const main = entries.find((e) => e.data.type === "about-course");
    const aboutExam = entries.find((e) => e.data.type === "about-exam");
    const notification = entries.find((e) => e.data.type === "notification");

    return {
      params: { slug },
      props: {
        main,
        aboutExam,
        notification,
      },
    };
  });
}

const { main, aboutExam, notification } = Astro.props;
if (!main) throw new Error("Main course content not found");
if (!aboutExam) throw new Error("About Exam content not found");
if (!notification) throw new Error("Notification content not found");
const data = main?.data;

const { Content: AboutCourse } = await render(main);
const { Content: AboutExam } = await render(aboutExam);
const { Content: Notification } = await render(notification);

const courseItems = data.courses ?? [];
const availableModes = [...new Set(courseItems.flatMap((c) => c.modes))];
const hasModes = availableModes.length > 1;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://takshashilascs.com").href;

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": data.title,
  "description": data.description,
  "url": canonicalUrl,
  "provider": {
    "@type": "EducationalOrganization",
    "name": "Takshasheela School of Civil Services",
    "sameAs": "https://takshashilascs.com"
  },
  "hasCourseInstance": [
    {
      "@type": "CourseInstance",
      "courseMode": "Online",
      "instructor": {
        "@type": "Person",
        "name": "Experienced Faculties from Delhi and Assam"
      }
    },
    {
      "@type": "CourseInstance",
      "courseMode": "Offline",
      "location": {
        "@type": "Place",
        "name": "Guwahati Center",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Guwahati",
          "addressRegion": "Assam",
          "addressCountry": "IN"
        }
      }
    }
  ],
  "offers": courseItems.map((c) => ({
    "@type": "Offer",
    "name": c.title,
    "category": "Paid",
    "price": c.prices?.online?.discount || c.prices?.offline?.discount || 0,
    "priceCurrency": "INR"
  }))
};
---

<Layout
  title={data.seoTitle}
  description={data.seoDescription}
  keywords={data.seoKeywords}
  image={data.ogImage}
>
  <Fragment slot="head_data">
    <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />
  </Fragment>
  <div class="bg-primary-500/5 py-12 md:py-20 border-b border-gray-200">
    <div class="container mx-auto px-4 lg:px-24">
      <div
        class="inline-flex items-center shrink-0 max-w-fit flex-nowrap rounded-full border border-gray-200 bg-white px-3 py-1 text-sm font-medium text-gray-600 mb-6 shadow-sm"
      >
        <span
          class="flex h-2 w-2 rounded-full bg-primary-500 mr-2 animate-pulse"
        ></span>
        {data.badge}
      </div>
      <h1
        class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-gray-900 max-w-4xl mb-6 leading-tight"
      >
        Comprehensive <span class="text-primary-500 font-medium"
          >{data.highlightWord}</span
        > Course
      </h1>
      <p
        class="text-lg md:text-xl text-gray-600 max-w-2xl font-light mb-8 leading-relaxed"
      >
        {data.description}
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-24 py-8 md:py-16">
    <div
      class="flex flex-col lg:grid lg:grid-cols-12 gap-8 lg:gap-16 items-start"
    >
      <div class="lg:col-span-8 w-full min-w-0">
        <CourseTabs
          client:visible
          hasModes={hasModes}
          availableModes={availableModes}
        >
          <div slot="about-course" class="markdown-content">
            <AboutCourse />
          </div>
          <div slot="about-exam" class="markdown-content">
            <AboutExam />
          </div>
          <div slot="notification" class="markdown-content">
            <Notification />
          </div>
        </CourseTabs>
      </div>
      <div
        class="lg:col-span-4 w-full sticky top-0 z-10 transition-all duration-500"
      >
        <Enroll
          client:visible="vue"
          price={data.price}
          period={data.pricePeriod}
          features={data.features}
          courseItems={courseItems}
          hasModes={hasModes}
        />
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  .markdown-content {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--foreground, #333);
  }

  .dark .markdown-content {
    color: var(--foreground, #ccc);
  }

  .markdown-content h1,
  .markdown-content h2,
  .markdown-content h3,
  .markdown-content h4 {
    color: var(--color-primary-500);
    font-weight: 500;
    letter-spacing: -0.025em;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .markdown-content h2 {
    font-size: 1.875rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.5rem;
  }

  .markdown-content h3 {
    font-size: 1.5rem;
    color: var(--foreground);
    font-weight: 600;
  }

  .markdown-content p {
    margin-bottom: 1.25rem;
  }

  .markdown-content a {
    color: var(--color-primary-500);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .markdown-content ul,
  .markdown-content ol {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .markdown-content li {
    margin-bottom: 0.5rem;
  }

  .markdown-content ul {
    list-style-type: disc;
  }

  .markdown-content table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1.5rem;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    overflow-x: auto;
    display: block;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .markdown-content table {
      display: table;
      white-space: normal;
    }
  }

  .markdown-content th,
  .markdown-content td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .markdown-content th {
    background-color: var(--muted);
    font-weight: 600;
    color: var(--foreground);
  }

  .markdown-content strong {
    font-weight: 600;
    color: var(--foreground);
  }

  .markdown-content hr {
    border-color: var(--border);
    margin: 2rem 0;
  }
</style>
