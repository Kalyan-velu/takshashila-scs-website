---
import Layout from "@/layouts/Layout.astro";
import CoursesTabs from "@/components/courses/CoursesTabs.vue";
import CoachingProse from "@/components/CoachingProse.astro";
import FaqSection from "@/components/FaqSection.astro";
import AdreCTA from "@/components/AdreCTA.astro";
import { CATEGORIES } from "@/data/category.ts";
import { getCollection } from "astro:content";

const seoTitle = "Buy Courses | Takshasheela School of Civil Services";
const seoDescription =
  "Browse and enroll in our comprehensive civil services coaching programs. APSC, UPSC, Optional subjects and more.";

const allEntries = await getCollection("courses");
const aboutCourseEntries = allEntries.filter(
  (e) => e.data.type === "about-course" && e.data.courses,
);
const courses = aboutCourseEntries.flatMap((e) =>
  (e.data.courses ?? []).map((c) => ({
    ...c,
    url: `/courses/${e.data.courseSlug}/`,
    parentPrice: e.data.price,
    parentPricePeriod: e.data.pricePeriod,
  })),
);
const siteUrl = Astro.site ? Astro.site.href.replace(/\/$/, "") : "https://takshashilascs.com";

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Civil Services Coaching Programs",
  "itemListElement": aboutCourseEntries.map((e, index) => {
    const courseItems = e.data.courses ?? [];
    const availableModes = new Set(courseItems.flatMap((c) => c.modes));

    const hasCourseInstance = [
      availableModes.has("offline")
        ? {
            "@type": "CourseInstance",
            "courseMode": "Offline",
            "location": {
              "@type": "Place",
              "name": "Guwahati Center",
              "address": {
                "@type": "PostalAddress",
                "addressLocality": "Guwahati",
                "addressRegion": "Assam",
                "addressCountry": "IN"
              }
            }
          }
        : null,
      availableModes.has("online") || availableModes.size === 0
        ? {
            "@type": "CourseInstance",
            "courseMode": "Online",
            "instructor": {
              "@type": "Person",
              "name": "Experienced Faculties from Delhi and Assam"
            }
          }
        : null,
    ].filter(Boolean);

    const offers = courseItems.length
      ? courseItems.map((c) => ({
          "@type": "Offer",
          "name": c.title,
          "category": "Paid",
          "price": c.prices?.online?.discount ?? c.prices?.offline?.discount ?? 0,
          "priceCurrency": "INR",
          "url": `${siteUrl}/courses/${e.data.courseSlug}/`,
        }))
      : [
          {
            "@type": "Offer",
            "name": e.data.title,
            "category": "Paid",
            "price": Number(e.data.price) || 0,
            "priceCurrency": "INR",
            "url": `${siteUrl}/courses/${e.data.courseSlug}/`,
          },
        ];

    return {
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Course",
        "name": e.data.title,
        "description": e.data.description,
        "url": `${siteUrl}/courses/${e.data.courseSlug}/`,
        "provider": {
          "@type": "EducationalOrganization",
          "name": "Takshasheela School of Civil Services",
          "sameAs": siteUrl
        },
        "hasCourseInstance": hasCourseInstance,
        "offers": offers
      }
    };
  })
};
---

<Layout title={seoTitle} description={seoDescription}>
  <Fragment slot="head_data">
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
  </Fragment>
  <div class="bg-primary-500/5 py-12 md:py-20 border-b border-gray-200">
    <div class="container mx-auto px-4 lg:px-24">
      <div
        class="inline-flex items-center shrink-0 max-w-fit flex-nowrap rounded-full border border-gray-200 bg-white px-3 py-1 text-sm font-medium text-gray-600 mb-6 shadow-sm"
      >
        <span
          class="flex h-2 w-2 rounded-full bg-primary-500 mr-2 animate-pulse"
        ></span>
        Enrollments Open
      </div>
      <h1
        class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-gray-900 max-w-4xl mb-6 leading-tight"
      >
        Explore Our <span class="text-primary-500 font-medium">Courses</span>
      </h1>
      <p
        class="text-lg md:text-xl text-gray-600 max-w-2xl font-light mb-8 leading-relaxed"
      >
        Discover comprehensive coaching programs tailored to help you conquer
        civil service examinations. Find the perfect course to kickstart your
        journey.
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-24 py-8 md:py-16">
    <CoursesTabs client:visible courses={courses} categories={CATEGORIES} />
  </div>

  <AdreCTA />

  <CoachingProse id="coaching-in-guwahati" />

  <FaqSection />
</Layout>
