---
import Layout from '@/layouts/Layout.astro';
import CourseTabs from '@/components/courses/CourseTabs.vue';
import {CATEGORIES} from '@/data/category.ts';
import {getCollection} from 'astro:content';

const seoTitle = 'Buy Courses | Takshashila School of Civil Services';
const seoDescription = 'Browse and enroll in our comprehensive civil services coaching programs. APSC, UPSC, Optional subjects and more.';

const allEntries = await getCollection('courses');
const aboutCourseEntries = allEntries.filter(e => e.data.type === 'about-course' && e.data.courses);
const courses = aboutCourseEntries.flatMap(e =>
  (e.data.courses ?? []).map(c => ({ ...c, url: `/courses/${e.data.courseSlug}` }))
);
---

<Layout title={seoTitle}  description={seoDescription}>
  <div class='bg-primary/5 py-12 md:py-20 border-b border-border'>
    <div class='container mx-auto px-4 lg:px-24'>
      <div class='inline-flex items-center shrink-0 max-w-fit flex-nowrap rounded-full border border-border bg-background px-3 py-1 text-sm font-medium text-muted-foreground mb-6 shadow-sm'>
        <span class='flex h-2 w-2 rounded-full bg-primary mr-2 animate-pulse'></span>
        Enrollments Open
      </div>
      <h1 class='text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-foreground max-w-4xl mb-6 leading-tight'>
        Explore Our <span class='text-primary font-medium'>Courses</span>
      </h1>
      <p class='text-lg md:text-xl text-muted-foreground max-w-2xl font-light mb-8 leading-relaxed'>
        Discover comprehensive coaching programs tailored to help you conquer civil service examinations. Find the perfect course to kickstart your journey.
      </p>
    </div>
  </div>

  <div class='container mx-auto px-4 lg:px-24 py-8 md:py-16'>
    <CourseTabs client:load courses={courses} categories={CATEGORIES} />
  </div>
</Layout>
