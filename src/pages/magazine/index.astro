---
import Layout from "@/layouts/Layout.astro";
import MagazineGrid from "@/components/MagazineGrid.astro";
---

<Layout
  title="Monthly Magazines | Takshasheela School of Civil Services"
  description="Stay updated with our curated monthly current affairs magazines, specifically compiled by experts to boost your UPSC and APSC preparation."
>
  <div
    class="bg-primary-500/5 py-16 flex flex-col items-center justify-center text-center px-4 border-b border-gray-200"
  >
    <h1
      class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-gray-900 max-w-4xl mb-4 leading-tight"
    >
      Monthly <span class="text-primary-500 font-medium">Magazines</span>
    </h1>
    <p class="text-gray-600 font-light text-lg max-w-2xl leading-relaxed">
      Stay updated with our curated monthly current affairs magazines,
      specifically compiled by experts to boost your UPSC and APSC preparation.
    </p>
  </div>

  <MagazineGrid server:defer>
    <div slot="fallback" class="px-4 py-16 md:px-6 max-w-7xl mx-auto w-full">
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
        {Array.from({ length: 4 }).map(() => (
          <div class="aspect-3/4 rounded-3xl border border-gray-200 bg-gray-100/50 animate-pulse" />
        ))}
      </div>
    </div>
  </MagazineGrid>
</Layout>
