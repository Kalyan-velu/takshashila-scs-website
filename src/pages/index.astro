---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import WhyChooseUs from "../components/WhyChooseUs.astro";
import Courses from "../components/courses/CoursesWrapper.astro";
import Gallery from "../components/Gallery.astro";
import LatestArticles from "../components/LatestArticles.vue";
import { supabase } from "@/lib/db/supabase.ts";

const { data, error } = await supabase.from("todos").select("*");
---

<Layout>
  <Hero />
  <WhyChooseUs id="about" />
  <Courses id="courses" />
  <LatestArticles client:only="vue" />
  <Gallery />
  `
  {
    data && data.length > 0 && (
      <ul class="px-4 md:px-6 py-8">
        {data.map((entry) => (
          <li>{entry.name}</li>
        ))}
      </ul>
    )
  }
</Layout>
