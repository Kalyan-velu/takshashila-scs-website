---
import Layout from "../layouts/Layout.astro";
import FaqSection from "@/components/FaqSection.astro";
import { Image } from "astro:assets";

const title = "About Us | Takshasheela School of Civil Services";
const description =
  "Learn more about Takshasheela School of Civil Services, the premier institution for UPSC and APSC preparation in Guwahati. Discover our mission, expert faculty, and state-of-the-art infrastructure.";
---

<Layout title={title} description={description}>
  <section class="relative pb-16 md:pb-24 overflow-hidden">
    <div
      class="bg-primary-500/5 py-12 flex items-center justify-center md:py-20 border-b border-gray-200"
    >
      <h1
        class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-gray-900 max-w-4xl mb-6 leading-tight"
      >
        About <span class="text-primary-500 font-medium">Us</span>
      </h1>
    </div>
    <div class="px-4 py-12 md:px-6 max-w-7xl mx-auto">
      <div class="flex flex-col gap-16 md:gap-24">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="space-y-8">
            <div
              class="space-y-6 text-lg text-gray-600 font-light leading-relaxed"
            >
              <p>
                Takshasheela School of Civil Services, a unit of <strong>Takshashila Educational Trust</strong> (formerly known as <strong>Takshashila School of Civil Services</strong>), is a premier institution
                for the preparation of UPSC and APSC. It is a unique initiative
                started in 2022 to provide a platform to the youth of Assam and
                North-East to prepare for UPSC and APSC with the help and
                guidance of talented mentors and faculties of various subjects
                from all over India at Takshasheela the Best APSC coaching in
                Guwahati.
              </p>
              <p>
                Explore our <a
                  href="/courses/"
                  class="text-primary-500 hover:underline underline-offset-4"
                  >comprehensive courses page</a
                > to discover detailed programs, tailored resources, and expert guidance.
                These are aimed at equipping aspirants with the knowledge and skills
                required to excel in civil services examinations offered at the Takshasheela
                School of Civil Services. This institution is recognized as providing
                the best APSC coaching in Guwahati.
              </p>
              <p>
                At the Takshasheela School of Civil Services, we take pride in
                our innovative teaching methodologies and curriculum. These are
                designed to build confidence and clarity in your preparation.
                This makes us the top choice for APSC coaching in Guwahati.
              </p>
              <p>
                For any inquiries, enrollment details, or personalized
                assistance, visit our <a
                  href="/contact/"
                  class="text-primary-500 hover:underline underline-offset-4"
                  >contact page</a
                >. Our dedicated team is available to address your questions and
                guide you through the admission process of Takshasheela School
                of Civil Services. We also provide the support you need for a
                successful learning journey. Takshasheela School is renowned for
                the best coaching institute for APSC in Guwahati.
              </p>
            </div>
          </div>

          <div
            class="relative w-full h-full min-h-100 lg:min-h-150 rounded-none overflow-hidden shadow-2xl"
          >
            <Image
              src="/Takshasheela/students.webp"
              alt="Takshasheela School of Civil Services Students"
              class="absolute inset-0 w-full h-full object-cover hover:scale-105 transition-transform duration-700"
              width={800}
              height={1000}
            />
            <div
              class="absolute inset-0 bg-linear-to-t from-background/80 via-background/20 to-transparent pointer-events-none"
            >
            </div>
          </div>
        </div>

        <div class="space-y-12">
          <div class="text-center space-y-4 max-w-2xl mx-auto">
            <h2
              class="text-3xl md:text-4xl font-light tracking-tight text-gray-900"
            >
              Our <span class="text-primary-500 italic">Core Features</span>
            </h2>
            <p class="text-gray-600 font-light leading-relaxed">
              We provide the best infrastructure and guidance to help our
              students excel in their civil services journey.
            </p>
          </div>

          <div class="flex flex-row flex-wrap">
            <div class="p-8 basis-full sm:basis-1/2 md:basis-1/3">
              <div
                class="p-8 size-full rounded-none bg-white border border-gray-200 shadow-sm hover:border-primary-500/30 transition-all group hover:-translate-y-1"
              >
                <div
                  class="w-14 h-14 rounded-2xl bg-primary-500/10 flex items-center justify-center text-primary-500 mb-6 group-hover:scale-110 transition-transform"
                >
                  <iconify-icon icon="lucide:users" class="text-3xl"></iconify-icon>
                </div>
                <h3 class="text-2xl font-medium text-gray-900 mb-4">
                  Highly Qualified Faculty
                </h3>
                <p class="text-gray-600 font-light leading-relaxed">
                  Expert faculties and mentors from Delhi and all over India,
                  providing resources, guidance and online recorded classes,
                  making Takshasheela the best online APSC coaching in Guwahati.
                </p>
              </div>
            </div>
            <div class="p-8 basis-full sm:basis-1/2 md:basis-1/3">
              <div
                class="p-8 size-full rounded-none bg-white border border-gray-200 shadow-sm hover:border-primary-500/30 transition-all group hover:-translate-y-1"
              >
                <div
                  class="w-14 h-14 rounded-2xl bg-primary-500/10 flex items-center justify-center text-primary-500 mb-6 group-hover:scale-110 transition-transform"
                >
                  <iconify-icon icon="lucide:building-2" class="text-3xl"></iconify-icon>
                </div>
                <h3 class="text-2xl font-medium text-gray-900 mb-4">
                  Infrastructure
                </h3>
                <p class="text-gray-600 font-light leading-relaxed">
                  State-of-the-art infrastructure. Technology – enabled smart
                  classrooms. This will facilitate better learning and improve
                  outcomes.
                </p>
              </div>
            </div>
            <div class="p-8 basis-full sm:basis-1/2 md:basis-1/3">
              <div
                class="p-8 size-full rounded-none bg-white border border-gray-200 shadow-sm hover:border-primary-500/30 transition-all group hover:-translate-y-1"
              >
                <div
                  class="w-14 h-14 rounded-2xl bg-primary-500/10 flex items-center justify-center text-primary-500 mb-6 group-hover:scale-110 transition-transform"
                >
                  <iconify-icon icon="lucide:map-pin" class="text-3xl"></iconify-icon>
                </div>
                <h3 class="text-2xl font-medium text-gray-900 mb-4">
                  Accessibility
                </h3>
                <p class="text-gray-600 font-light leading-relaxed">
                  The institute is located at a very prime location which is
                  well connected for easy accessibility in the close proximity
                  to the Assam Secretariat.
                </p>
              </div>
            </div>
            <div class="p-8 basis-full sm:basis-1/2 md:basis-1/3">
              <div
                class="p-8 size-full rounded-none bg-white border border-gray-200 shadow-sm hover:border-primary-500/30 transition-all group hover:-translate-y-1"
              >
                <div
                  class="w-14 h-14 rounded-2xl bg-primary-500/10 flex items-center justify-center text-primary-500 mb-6 group-hover:scale-110 transition-transform"
                >
                  <iconify-icon icon="lucide:book-open" class="text-3xl"></iconify-icon>
                </div>
                <h3 class="text-2xl font-medium text-gray-900 mb-4">
                  Up-to-Date Study Material
                </h3>
                <p class="text-gray-600 font-light leading-relaxed">
                  We have a dedicate content development team to provide
                  relevant and up-to-date study material at Takshasheela, the
                  best IAS coaching institute in Guwahati.
                </p>
              </div>
            </div>
            <div class="p-8 basis-full sm:basis-1/2 md:basis-1/3">
              <div
                class="p-8 size-full rounded-none bg-white border border-gray-200 shadow-sm hover:border-primary-500/30 transition-all group hover:-translate-y-1 md:col-span-2 lg:col-span-1"
              >
                <div
                  class="w-14 h-14 rounded-2xl bg-primary-500/10 flex items-center justify-center text-primary-500 mb-6 group-hover:scale-110 transition-transform"
                >
                  <iconify-icon icon="lucide:library" class="text-3xl"></iconify-icon>
                </div>
                <h3 class="text-2xl font-medium text-gray-900 mb-4">
                  Advanced Library
                </h3>
                <p class="text-gray-600 font-light leading-relaxed">
                  We are the best APSC coaching institute in Guwahati aims to
                  bring out the latent talent of students by providing them a
                  strong platform for preparation of the civil services
                  examination.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FaqSection />
</Layout>
