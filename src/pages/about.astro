---
import Layout from "../layouts/Layout.astro";
import FaqSection from "@/components/FaqSection.astro";
import { Image } from "astro:assets";

const title = "About Us | Takshasheela School of Civil Services";
const description =
  "Learn more about Takshasheela School of Civil Services, the premier institution for UPSC and APSC preparation in Guwahati. Discover our mission, expert faculty, and state-of-the-art infrastructure.";

const sections = [
  {
    title: "Who Are We?",
    content:
      "We are not just a coaching institute. We are immensely grateful to the people of Assam and the Northeast for considering Takshasheela School of Civil Services the premier coaching center for APSC and UPSC preparation. Built on trust, proven results, and an unwavering commitment to aspirants’ success, we provide the ultimate guidance, mentorship, and resources to help you achieve your civil service dreams.",
    icon: "lucide:users-2",
  },
  {
    title: "Result-Oriented Courses",
    content:
      "Our courses are strategically engineered to deliver maximum results with minimum confusion. Available in both online and offline modes, students can prepare effectively from anywhere. With the right guidance, every class becomes a focused, disciplined, and motivating experience. Our experienced faculty ensures students stay confident, well-prepared, and strictly on track to achieve their goals.",
    icon: "lucide:target",
  },
  {
    title: "Simple & Accessible Learning",
    content:
      "Learning at Takshasheela is seamless and accessible. We provide high-quality study materials designed to break down complex topics easily. Our online resources, live classes, and offline classroom programs allow students to stay updated with daily current affairs, monthly compilations, and key exam content anytime, anywhere.",
    icon: "lucide:book-open",
  },
  {
    title: "Student-Friendly Environment",
    content:
      "We believe a supportive environment is key to effective preparation. Our state-of-the-art infrastructure, advanced library, smart classrooms, and prime location near the Assam Secretariat ensure that students can focus entirely on their studies without distractions.",
    icon: "lucide:building-2",
  },
  {
    title: "Preparing For India’s Toughest Exams",
    content:
      "Becoming a civil servant requires discipline, perseverance, and a passion to serve the nation. At Takshasheela, we provide expert UPSC coaching while also rigorously preparing students for APSC and ADRE, allowing aspirants to pursue their civil service dreams with national-level coaching right here in Assam.",
    icon: "lucide:award",
  },
  {
    title: "Proven Track Record Of Success",
    content:
      "Our results speak volumes. Through dedicated mentorship, robust study plans, and rigorous test series, our students consistently perform at the highest levels in state and national exams. With the right guidance and relentless preparation, success in India’s toughest exams is well within your reach.",
    icon: "lucide:trending-up",
  },
  {
    title: "Expert Mentors & Faculty",
    content:
      "Our faculty comprises top-tier experts and mentors from Delhi and across India, boasting 5 to 20 years of rich teaching experience. Their unparalleled expertise and personalized mentorship make Takshasheela the best APSC and UPSC coaching in Guwahati, trusted implicitly by aspirants across the state.",
    icon: "lucide:graduation-cap",
  },
  {
    title: "Your Partner In Success",
    content:
      "Whether you prefer online coaching or classroom programs, Takshasheela School of Civil Services is here to guide every step of your journey. With proven strategies, quality resources, and personalized mentorship, we ensure every student is equipped to succeed. Choose Takshasheela—and turn your civil service dream into reality.",
    icon: "lucide:handshake",
  },
];
---

<Layout title={title} description={description}>
  <section class="relative pb-16 md:pb-24 overflow-hidden">
    <div class="bg-primary-500/5 py-12 md:py-20 border-b border-gray-200">
      <div class="px-4 md:px-6 max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="flex-1">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-primary-500/10 text-primary-600 text-xs font-semibold tracking-wide uppercase mb-4">
            <iconify-icon icon="lucide:info" class="text-sm"></iconify-icon>
            Our Mission & Vision
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-gray-900 leading-tight">
            About <span class="text-primary-500 font-medium italic">Us</span>
          </h1>
          <p class="mt-4 text-lg text-gray-600 font-light max-w-xl leading-relaxed">
            Takshasheela School of Civil Services is a premier institution
            dedicated to educating, training, and guiding young aspirants for
            Civil Services in India.
          </p>
        </div>
        <div class="flex-1 w-full relative">
          <div class="aspect-video w-full rounded-2xl overflow-hidden shadow-2xl relative group">
            <Image
              src="/Takshasheela/students.webp"
              alt="Takshasheela School of Civil Services Students"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              width={800}
              height={500}
            />
            <div class="absolute inset-0 bg-primary-900/10 pointer-events-none mix-blend-multiply"></div>
          </div>
        </div>
      </div>
    </div>

    <div class="px-4 py-16 md:py-24 md:px-6 max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-16 lg:gap-x-20">
        {sections.map((section) => (
          <div class="flex flex-col gap-4 group">
            <div class="flex items-center gap-4 mb-2">
              <div class="w-12 h-12 rounded-2xl bg-gray-50 border border-gray-100 flex items-center justify-center text-primary-500 group-hover:bg-primary-500/10 group-hover:border-primary-500/20 group-hover:scale-110 transition-all duration-300 shadow-sm shrink-0">
                <iconify-icon icon={section.icon} class="text-2xl"></iconify-icon>
              </div>
              <h2 class="text-2xl md:text-3xl font-medium tracking-tight text-gray-900">
                {section.title}
              </h2>
            </div>
            <p class="text-base md:text-lg text-gray-600 font-light leading-relaxed pl-16">
              {section.content}
            </p>
          </div>
        ))}
      </div>

      <div class="mt-20 md:mt-32 p-8 md:p-12 rounded-3xl bg-linear-to-r from-primary-500/10 via-primary-500/5 to-transparent border border-primary-500/20 flex flex-col items-center text-center gap-6 max-w-4xl mx-auto">
        <h3 class="text-2xl md:text-4xl font-light text-gray-900 tracking-tight leading-tight">
          Ready to turn your <span class="text-primary-500 italic font-medium">civil service dream</span> into reality?
        </h3>
        <p class="text-gray-600 font-light text-lg">
          Join the premier institute in Guwahati and start your preparation with the best mentors.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 mt-4">
          <a
            href="/courses/"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-primary-500 text-white font-medium text-base hover:bg-primary-600 transition-colors shadow-lg hover:shadow-xl hover:-translate-y-0.5"
          >
            Explore Courses
          </a>
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-8 py-4 rounded-full bg-white text-gray-900 border border-gray-200 font-medium text-base hover:bg-gray-50 transition-colors shadow-sm hover:shadow-md hover:-translate-y-0.5"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <FaqSection />
</Layout>
