---
import Layout from '@/layouts/Layout.astro';
import BlogDirectory from '@/components/blog/BlogDirectory.vue';
import { getAllPosts } from '@/lib/blogger';

const posts = await getAllPosts();
---

<Layout
  title='Blog | Takshashila School of Civil Services'
  description='Insights, strategies, and updates from Takshashila School of Civil Services to help you crack the UPSC and APSC exams.'
>
  <div
    class='bg-primary-500/5 py-14 md:py-16 flex flex-col items-center justify-center text-center px-4 border-b border-gray-200'
  >
    <h1
      class='text-4xl md:text-5xl lg:text-6xl font-light tracking-tight text-gray-900 max-w-4xl mb-4 leading-tight'
    >
      Our <span class='text-primary-500 font-medium'>Blogs</span>
    </h1>
    <p class='text-gray-600 font-light text-base md:text-lg max-w-2xl leading-relaxed'>
      Insights, updates, and articles from Takshashila to fuel your UPSC, APSC, and civil services preparation.
    </p>
  </div>

  <div class='px-4 py-12 md:px-6 max-w-7xl mx-auto w-full'>
    {
      posts.length === 0 ? (
        <div class='text-center py-20 bg-gray-100/20 border border-dashed border-gray-200 rounded-3xl max-w-md mx-auto px-6'>
          <h3 class='text-xl font-medium mb-2'>No Articles Yet</h3>
          <p class='text-gray-600 font-light text-sm'>
            We are working on new content. Please check back soon.
          </p>
        </div>
      ) : (
        <BlogDirectory client:load posts={posts} />
      )
    }
  </div>
</Layout>

