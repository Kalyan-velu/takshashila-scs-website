---
import Layout from "@/layouts/Layout.astro";
import type { WPPost } from "@/types";
import { getBlogTOC, getLatestPosts, rewriteMediaUrls } from "@/lib/wordpress";
import { isServer } from "@/config/variables.ts";
import { SITE_URL } from "@/config/CONSTANTS.ts";
import { Image } from "astro:assets";
export async function getStaticPaths() {
  let allPosts: WPPost[] = [];
  let page = 1;

  try {
    const posts = await getLatestPosts(page, 100, {
      _fields: "slug,title,content,date,excerpt,yoast_head_json",
    });

    if (!posts || posts.length === 0) return;

    allPosts = [...allPosts, ...posts];
  } catch (error) {
    console.error("Error fetching WP posts:", error);
  }

  return allPosts.map((post) => ({
    params: { slug: (post as { slug: string }).slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const yoast = post.yoast_head_json;
const ogImage = yoast?.og_image?.[0];
const publishedDate = new Date(post.date).toLocaleDateString("en-IN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const content = rewriteMediaUrls(
  post.content.rendered,
  import.meta.env.PUBLIC_WORDPRESS_URL ?? "",
);
const headings = await getBlogTOC(content);
---

<Layout
  title={yoast?.title ?? post.title.rendered}
  description={yoast?.og_description}
  image={ogImage?.url}
  canonical={`${SITE_URL}/${post.slug}/`}
>
  <Fragment slot="head_data">
    <meta property="og:type" content="article" />
    {
      ogImage && (
        <meta property="og:image:width" content={String(ogImage.width)} />
      )
    }
    {
      ogImage && (
        <meta property="og:image:height" content={String(ogImage.height)} />
      )
    }
    <meta name="twitter:card" content={yoast?.twitter_card || "summary_large_image"} />
  </Fragment>

  <div class="w-full max-w-7xl mx-auto px-4 py-4">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-primary-500 transition-colors mb-8 group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="group-hover:-translate-x-1 transition-transform"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Back to Home
    </a>

    <header class="max-w-4xl mb-8">
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-light tracking-tight text-gray-900 mb-4 leading-tight font-sans"
        set:html={post.title.rendered}
      />
      <div class="flex items-center gap-4 text-sm text-gray-600 font-light">
        <time datetime={post.date} class="flex items-center gap-1.5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {publishedDate}
        </time>
        {
          yoast?.twitter_misc?.["Est. reading time"] && (
            <span class="flex items-center gap-1.5">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
              {yoast.twitter_misc["Est. reading time"]}
            </span>
          )
        }
      </div>
    </header>

    {
      ogImage?.url && (
        <div class="relative w-full aspect-video md:aspect-21/9 max-h-120 rounded-3xl overflow-hidden shadow-md mb-10 md:mb-12 border border-gray-200/60">
          <img
            src={ogImage.url}
            alt={post.title.rendered}
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent pointer-events-none" />
        </div>
      )
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-start">
      {
        headings.length > 0 && (
          <aside class="lg:hidden w-full bg-gray-100/40 border border-gray-200/80 rounded-2xl p-6 mb-2">
            <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary-500"
              >
                <line x1="4" y1="9" x2="20" y2="9" />
                <line x1="4" y1="15" x2="20" y2="15" />
                <line x1="10" y1="3" x2="8" y2="21" />
                <line x1="16" y1="3" x2="14" y2="21" />
              </svg>
              Table of Contents
            </h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {headings.map((heading) => (
                <li>
                  <a
                    href={heading.id}
                    class="text-sm text-gray-600 hover:text-primary-500 transition-colors flex items-start gap-1"
                  >
                    <span class="text-primary-500/70 mt-1">•</span>
                    <span
                      class="underline underline-offset-4 decoration-transparent hover:decoration-primary/40 transition-colors"
                      set:html={heading.text}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <main class="lg:col-span-9 w-full min-w-0">
        <div class="post__content" set:html={content} />
      </main>

      {
        headings.length > 0 && (
          <aside class="hidden lg:block lg:col-span-3 sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pl-4 border-l border-gray-200/80">
            <h3 class="text-sm font-semibold tracking-wider text-gray-600 uppercase mb-4">
              Table of Contents
            </h3>
            <ul class="space-y-3">
              {headings.map((heading) => (
                <li>
                  <a
                    href={heading.id}
                    class="text-sm text-gray-600 hover:text-primary-500 transition-colors flex items-start gap-1.5 group"
                  >
                    <span class="text-primary-500/40 group-hover:text-primary-500 mt-1">
                      •
                    </span>
                    <span
                      class="underline underline-offset-4 decoration-transparent hover:decoration-primary/40 transition-colors"
                      set:html={heading.text}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>
  </div>
</Layout>

<style is:inline>
  /* ─── Wrapper ─────────────────────────────────────────── */
  .post__content {
    font-family: var(--font-sans, sans-serif), serif;
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--foreground);
    max-width: 72ch;
  }

  /* ─── Paragraphs ──────────────────────────────────────── */
  .post__content p {
    margin-bottom: 1.5rem;
    color: var(--foreground);
    opacity: 0.9;
  }

  /* ─── Headings ────────────────────────────────────────── */
  .post__content h1,
  .post__content h2,
  .post__content h3,
  .post__content h4,
  .post__content h5,
  .post__content h6 {
    font-family: var(--font-sans, sans-serif), serif;
    font-weight: 700;
    line-height: 1.3;
    color: var(--foreground);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 100px; /* for anchor links like #h-1-transforming... */
  }

  .post__content h2 {
    font-size: 1.6rem;
  }
  .post__content h3 {
    font-size: 1.35rem;
  }
  .post__content h4 {
    font-size: 1.15rem;
  }

  /* ─── Lists ───────────────────────────────────────────── */
  .post__content ul,
  .post__content ol {
    padding-left: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .post__content ul {
    list-style: none;
    padding-left: 0;
  }

  /* Custom bullet — matches site palette */
  .post__content ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.6rem;
    color: var(--foreground);
    opacity: 0.9;
  }

  .post__content ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--primary);
  }

  .post__content ol {
    list-style: decimal;
  }

  .post__content ol li {
    margin-bottom: 0.6rem;
    color: var(--foreground);
    opacity: 0.9;
  }

  /* wp-block-list is the class WP adds to its lists */
  .post__content .wp-block-list {
    padding-left: 0;
    list-style: none;
  }

  /* ─── Horizontal Rule ─────────────────────────────────── */
  .post__content hr,
  .post__content .wp-block-separator {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  /* ─── Images ──────────────────────────────────────────── */
  .post__content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: 1.5rem 0;
    display: block;
  }

  .post__content figure {
    margin: 2rem 0;
  }

  .post__content figcaption {
    font-size: 0.85rem;
    color: var(--muted-foreground);
    text-align: center;
    margin-top: 0.5rem;
  }

  /* ─── Blockquotes ─────────────────────────────────────── */
  .post__content blockquote {
    border-left: 4px solid var(--primary);
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    background-color: var(--muted);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--foreground);
    opacity: 0.9;
  }

  .post__content blockquote p {
    margin-bottom: 0;
  }

  /* ─── Inline Code & Pre ───────────────────────────────── */
  .post__content code {
    background: var(--muted);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      "Courier New", monospace;
  }

  .post__content pre {
    background: var(--foreground);
    color: var(--background);
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .post__content pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  /* ─── Links ───────────────────────────────────────────── */
  .post__content a {
    color: var(--primary);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .post__content a:hover {
    opacity: 0.8;
  }

  /* ─── Tables ──────────────────────────────────────────── */
  .post__content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  .post__content th {
    background-color: var(--primary);
    color: var(--primary-foreground);
    padding: 0.75rem 1rem;
    text-align: left;
    font-family: var(--font-sans, sans-serif), serif;
  }

  .post__content td {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--foreground);
    opacity: 0.9;
  }

  .post__content tr:nth-child(even) td {
    background-color: var(--muted);
  }

  /* ─── Mobile Overrides ────────────────────────────────── */
  @media (max-width: 640px) {
    .post__content {
      font-size: 1rem;
    }

    .post__content h2 {
      font-size: 1.3rem;
    }
    .post__content h3 {
      font-size: 1.15rem;
    }
  }
</style>
