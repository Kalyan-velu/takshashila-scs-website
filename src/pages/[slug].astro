---
import Layout from "@/layouts/Layout.astro";
import CommentItem from "@/components/blog/CommentItem.astro";
import type { BlogComment } from "@/lib/blogger";
import { getAllPosts, getBlogTOC, getComments } from "@/lib/blogger";
import { SITE_URL } from "@/config/CONSTANTS.ts";

export async function getStaticPaths() {
  const posts = await getAllPosts();

  const seenSlugs = new Set<string>();
  for (const post of posts) {
    if (seenSlugs.has(post.slug)) {
      console.warn(
        `Duplicate blog slug "${post.slug}" — only one post will be reachable at /${post.slug}/`,
      );
    }
    seenSlugs.add(post.slug);
  }

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const publishedDate = new Date(post.publishedAt).toLocaleDateString("en-IN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const headings = getBlogTOC(post.content);
const comments = await getComments(post);

function countComments(list: BlogComment[]): number {
  return list.reduce(
    (sum, comment) => sum + 1 + countComments(comment.replies),
    0,
  );
}
const totalComments = countComments(comments);

const postUrl = `${SITE_URL}/${post.slug}/`;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.title,
  description: post.excerpt,
  image: post.imageUrl ?? undefined,
  datePublished: post.publishedAt,
  dateModified: post.updatedAt,
  author: {
    "@type": "Person",
    name: post.author.name,
  },
  publisher: {
    "@type": "Organization",
    name: "Takshasheela School of Civil Services",
    logo: {
      "@type": "ImageObject",
      url: `${SITE_URL}/logo-full-black.png`,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": postUrl,
  },
};
---

<Layout
  title={`${post.title}`}
  description={post.excerpt}
  image={post.imageUrl ?? undefined}
  canonical={postUrl}
  keywords={post.keywords}
>
  <Fragment slot="head_data">
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={post.publishedAt} />
    <meta property="article:modified_time" content={post.updatedAt} />
    <meta property="article:author" content={post.author.name} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <div class="w-full max-w-7xl mx-auto px-4 py-4">
    <a
      href="/"
      class="inline-flex items-center gap-2 text-sm font-medium text-gray-600 hover:text-primary-500 transition-colors mb-8 group"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="group-hover:-translate-x-1 transition-transform"
      >
        <line x1="19" y1="12" x2="5" y2="12"></line>
        <polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      Back to Home
    </a>

    <header class="max-w-4xl mb-8">
      <h1
        class="text-3xl md:text-4xl lg:text-5xl font-medium tracking-tight text-gray-900 mb-4 leading-tight font-sans"
      >
        {post.title}
      </h1>
      <div class="flex items-center gap-2 mb-3">
        {
          post.author.avatarUrl ? (
            <img
              src={post.author.avatarUrl}
              alt=""
              width="28"
              height="28"
              class="w-7 h-7 rounded-full object-cover border border-gray-200"
              loading="lazy"
            />
          ) : (
            <div class="w-7 h-7 rounded-full bg-primary-500/10 text-primary-500 flex items-center justify-center text-xs font-semibold border border-gray-200">
              {post.author.name.charAt(0).toUpperCase()}
            </div>
          )
        }
        <span class="text-sm font-medium text-gray-900">{post.author.name}</span
        >
      </div>
      <div class="flex items-center gap-4 text-sm text-gray-600 font-light">
        <time datetime={post.publishedAt} class="flex items-center gap-1.5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          {publishedDate}
        </time>
        <span class="flex items-center gap-1.5">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {post.readingTimeMinutes} min read
        </span>
      </div>
    </header>

    {
      post.imageUrl && (
        <div class="relative w-full aspect-video md:aspect-21/9 max-h-120 rounded-3xl overflow-hidden shadow-md mb-10 md:mb-12 border border-gray-200/60">
          <img
            src={post.imageUrl}
            alt={post.title}
            class="w-full h-full object-cover object-center"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-black/20 to-transparent pointer-events-none" />
        </div>
      )
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-12 items-start">
      {
        headings.length > 0 && (
          <aside class="lg:hidden w-full bg-gray-100/40 border border-gray-200/80 rounded-2xl p-6 mb-2">
            <h3 class="text-lg font-medium text-gray-900 mb-4 flex items-center gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="text-primary-500"
              >
                <line x1="4" y1="9" x2="20" y2="9" />
                <line x1="4" y1="15" x2="20" y2="15" />
                <line x1="10" y1="3" x2="8" y2="21" />
                <line x1="16" y1="3" x2="14" y2="21" />
              </svg>
              Table of Contents
            </h3>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {headings.map((heading) => (
                <li>
                  <a
                    href={heading.id}
                    class="text-sm text-gray-600 hover:text-primary-500 transition-colors flex items-start gap-1"
                  >
                    <span class="text-primary-500/70 mt-1">•</span>
                    <span
                      class="underline underline-offset-4 decoration-transparent hover:decoration-primary-500/40 transition-colors"
                      set:html={heading.text}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }

      <main class="lg:col-span-9 w-full min-w-0">
        <div class="post__content" set:html={post.content} />
      </main>

      {
        headings.length > 0 && (
          <aside class="hidden lg:block lg:col-span-3 sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto pl-4 border-l border-gray-200/80">
            <h3 class="text-sm font-semibold tracking-wider text-gray-600 uppercase mb-4">
              Table of Contents
            </h3>
            <ul class="space-y-3">
              {headings.map((heading) => (
                <li>
                  <a
                    href={heading.id}
                    class="text-sm text-gray-600 hover:text-primary-500 transition-colors flex items-start gap-1.5 group"
                  >
                    <span class="text-primary-500/40 group-hover:text-primary-500 mt-1">
                      •
                    </span>
                    <span
                      class="underline underline-offset-4 decoration-transparent hover:decoration-primary-500/40 transition-colors"
                      set:html={heading.text}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        )
      }
    </div>

    <section class="max-w-4xl mt-16 pt-10 border-t border-gray-200">
      <h2
        class="text-2xl font-medium tracking-tight text-gray-900 mb-8 flex items-center gap-2"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-primary-500"
        >
          <path
            d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
          ></path>
        </svg>
        Comments ({totalComments})
      </h2>

      {
        comments.length === 0 ? (
          <div class="text-center py-10 bg-gray-100/30 border border-dashed border-gray-200 rounded-2xl">
            <p class="text-gray-600 text-sm">
              No comments yet.{" "}
              <a
                href={`${post.bloggerLink}#comment-form`}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-500 font-medium hover:underline"
              >
                Be the first to comment
              </a>
              .
            </p>
          </div>
        ) : (
          <div class="space-y-6">
            {comments.map((comment) => (
              <CommentItem comment={comment} />
            ))}
          </div>
        )
      }
    </section>
  </div>
</Layout>

<style is:inline>
  @reference "../styles/globals.css";
  /* ─── Wrapper ─────────────────────────────────────────── */
  .post__content {
    font-family:
      var(--font-sans),
      system-ui,
      -apple-system,
      sans-serif;
    font-size: 1.05rem !important;
    line-height: 1.85;
    color: var(--color-gray-800, #1f2937);
    max-width: 72ch;
  }

  /* ─── Paragraphs ──────────────────────────────────────── */
  .post__content p {
    margin-bottom: 1.5rem;
    color: var(--color-gray-800, #1f2937);
    opacity: 0.9;
  }

  /* ─── Headings ────────────────────────────────────────── */
  .post__content h1,
  .post__content h2,
  .post__content h3,
  .post__content h4,
  .post__content h5,
  .post__content h6 {
    font-family:
      var(--font-sans),
      system-ui,
      -apple-system,
      sans-serif;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 100px; /* for anchor links like #h-1-transforming... */
  }

  .post__content h2 {
    font-size: 1.6rem;
  }
  .post__content h3 {
    font-size: 1.35rem;
  }
  .post__content h4 {
    font-size: 1.15rem;
  }

  /* ─── Lists ───────────────────────────────────────────── */
  .post__content ul,
  .post__content ol {
    padding-left: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .post__content ul {
    list-style: none;
    padding-left: 0;
  }

  /* Custom bullet — matches site palette */
  .post__content ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.6rem;
    color: var(--color-neutral-800);
    opacity: 0.9;
  }

  .post__content ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    background-color: var(--color-primary-500);
  }

  .post__content ol {
    list-style: decimal;
  }

  .post__content ol li {
    margin-bottom: 0.6rem;
    color: var(--color-neutral-800);
    opacity: 0.9;
  }

  /* wp-block-list is the class WP adds to its lists */
  .post__content .wp-block-list {
    padding-left: 0;
    list-style: none;
  }

  /* ─── Horizontal Rule ─────────────────────────────────── */
  .post__content hr,
  .post__content .wp-block-separator {
    border: none;
    border-top: 1px solid var(--color-gray-500);
    margin: 2.5rem 0;
  }

  /* ─── Images ──────────────────────────────────────────── */
  .post__content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    margin: 1.5rem 0;
    display: block;
  }

  .post__content figure {
    margin: 2rem 0;
  }

  .post__content figcaption {
    font-size: 0.85rem;
    color: var(--muted-foreground);
    text-align: center;
    margin-top: 0.5rem;
  }

  /* ─── Blockquotes ─────────────────────────────────────── */
  .post__content blockquote {
    border-left: 4px solid var(--color-primary-500);
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    background-color: var(--muted);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: var(--color-neutral-800);
    opacity: 0.9;
  }

  .post__content blockquote p {
    margin-bottom: 0;
  }

  /* ─── Inline Code & Pre ───────────────────────────────── */
  .post__content code {
    background: var(--muted);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.9em;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      "Courier New", monospace;
  }

  .post__content pre {
    background: var(--color-neutral-800);
    color: var(--color-neutral-100);
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .post__content pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  /* ─── Links ───────────────────────────────────────────── */
  .post__content a {
    color: var(--color-primary-500);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .post__content a:hover {
    opacity: 0.8;
  }

  /* ─── Tables ──────────────────────────────────────────── */
  .post__content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  .post__content th {
    background-color: var(--color-primary-500);
    color: var(--primary-foreground, #ffffff);
    padding: 0.75rem 1rem;
    text-align: left;
    font-family:
      var(--font-sans),
      system-ui,
      -apple-system,
      sans-serif;
  }

  .post__content td {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--foreground);
    opacity: 0.9;
  }

  .post__content tr:nth-child(even) td {
    background-color: var(--muted);
  }

  /* ─── Mobile Overrides ────────────────────────────────── */
  @media (max-width: 640px) {
    .post__content {
      font-size: 1rem;
    }

    .post__content h2 {
      font-size: 1.3rem;
    }
    .post__content h3 {
      font-size: 1.15rem;
    }
  }
</style>
