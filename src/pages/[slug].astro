---
import Layout from "@/layouts/Layout.astro";
import type { WPPost } from "@/types";
import { getLatestPosts, rewriteMediaUrls } from "@/lib/wordpress";

export async function getStaticPaths() {
  let allPosts: WPPost[] = [];
  let page = 1;

  // while (true) {
  try {
    console.log("Fetching WP posts");
    const posts = await getLatestPosts(page, 100, {
      _fields: "slug,title,content,date,excerpt,yoast_head_json",
    });

    if (!posts || posts.length === 0) return;

    allPosts = [...allPosts, ...posts];
  } catch (error) {
    console.error("Error fetching WP posts:", error);
    // break;
  }
  // }

  return allPosts.map((post) => ({
    params: { slug: (post as { slug: string }).slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const yoast = post.yoast_head_json;
const ogImage = yoast?.og_image?.[0];
const publishedDate = new Date(post.date).toLocaleDateString("en-IN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const content = rewriteMediaUrls(
  post.content.rendered,
  import.meta.env.PUBLIC_WORDPRESS_URL ?? "",
);
---

<Layout>
  <!-- SEO Meta Tags from Yoast -->
  <Fragment slot="head">
    <title>{yoast?.title ?? post.title.rendered}</title>
    <meta name="description" content={yoast?.og_description} />
    <link rel="canonical" href={`https://takshashilascs.com/${post.slug}/`} />

    <!-- Open Graph -->
    <meta property="og:title" content={yoast?.og_title} />
    <meta property="og:description" content={yoast?.og_description} />
    <meta property="og:type" content="article" />
    <meta
      property="og:url"
      content={`https://takshashilascs.com/${post.slug}/`}
    />
    {ogImage && <meta property="og:image" content={ogImage.url} />}
    {
      ogImage && (
        <meta property="og:image:width" content={String(ogImage.width)} />
      )
    }
    {
      ogImage && (
        <meta property="og:image:height" content={String(ogImage.height)} />
      )
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content={yoast?.twitter_card} />
    <meta name="twitter:title" content={yoast?.og_title} />
    <meta name="twitter:description" content={yoast?.og_description} />
    {ogImage && <meta name="twitter:image" content={ogImage.url} />}
  </Fragment>

  <!-- Post Layout -->
  <article class="post">
    {
      ogImage && (
        <img
          src={ogImage.url}
          width={ogImage.width}
          height={ogImage.height}
          alt={post.title.rendered}
          class="post__hero"
        />
      )
    }

    <header class="post__header">
      <h1 set:html={post.title.rendered} />
      <time datetime={post.date}>{publishedDate}</time>
    </header>

    <!-- This is the key directive — renders WP HTML safely -->
    <div class="post__content" set:html={content} />
  </article>
</Layout>
<style is:inline>
  /* styles/wp-content.css */

  /* ─── Wrapper ─────────────────────────────────────────── */
  .post__content {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 1.125rem;
    line-height: 1.85;
    color: var(--color-foreground, #000);
    max-width: 72ch;
    margin: 0 auto;
  }

  /* ─── Paragraphs ──────────────────────────────────────── */
  .post__content p {
    margin-bottom: 1.5rem;
    color: var(--color-foreground, #000);
    opacity: 0.9;
  }

  /* ─── Headings ────────────────────────────────────────── */
  .post__content h1,
  .post__content h2,
  .post__content h3,
  .post__content h4,
  .post__content h5,
  .post__content h6 {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-foreground, #000);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    scroll-margin-top: 80px; /* for anchor links like #h-1-transforming... */
  }

  .post__content h2 {
    font-size: 1.6rem;
  }
  .post__content h3 {
    font-size: 1.35rem;
  }
  .post__content h4 {
    font-size: 1.15rem;
  }

  /* ─── Lists ───────────────────────────────────────────── */
  .post__content ul,
  .post__content ol {
    padding-left: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .post__content ul {
    list-style: none;
    padding-left: 0;
  }

  /* Custom bullet — matches site palette */
  .post__content ul li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.6rem;
    color: var(--color-foreground, #000);
    opacity: 0.9;
  }

  .post__content ul li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-primary, #b8860b);
  }

  .post__content ol {
    list-style: decimal;
  }

  .post__content ol li {
    margin-bottom: 0.6rem;
    color: var(--color-foreground, #000);
    opacity: 0.9;
  }

  /* wp-block-list is the class WP adds to its lists */
  .post__content .wp-block-list {
    padding-left: 0;
    list-style: none;
  }

  /* ─── Horizontal Rule ─────────────────────────────────── */
  /* WP outputs: <hr class="wp-block-separator has-alpha-channel-opacity"/> */
  .post__content hr,
  .post__content .wp-block-separator {
    border: none;
    border-top: 1px solid var(--color-border, #e5e5e5);
    margin: 2.5rem 0;
  }

  /* ─── Images ──────────────────────────────────────────── */
  .post__content img {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 8px);
    margin: 1.5rem 0;
    display: block;
  }

  .post__content figure {
    margin: 2rem 0;
  }

  .post__content figcaption {
    font-size: 0.85rem;
    color: var(--color-muted-foreground, #777);
    text-align: center;
    margin-top: 0.5rem;
  }

  /* ─── Blockquotes ─────────────────────────────────────── */
  .post__content blockquote {
    border-left: 4px solid var(--color-primary, #b8860b);
    margin: 2rem 0;
    padding: 1rem 1.5rem;
    background-color: var(--color-muted, #f3f4f6);
    border-radius: 0 var(--radius-md, 6px) var(--radius-md, 6px) 0;
    font-style: italic;
    color: var(--color-foreground, #444);
    opacity: 0.9;
  }

  .post__content blockquote p {
    margin-bottom: 0;
  }

  /* ─── Inline Code & Pre ───────────────────────────────── */
  .post__content code {
    background: var(--color-muted, #f4f4f4);
    padding: 0.15em 0.4em;
    border-radius: var(--radius-sm, 4px);
    font-size: 0.9em;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono",
      "Courier New", monospace;
  }

  .post__content pre {
    background: var(--color-foreground, #1e1e1e);
    color: var(--color-background, #d4d4d4);
    padding: 1.25rem;
    border-radius: var(--radius-lg, 8px);
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.9rem;
  }

  .post__content pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  /* ─── Links ───────────────────────────────────────────── */
  .post__content a {
    color: var(--color-primary, #b8860b);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .post__content a:hover {
    opacity: 0.8;
  }

  /* ─── Tables ──────────────────────────────────────────── */
  .post__content table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  .post__content th {
    background-color: var(--color-primary, #b8860b);
    color: var(--color-primary-foreground, #fff);
    padding: 0.75rem 1rem;
    text-align: left;
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
  }

  .post__content td {
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--color-border, #e8e8e8);
    color: var(--color-foreground, #2d2d2d);
    opacity: 0.9;
  }

  .post__content tr:nth-child(even) td {
    background-color: var(--color-muted, #fdf8ee);
  }

  /* ─── WP Gutenberg Block Wrappers ─────────────────────── */
  .post__content .wp-block-heading {
    /* already covered by h1-h6 above */
  }

  .post__content .wp-block-image {
    margin: 2rem 0;
  }

  .post__content .wp-block-quote {
    /* covered by blockquote above */
  }

  /* ─── Post Header (outside .post__content) ────────────── */
  .post__header {
    max-width: 72ch;
    margin: 0 auto 2.5rem;
  }

  .post__header h1 {
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-foreground, #111);
    margin-bottom: 0.75rem;
  }

  .post__header time {
    font-size: 0.9rem;
    color: var(--color-muted-foreground, #888);
    font-family: var(--font-sans, system-ui, -apple-system, sans-serif);
  }

  /* ─── Hero Image ──────────────────────────────────────── */
  .post__hero {
    width: 100%;
    max-height: 420px;
    object-fit: cover;
    border-radius: var(--radius-lg, 12px);
    margin-bottom: 2.5rem;
  }

  /* ─── Mobile ──────────────────────────────────────────── */
  @media (max-width: 640px) {
    .post__content {
      font-size: 1rem;
    }

    .post__header h1 {
      font-size: 1.65rem;
    }

    .post__content h2 {
      font-size: 1.3rem;
    }
    .post__content h3 {
      font-size: 1.15rem;
    }
  }
</style>
