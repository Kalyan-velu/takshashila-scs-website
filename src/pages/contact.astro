---
import Layout from "../layouts/Layout.astro";
// import { Phone, Mail, MapPin, Send } from "lucide-react";
import variables from "@/config/variables.ts";
import { EMAIL, PHONE_DISPLAY, PHONE_HREF } from "@/config/CONSTANTS.ts";
const cloudflare_site_key = variables.CLOUDFLARE_SITE_KEY;
const title = "Contact Us | Takshasheela School of Civil Services";
const description =
  "At Takshasheela School of Civil     Services, the best coaching institute for UPSC and APSC in Guwahati, we value open communication and are committed to supporting you every step of the way.";
---

<Layout title={title} description={description}>
  <section class="relative pt-24 pb-16 md:pb-24 overflow-hidden min-h-screen">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 pointer-events-none"
    >
      <div
        class="absolute top-[-10%] left-[-10%] w-125 h-125 rounded-full bg-primary-500/10 blur-[140px] animate-pulse duration-10000"
      >
      </div>
      <div
        class="absolute bottom-[20%] right-[-5%] w-150 h-150 rounded-full bg-primary-500/5 blur-[150px]"
      >
      </div>
      <div
        class="absolute top-[40%] left-[20%] w-75 h-75 rounded-full bg-secondary/10 blur-[120px]"
      >
      </div>
    </div>

    <div class="px-4 md:px-6 max-w-7xl mx-auto relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div class="flex flex-col gap-10">
          <div class="space-y-6">
            <h1
              class="text-5xl md:text-6xl lg:text-7xl font-light tracking-tight text-gray-900 leading-[1.1]"
            >
              Contact <span class="text-primary-500 italic font-serif">Us</span>
            </h1>
            <div
              class="space-y-5 text-lg text-gray-600 font-light leading-relaxed"
            >
              <p>
                At Takshasheela School of Civil Services, the best coaching
                institute for UPSC in Guwahati, we value open communication and
                are committed to supporting you every step of the way as you
                work toward achieving your dream of becoming a civil servant.
              </p>
              <p>
                If you have any queries, questions, or require assistance, feel
                free to contact us—we’re here to help.
              </p>
            </div>
          </div>

          <div class="space-y-10">
            <div
              class="space-y-4 text-gray-600 font-light leading-relaxed text-lg"
            >
              <p>
                Preparing for competitive exams like UPSC and APSC can be a
                challenging and demanding journey. That’s why we have a
                dedicated team ready to provide the guidance and support you
                need. Whether you’re seeking information about our courses,
                faculty, admissions, or facilities, we’re happy to provide you
                with detailed and accurate answers.
              </p>
            </div>

            <div class="space-y-5">
              <h2
                class="text-3xl md:text-4xl font-light text-gray-900 tracking-tight"
              >
                How We Support You
              </h2>
              <div
                class="space-y-4 text-gray-600 font-light leading-relaxed text-lg"
              >
                <p>
                  At Takshasheela, the best APSC coaching centre in Guwahati,
                  our goal is to ensure every aspirant has access to the
                  resources and mentorship required to succeed. We provide
                  personalized advice tailored to your unique needs, helping you
                  navigate your preparation journey effectively.
                </p>
              </div>
            </div>

            <div class="space-y-6">
              <h2
                class="text-3xl md:text-4xl font-light text-gray-900 tracking-tight"
              >
                Why Contact Us?
              </h2>
              <ul class="space-y-4">
                {
                  [
                    "Discover more about our innovative approach to UPSC and APSC preparation.",
                    "Get expert advice on selecting the right program for your career aspirations.",
                    "Learn about eligibility criteria, class schedules, and faculty support.",
                    "Explore additional services and resources designed to enhance your preparation.",
                  ].map((item) => (
                    <li class="flex items-start gap-4 text-gray-600 font-light text-lg group">
                      <span class="mt-2.5 w-2 h-2 rounded-full bg-primary-500/70 shrink-0 transition-all duration-300 group-hover:scale-150 group-hover:bg-primary-500 shadow-[0_0_10px_rgba(var(--primary),0.5)]" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div
              class="relative p-8 rounded-3xl bg-white/60 backdrop-blur-xl border border-gray-200/50 shadow-xl overflow-hidden group hover:border-primary-500/30 transition-colors duration-500"
            >
              <div
                class="absolute inset-0 bg-linear-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              >
              </div>
              <div class="relative z-10">
                <p class="text-gray-600 font-light leading-relaxed text-lg">
                  Your success is important to us, and we are dedicated to
                  helping you make your vision a reality. Explore <a
                    href="/courses/"
                    class="text-primary-500 hover:text-primary-500/80 font-medium hover:underline underline-offset-4 transition-colors"
                    >Our UPSC & APSC Preparation Courses</a
                  > today and take the first step toward a bright future in public
                  service.
                </p>
                <p class="mt-4 text-gray-900 font-medium text-lg">
                  Reach out to Takshasheela School of Civil Services, the best
                  coaching institute for IAS in Guwahati.
                </p>
              </div>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-6 mt-4">
            <div
              class="relative p-8 rounded-4xl bg-white/50 backdrop-blur-md border border-gray-200/50 shadow-lg flex flex-col items-start gap-6 hover:shadow-xl hover:border-primary-500/40 transition-all duration-500 group overflow-hidden"
            >
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-primary-500/5 rounded-full -mr-16 -mt-16 blur-2xl transition-transform duration-500 group-hover:scale-150 group-hover:bg-primary-500/10"
              >
              </div>
              <div
                class="w-14 h-14 rounded-2xl bg-primary-500/10 flex items-center justify-center text-primary-500 shrink-0 transition-transform duration-500 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_rgba(var(--primary),0.5)] relative z-10"
              >
                <!--<Phone className="w-6 h-6" />-->
              </div>
              <div class="space-y-2 relative z-10 w-full">
                <p
                  class="text-xs font-medium uppercase tracking-widest text-gray-600"
                >
                  Give Us A Call
                </p>
                <a
                  href={PHONE_HREF}
                  class="block text-xl font-medium text-gray-900 hover:text-primary-500 transition-colors truncate"
                  >{PHONE_DISPLAY}</a
                >
              </div>
            </div>

            <div
              class="relative p-8 rounded-[2rem] bg-white/50 backdrop-blur-md border border-gray-200/50 shadow-lg flex flex-col items-start gap-6 hover:shadow-xl hover:border-primary-500/40 transition-all duration-500 group overflow-hidden"
            >
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-primary-500/5 rounded-full -mr-16 -mt-16 blur-2xl transition-transform duration-500 group-hover:scale-150 group-hover:bg-primary-500/10"
              >
              </div>
              <div
                class="w-14 h-14 rounded-2xl bg-primary-500/10 flex items-center justify-center text-primary-500 shrink-0 transition-transform duration-500 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_rgba(var(--primary),0.5)] relative z-10"
              >
                <!--<Mail className="w-6 h-6" />-->
              </div>
              <div class="space-y-2 relative z-10 w-full">
                <p
                  class="text-xs font-medium uppercase tracking-widest text-gray-600"
                >
                  Send An Email
                </p>
                <a
                  href={`mailto:${EMAIL}`}
                  class="block text-xl font-medium text-gray-900 hover:text-primary-500 transition-colors truncate"
                  >{EMAIL}</a
                >
              </div>
            </div>

            <div
              class="relative sm:col-span-2 p-8 rounded-[2rem] bg-white/50 backdrop-blur-md border border-gray-200/50 shadow-lg flex flex-col sm:flex-row items-start sm:items-center gap-6 hover:shadow-xl hover:border-primary-500/40 transition-all duration-500 group overflow-hidden"
            >
              <div
                class="absolute top-0 right-0 w-48 h-48 bg-primary-500/5 rounded-full -mr-24 -mt-24 blur-3xl transition-transform duration-500 group-hover:scale-150 group-hover:bg-primary-500/10"
              >
              </div>
              <div
                class="w-14 h-14 rounded-2xl bg-primary-500/10 flex items-center justify-center text-primary-500 shrink-0 transition-transform duration-500 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_rgba(var(--primary),0.5)] relative z-10"
              >
                <!--<MapPin className="w-6 h-6" />-->
              </div>
              <div class="space-y-2 relative z-10">
                <p
                  class="text-xs font-medium uppercase tracking-widest text-gray-600"
                >
                  Visit Our Office
                </p>
                <p class="text-xl font-medium text-gray-900">
                  Guwahati, Assam, India
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:sticky lg:top-8 mt-8 lg:mt-0">
          <div
            class="bg-white/40 backdrop-blur-2xl border border-white/10 dark:border-white/5 p-8 sm:p-12 rounded-[2.5rem] shadow-2xl relative overflow-hidden group"
          >
            {/* Form Inner Glow Effect */}
            <div
              class="absolute top-0 right-0 w-100 h-100 bg-primary-500/10 rounded-full -mr-48 -mt-48 blur-[80px] transition-opacity duration-700 opacity-50 group-hover:opacity-100 pointer-events-none"
            >
            </div>
            <div
              class="absolute bottom-0 left-0 w-75 h-75 bg-secondary/10 rounded-full -ml-32 -mb-32 blur-[60px] transition-opacity duration-700 opacity-30 group-hover:opacity-80 pointer-events-none"
            >
            </div>

            <div class="relative z-10 space-y-10">
              <div class="space-y-3">
                <h3 class="text-4xl font-light tracking-tight text-gray-900">
                  Send a <span class="text-primary-500 italic font-serif"
                    >Message</span
                  >
                </h3>
                <p class="text-gray-600 font-light text-lg">
                  Fill out the form below and we'll get back to you shortly.
                </p>
              </div>

              <form id="contact-form" class="space-y-7">
                <div class="space-y-5">
                  <label class="text-sm font-medium text-gray-900 tracking-wide"
                    >Name <span class="text-primary-500">*</span></label
                  >
                  <div class="grid sm:grid-cols-2 gap-5">
                    <div class="space-y-2">
                      <label>
                        <input
                          type="text"
                          name="firstName"
                          required
                          class="w-full px-5 py-4 border border-gray-200/50 rounded-2xl bg-white/50 backdrop-blur-md text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500/50 transition-all placeholder:text-gray-600/40 shadow-inner"
                          placeholder="First Name"
                        />
                      </label>
                      <span
                        class="text-[10px] text-gray-600 uppercase tracking-widest px-2"
                        >First</span
                      >
                    </div>
                    <div class="space-y-2">
                      <label>
                        <input
                          type="text"
                          name="lastName"
                          required
                          class="w-full px-5 py-4 border border-gray-200/50 rounded-2xl bg-white/50 backdrop-blur-md text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500/50 transition-all placeholder:text-gray-600/40 shadow-inner"
                          placeholder="Last Name"
                        />
                      </label>
                      <span
                        class="text-[10px] text-gray-600 uppercase tracking-widest px-2"
                        >Last</span
                      >
                    </div>
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-6">
                  <div class="space-y-3">
                    <label
                      class="text-sm font-medium text-gray-900 tracking-wide"
                      >Phone <span class="text-primary-500">*</span>
                      <input
                        type="tel"
                        name="phone"
                        required
                        class="w-full px-5 py-4 border border-gray-200/50 rounded-2xl bg-white/50 backdrop-blur-md text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500/50 transition-all placeholder:text-gray-600/40 shadow-inner"
                        placeholder="+91-00000-00000"
                      /></label
                    >
                    <p
                      id="phone-error"
                      class="hidden text-sm text-destructive px-2"
                    >
                    </p>
                  </div>
                  <div class="space-y-3">
                    <label
                      class="text-sm font-medium text-gray-900 tracking-wide"
                      >Email <span class="text-primary-500">*</span>
                      <input
                        type="email"
                        name="email"
                        required
                        class="w-full px-5 py-4 border border-gray-200/50 rounded-2xl bg-white/50 backdrop-blur-md text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500/50 transition-all placeholder:text-gray-600/40 shadow-inner"
                        placeholder="example@mail.com"
                      />
                    </label>
                    <p
                      id="email-error"
                      class="hidden text-sm text-destructive px-2"
                    >
                    </p>
                  </div>
                </div>

                <div class="space-y-3">
                  <label class="text-sm font-medium text-gray-900 tracking-wide"
                    >Address
                    <textarea
                      rows="3"
                      name="address"
                      class="w-full px-5 py-4 border border-gray-200/50 rounded-2xl bg-white/50 backdrop-blur-md text-gray-900 focus:outline-none focus:ring-2 focus:ring-primary-500/30 focus:border-primary-500/50 transition-all placeholder:text-gray-600/40 resize-none shadow-inner"
                      placeholder="Your full address"></textarea>
                  </label>
                </div>

                <!-- Turnstile widget -->
                <div
                  class="cf-turnstile"
                  data-sitekey={cloudflare_site_key}
                  data-callback="enableSubmit"
                  data-expired-callback="resetSubmit"
                  data-error-callback="resetSubmit"
                >
                </div>
                <p id="form-error" class="hidden text-sm text-destructive"></p>
                <button
                  id="submit-button"
                  type="submit"
                  disabled
                  class="w-full relative overflow-hidden bg-primary-500 disabled:bg-primary-500/80 text-white font-medium py-5 px-8 rounded-2xl transition-all duration-300 flex items-center justify-center gap-2 group shadow-[0_5px_40px_-10px_rgba(var(--primary),0.6)] hover:shadow-[0_5px_40px_-5px_rgba(var(--primary),0.8)] cursor-pointer"
                >
                  <span
                    class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"
                  ></span>
                  <span class="relative z-10 text-lg submit-text"
                    >Send Message</span
                  >
                  <!--<Send-->
                  <!--  className="w-5 h-5 relative z-10 transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:scale-110 submit-icon"-->
                  <!--/>-->
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { submitLead } from "@/lib/submitLead";

  let turnstileToken: string | null = null;

  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;

  function setFieldError(id: string, message: string | undefined) {
    const el = document.getElementById(id);
    if (!el) return;
    el.textContent = message ?? "";
    el.classList.toggle("hidden", !message);
  }

  function clearErrors() {
    setFieldError("phone-error", undefined);
    setFieldError("email-error", undefined);
    setFieldError("form-error", undefined);
  }

  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      if (!turnstileToken) {
        alert("Please complete the captcha before submitting.");
        return;
      }

      const submitBtn = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      const submitText = form.querySelector(".submit-text");
      const submitIcon = form.querySelector(".submit-icon");
      const originalText = submitText?.textContent || "Send Message";

      if (submitBtn && submitText) {
        submitBtn.disabled = true;
        submitText.textContent = "Sending...";
        if (submitIcon) submitIcon.classList.add("hidden");
      }

      clearErrors();

      const formData = new FormData(form);
      const firstName = formData.get("firstName") as string;
      const lastName = formData.get("lastName") as string;
      const phone = formData.get("phone") as string;
      const email = formData.get("email") as string;
      const address = formData.get("address") as string;

      const result = await submitLead({
        name: `${firstName} ${lastName}`.trim(),
        phone,
        email,
        address,
        source: "contact-page",
        cfTurnstileResponse: turnstileToken,
      });

      if (result.success) {
        alert("Thank you! Your message has been sent successfully.");
        form.reset();
      } else if (result.code === "VALIDATION_ERROR") {
        setFieldError("phone-error", result.fieldErrors.phone?.[0]);
        setFieldError("email-error", result.fieldErrors.email?.[0]);
        // name/address/captcha issues don't have a dedicated slot in this
        // form, so fall back to the general banner for those.
        const otherMessage = [
          ...(result.fieldErrors.name ?? []),
          ...(result.fieldErrors.address ?? []),
          ...(result.fieldErrors.cfTurnstileResponse ?? []),
        ][0];
        setFieldError("form-error", otherMessage ?? result.message);
      } else {
        setFieldError("form-error", result.message);
      }

      // Turnstile tokens are single-use, so require a fresh one for the
      // next attempt regardless of whether this one succeeded.
      window.turnstile?.reset();
      turnstileToken = null;
      if (submitBtn && submitText) {
        submitBtn.disabled = true;
        submitText.textContent = originalText;
        if (submitIcon) submitIcon.classList.remove("hidden");
      }
    });
  }

  //@ts-expect-error attached to window for the Turnstile implicit-render callback
  window.enableSubmit = function (token: string) {
    turnstileToken = token;
    const submit = document.getElementById(
      "submit-button",
    ) as HTMLButtonElement | null;
    if (submit) {
      submit.disabled = false;
    }
  };

  //@ts-expect-error attached to window for the Turnstile implicit-render callback
  window.resetSubmit = function () {
    turnstileToken = null;
    const submit = document.getElementById(
      "submit-button",
    ) as HTMLButtonElement | null;
    if (submit) {
      submit.disabled = true;
    }
  };
</script>
