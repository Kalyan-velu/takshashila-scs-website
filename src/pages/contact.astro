---
import Layout from "../layouts/Layout.astro";
import { Phone, Mail, MapPin, Send } from "lucide-react";

const title = "Contact Us | Takshashila School of Civil Services";
const description =
  "At Takshashila School of Civil Services, the best coaching institute for UPSC and APSC in Guwahati, we value open communication and are committed to supporting you every step of the way.";
---

<Layout title={title} description={description}>
  <section class="relative pt-24 pb-16 md:pb-24 overflow-hidden">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 pointer-events-none"
    >
      <div
        class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-primary/5 blur-[120px]"
      >
      </div>
      <div
        class="absolute bottom-[10%] right-[-5%] w-[30%] h-[30%] rounded-full bg-primary/10 blur-[100px]"
      >
      </div>
    </div>

    <div class="px-4 md:px-6 max-w-7xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div class="flex flex-col gap-10">
          <div class="space-y-6">
            <h1
              class="text-4xl md:text-5xl lg:text-6xl font-light tracking-tight text-foreground leading-tight"
            >
              Contact <span class="text-primary italic">Us</span>
            </h1>
            <div
              class="space-y-4 text-lg text-muted-foreground font-light leading-relaxed"
            >
              <p>
                At Takshashila School of Civil Services, the best coaching
                institute for UPSC in Guwahati, we value open communication and
                are committed to supporting you every step of the way as you
                work toward achieving your dream of becoming a civil servant.
              </p>
              <p>
                If you have any queries, questions, or require assistance, feel
                free to contact us—we’re here to help.
              </p>
            </div>
          </div>

          <div class="space-y-8">
            <div
              class="space-y-4 text-muted-foreground font-light leading-relaxed"
            >
              <p>
                Preparing for competitive exams like UPSC and APSC can be a
                challenging and demanding journey. That’s why we have a
                dedicated team ready to provide the guidance and support you
                need. Whether you’re seeking information about our courses,
                faculty, admissions, or facilities, we’re happy to provide you
                with detailed and accurate answers.
              </p>
              <p>
                Don’t hesitate to contact us for any information at Takshashila
                School of Civil Services, the best coaching institute for APSC
                in Guwahati.
              </p>
            </div>

            <div class="space-y-4">
              <h2
                class="text-2xl md:text-3xl font-medium text-foreground tracking-tight"
              >
                How We Support You
              </h2>
              <div
                class="space-y-4 text-muted-foreground font-light leading-relaxed"
              >
                <p>
                  At Takshashila, the best APSC coaching centre in Guwahati our
                  goal is to ensure every aspirant has access to the resources
                  and mentorship required to succeed. We provide personalized
                  advice tailored to your unique needs, helping you navigate
                  your preparation journey effectively.
                </p>
                <p>
                  From understanding our admission process to exploring the best
                  course for you, we are here to guide you every step of the
                  way. So remember, contact us for personalized advice. Visit <a
                    href="/about"
                    class="text-primary hover:underline underline-offset-4"
                    >Takshashila School of Civil Services – About</a
                  > for more details.
                </p>
              </div>
            </div>

            <div class="space-y-4">
              <h2
                class="text-2xl md:text-3xl font-medium text-foreground tracking-tight"
              >
                Why Contact Us?
              </h2>
              <ul class="space-y-3">
                {
                  [
                    "Discover more about our innovative approach to UPSC and APSC preparation.",
                    "Get expert advice on selecting the right program for your career aspirations. For that, feel free to contact us at any point in your journey.",
                    "Learn about eligibility criteria, class schedules, and faculty support.",
                    "Explore additional services and resources designed to enhance your preparation.",
                  ].map((item) => (
                    <li class="flex items-start gap-3 text-muted-foreground font-light group">
                      <span class="mt-2.5 w-1.5 h-1.5 rounded-full bg-primary shrink-0 transition-transform group-hover:scale-125" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div class="p-6 rounded-2xl bg-muted/30 border border-border/50">
              <p class="text-muted-foreground font-light leading-relaxed">
                Your success is important to us, and we are dedicated to helping
                you make your vision a reality. Don’t hesitate to reach out to
                us with any questions or concerns. Explore <a
                  href="/courses"
                  class="text-primary hover:underline underline-offset-4"
                  >Our UPSC & APSC Preparation Courses</a
                > today and take the first step toward a bright future in public service.
              </p>
              <p class="mt-4 text-foreground font-medium">
                Contact us anytime for further details at Takshashila School of
                Civil Services, the best coaching institute for IAS in Guwahati.
              </p>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-4">
            <div
              class="p-6 rounded-2xl bg-card border border-border shadow-sm flex items-start gap-4 hover:border-primary/30 transition-colors"
            >
              <div
                class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary shrink-0"
              >
                <Phone className="w-6 h-6" />
              </div>
              <div class="space-y-1">
                <p
                  class="text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Call to ask any question
                </p>
                <a
                  href="tel:+916001657575"
                  class="text-lg font-medium text-foreground hover:text-primary transition-colors"
                  >+91-60016-57575</a
                >
              </div>
            </div>

            <div
              class="p-6 rounded-2xl bg-card border border-border shadow-sm flex items-start gap-4 hover:border-primary/30 transition-colors"
            >
              <div
                class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary shrink-0"
              >
                <Mail className="w-6 h-6" />
              </div>
              <div class="space-y-1">
                <p
                  class="text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Email to get free quote
                </p>
                <a
                  href="mailto:info@takshashilascs.com"
                  class="text-lg font-medium text-foreground hover:text-primary transition-colors"
                  >info@takshashilascs.com</a
                >
              </div>
            </div>

            <div
              class="sm:col-span-2 p-6 rounded-2xl bg-card border border-border shadow-sm flex items-start gap-4 hover:border-primary/30 transition-colors"
            >
              <div
                class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary shrink-0"
              >
                <MapPin className="w-6 h-6" />
              </div>
              <div class="space-y-1">
                <p
                  class="text-xs font-medium uppercase tracking-wider text-muted-foreground"
                >
                  Visit our office
                </p>
                <p class="text-lg font-medium text-foreground">
                  Guwahati, Assam, India
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:sticky lg:top-0">
          <div
            class="bg-card border border-border p-8 md:p-12 rounded-[2.5rem] shadow-xl relative overflow-hidden group"
          >
            <div
              class="absolute top-0 right-0 w-64 h-64 bg-primary/5 rounded-full -mr-32 -mt-32 blur-3xl transition-colors group-hover:bg-primary/10"
            >
            </div>

            <div class="relative z-10 space-y-8">
              <div class="space-y-2">
                <h3 class="text-3xl font-light tracking-tight text-foreground">
                  Send a <span class="text-primary italic">Message</span>
                </h3>
                <p class="text-muted-foreground font-light">
                  Fill out the form below and we'll get back to you shortly.
                </p>
              </div>

              <form class="space-y-6">
                <div class="space-y-4">
                  <label class="text-sm font-medium text-foreground"
                    >Name <span class="text-primary">*</span></label
                  >
                  <div class="grid sm:grid-cols-2 gap-4">
                    <div class="space-y-1.5">
                      <input
                        type="text"
                        required
                        class="w-full px-4 py-3 border border-border rounded-xl bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-muted-foreground/40"
                        placeholder="First Name"
                      />
                      <span
                        class="text-[10px] text-muted-foreground uppercase tracking-widest px-1"
                        >First</span
                      >
                    </div>
                    <div class="space-y-1.5">
                      <input
                        type="text"
                        required
                        class="w-full px-4 py-3 border border-border rounded-xl bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-muted-foreground/40"
                        placeholder="Last Name"
                      />
                      <span
                        class="text-[10px] text-muted-foreground uppercase tracking-widest px-1"
                        >Last</span
                      >
                    </div>
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-6">
                  <div class="space-y-1.5">
                    <label class="text-sm font-medium text-foreground"
                      >Phone <span class="text-primary">*</span></label
                    >
                    <input
                      type="tel"
                      required
                      class="w-full px-4 py-3 border border-border rounded-xl bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-muted-foreground/40"
                      placeholder="+91-00000-00000"
                    />
                  </div>
                  <div class="space-y-1.5">
                    <label class="text-sm font-medium text-foreground"
                      >Email <span class="text-primary">*</span></label
                    >
                    <input
                      type="email"
                      required
                      class="w-full px-4 py-3 border border-border rounded-xl bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-muted-foreground/40"
                      placeholder="example@mail.com"
                    />
                  </div>
                </div>

                <div class="space-y-1.5">
                  <label class="text-sm font-medium text-foreground"
                    >Address</label
                  >
                  <textarea
                    rows="3"
                    class="w-full px-4 py-3 border border-border rounded-xl bg-background text-foreground focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary transition-all placeholder:text-muted-foreground/40 resize-none"
                    placeholder="Your full address"></textarea>
                </div>

                <button
                  type="submit"
                  class="w-full bg-primary text-primary-foreground hover:bg-primary/90 font-medium py-4 px-8 rounded-xl transition-all flex items-center justify-center gap-2 group shadow-lg shadow-primary/25 cursor-pointer"
                >
                  <span>Submit</span>
                  <Send
                    className="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
                  />
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
