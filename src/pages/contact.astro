---
import Layout from "../layouts/Layout.astro";
import { Phone, Mail, MapPin, Send } from "lucide-react";

const title = "Contact Us | Takshashila School of Civil Services";
const description =
  "At Takshashila School of Civil     Services, the best coaching institute for UPSC and APSC in Guwahati, we value open communication and are committed to supporting you every step of the way.";
---

<Layout title={title} description={description}>
  <section class="relative pt-24 pb-16 md:pb-24 overflow-hidden min-h-screen">
    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-full h-full -z-10 pointer-events-none"
    >
      <div
        class="absolute top-[-10%] left-[-10%] w-125 h-[500px] rounded-full bg-primary/10 blur-[140px] animate-pulse duration-10000"
      >
      </div>
      <div
        class="absolute bottom-[20%] right-[-5%] w-[600px] h-[600px] rounded-full bg-primary/5 blur-[150px]"
      >
      </div>
      <div
        class="absolute top-[40%] left-[20%] w-[300px] h-[300px] rounded-full bg-secondary/10 blur-[120px]"
      >
      </div>
    </div>

    <div class="px-4 md:px-6 max-w-7xl mx-auto relative z-10">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div class="flex flex-col gap-10">
          <div class="space-y-6">
            <h1
              class="text-5xl md:text-6xl lg:text-7xl font-light tracking-tight text-foreground leading-[1.1]"
            >
              Contact <span class="text-primary italic font-serif">Us</span>
            </h1>
            <div
              class="space-y-5 text-lg text-muted-foreground font-light leading-relaxed"
            >
              <p>
                At Takshashila School of Civil Services, the best coaching
                institute for UPSC in Guwahati, we value open communication and
                are committed to supporting you every step of the way as you
                work toward achieving your dream of becoming a civil servant.
              </p>
              <p>
                If you have any queries, questions, or require assistance, feel
                free to contact us—we’re here to help.
              </p>
            </div>
          </div>

          <div class="space-y-10">
            <div
              class="space-y-4 text-muted-foreground font-light leading-relaxed text-lg"
            >
              <p>
                Preparing for competitive exams like UPSC and APSC can be a
                challenging and demanding journey. That’s why we have a
                dedicated team ready to provide the guidance and support you
                need. Whether you’re seeking information about our courses,
                faculty, admissions, or facilities, we’re happy to provide you
                with detailed and accurate answers.
              </p>
            </div>

            <div class="space-y-5">
              <h2
                class="text-3xl md:text-4xl font-light text-foreground tracking-tight"
              >
                How We Support You
              </h2>
              <div
                class="space-y-4 text-muted-foreground font-light leading-relaxed text-lg"
              >
                <p>
                  At Takshashila, the best APSC coaching centre in Guwahati, our
                  goal is to ensure every aspirant has access to the resources
                  and mentorship required to succeed. We provide personalized
                  advice tailored to your unique needs, helping you navigate
                  your preparation journey effectively.
                </p>
              </div>
            </div>

            <div class="space-y-6">
              <h2
                class="text-3xl md:text-4xl font-light text-foreground tracking-tight"
              >
                Why Contact Us?
              </h2>
              <ul class="space-y-4">
                {
                  [
                    "Discover more about our innovative approach to UPSC and APSC preparation.",
                    "Get expert advice on selecting the right program for your career aspirations.",
                    "Learn about eligibility criteria, class schedules, and faculty support.",
                    "Explore additional services and resources designed to enhance your preparation.",
                  ].map((item) => (
                    <li class="flex items-start gap-4 text-muted-foreground font-light text-lg group">
                      <span class="mt-2.5 w-2 h-2 rounded-full bg-primary/70 shrink-0 transition-all duration-300 group-hover:scale-150 group-hover:bg-primary shadow-[0_0_10px_rgba(var(--primary),0.5)]" />
                      <span>{item}</span>
                    </li>
                  ))
                }
              </ul>
            </div>

            <div
              class="relative p-8 rounded-3xl bg-card/60 backdrop-blur-xl border border-border/50 shadow-xl overflow-hidden group hover:border-primary/30 transition-colors duration-500"
            >
              <div
                class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              >
              </div>
              <div class="relative z-10">
                <p
                  class="text-muted-foreground font-light leading-relaxed text-lg"
                >
                  Your success is important to us, and we are dedicated to
                  helping you make your vision a reality. Explore <a
                    href="/courses"
                    class="text-primary hover:text-primary/80 font-medium hover:underline underline-offset-4 transition-colors"
                    >Our UPSC & APSC Preparation Courses</a
                  > today and take the first step toward a bright future in public
                  service.
                </p>
                <p class="mt-4 text-foreground font-medium text-lg">
                  Reach out to Takshashila School of Civil Services, the best
                  coaching institute for IAS in Guwahati.
                </p>
              </div>
            </div>
          </div>

          <div class="grid sm:grid-cols-2 gap-6 mt-4">
            <div
              class="relative p-8 rounded-[2rem] bg-card/50 backdrop-blur-md border border-border/50 shadow-lg flex flex-col items-start gap-6 hover:shadow-xl hover:border-primary/40 transition-all duration-500 group overflow-hidden"
            >
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full -mr-16 -mt-16 blur-2xl transition-transform duration-500 group-hover:scale-150 group-hover:bg-primary/10"
              >
              </div>
              <div
                class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center text-primary shrink-0 transition-transform duration-500 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_rgba(var(--primary),0.5)] relative z-10"
              >
                <Phone className="w-6 h-6" />
              </div>
              <div class="space-y-2 relative z-10 w-full">
                <p
                  class="text-xs font-medium uppercase tracking-widest text-muted-foreground"
                >
                  Give Us A Call
                </p>
                <a
                  href="tel:+916001657575"
                  class="block text-xl font-medium text-foreground hover:text-primary transition-colors truncate"
                  >+91-60016-57575</a
                >
              </div>
            </div>

            <div
              class="relative p-8 rounded-[2rem] bg-card/50 backdrop-blur-md border border-border/50 shadow-lg flex flex-col items-start gap-6 hover:shadow-xl hover:border-primary/40 transition-all duration-500 group overflow-hidden"
            >
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-primary/5 rounded-full -mr-16 -mt-16 blur-2xl transition-transform duration-500 group-hover:scale-150 group-hover:bg-primary/10"
              >
              </div>
              <div
                class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center text-primary shrink-0 transition-transform duration-500 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_rgba(var(--primary),0.5)] relative z-10"
              >
                <Mail className="w-6 h-6" />
              </div>
              <div class="space-y-2 relative z-10 w-full">
                <p
                  class="text-xs font-medium uppercase tracking-widest text-muted-foreground"
                >
                  Send An Email
                </p>
                <a
                  href="mailto:info@takshashilascs.com"
                  class="block text-xl font-medium text-foreground hover:text-primary transition-colors truncate"
                  >info@takshashilascs.com</a
                >
              </div>
            </div>

            <div
              class="relative sm:col-span-2 p-8 rounded-[2rem] bg-card/50 backdrop-blur-md border border-border/50 shadow-lg flex flex-col sm:flex-row items-start sm:items-center gap-6 hover:shadow-xl hover:border-primary/40 transition-all duration-500 group overflow-hidden"
            >
              <div
                class="absolute top-0 right-0 w-48 h-48 bg-primary/5 rounded-full -mr-24 -mt-24 blur-3xl transition-transform duration-500 group-hover:scale-150 group-hover:bg-primary/10"
              >
              </div>
              <div
                class="w-14 h-14 rounded-2xl bg-primary/10 flex items-center justify-center text-primary shrink-0 transition-transform duration-500 group-hover:scale-110 group-hover:shadow-[0_0_20px_-5px_rgba(var(--primary),0.5)] relative z-10"
              >
                <MapPin className="w-6 h-6" />
              </div>
              <div class="space-y-2 relative z-10">
                <p
                  class="text-xs font-medium uppercase tracking-widest text-muted-foreground"
                >
                  Visit Our Office
                </p>
                <p class="text-xl font-medium text-foreground">
                  Guwahati, Assam, India
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="lg:sticky lg:top-8 mt-8 lg:mt-0">
          <div
            class="bg-card/40 backdrop-blur-2xl border border-white/10 dark:border-white/5 p-8 sm:p-12 rounded-[2.5rem] shadow-2xl relative overflow-hidden group"
          >
            {/* Form Inner Glow Effect */}
            <div
              class="absolute top-0 right-0 w-100 h-100 bg-primary/10 rounded-full -mr-48 -mt-48 blur-[80px] transition-opacity duration-700 opacity-50 group-hover:opacity-100 pointer-events-none"
            >
            </div>
            <div
              class="absolute bottom-0 left-0 w-[300px] h-75 bg-secondary/10 rounded-full -ml-32 -mb-32 blur-[60px] transition-opacity duration-700 opacity-30 group-hover:opacity-80 pointer-events-none"
            >
            </div>

            <div class="relative z-10 space-y-10">
              <div class="space-y-3">
                <h3 class="text-4xl font-light tracking-tight text-foreground">
                  Send a <span class="text-primary italic font-serif"
                    >Message</span
                  >
                </h3>
                <p class="text-muted-foreground font-light text-lg">
                  Fill out the form below and we'll get back to you shortly.
                </p>
              </div>

              <form id="contact-form" class="space-y-7">
                <div class="space-y-5">
                  <label
                    class="text-sm font-medium text-foreground tracking-wide"
                    >Name <span class="text-primary">*</span></label
                  >
                  <div class="grid sm:grid-cols-2 gap-5">
                    <div class="space-y-2">
                      <label>
                        <input
                          type="text"
                          name="firstName"
                          required
                          class="w-full px-5 py-4 border border-border/50 rounded-2xl bg-background/50 backdrop-blur-md text-foreground focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all placeholder:text-muted-foreground/40 shadow-inner"
                          placeholder="First Name"
                        />
                      </label>
                      <span
                        class="text-[10px] text-muted-foreground uppercase tracking-widest px-2"
                        >First</span
                      >
                    </div>
                    <div class="space-y-2">
                      <label>
                        <input
                          type="text"
                          name="lastName"
                          required
                          class="w-full px-5 py-4 border border-border/50 rounded-2xl bg-background/50 backdrop-blur-md text-foreground focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all placeholder:text-muted-foreground/40 shadow-inner"
                          placeholder="Last Name"
                        />
                      </label>
                      <span
                        class="text-[10px] text-muted-foreground uppercase tracking-widest px-2"
                        >Last</span
                      >
                    </div>
                  </div>
                </div>

                <div class="grid sm:grid-cols-2 gap-6">
                  <div class="space-y-3">
                    <label
                      class="text-sm font-medium text-foreground tracking-wide"
                      >Phone <span class="text-primary">*</span></label
                    >
                    <input
                      type="tel"
                      name="phone"
                      required
                      class="w-full px-5 py-4 border border-border/50 rounded-2xl bg-background/50 backdrop-blur-md text-foreground focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all placeholder:text-muted-foreground/40 shadow-inner"
                      placeholder="+91-00000-00000"
                    />
                  </div>
                  <div class="space-y-3">
                    <label
                      class="text-sm font-medium text-foreground tracking-wide"
                      >Email <span class="text-primary">*</span></label
                    >
                    <input
                      type="email"
                      name="email"
                      required
                      class="w-full px-5 py-4 border border-border/50 rounded-2xl bg-background/50 backdrop-blur-md text-foreground focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all placeholder:text-muted-foreground/40 shadow-inner"
                      placeholder="example@mail.com"
                    />
                  </div>
                </div>

                <div class="space-y-3">
                  <label
                    class="text-sm font-medium text-foreground tracking-wide"
                    >Address</label
                  >
                  <textarea
                    rows="3"
                    name="address"
                    class="w-full px-5 py-4 border border-border/50 rounded-2xl bg-background/50 backdrop-blur-md text-foreground focus:outline-none focus:ring-2 focus:ring-primary/30 focus:border-primary/50 transition-all placeholder:text-muted-foreground/40 resize-none shadow-inner"
                    placeholder="Your full address"></textarea>
                </div>

                <button
                  type="submit"
                  class="w-full relative overflow-hidden bg-primary text-primary-foreground font-medium py-5 px-8 rounded-2xl transition-all duration-300 flex items-center justify-center gap-2 group shadow-[0_5px_40px_-10px_rgba(var(--primary),0.6)] hover:shadow-[0_5px_40px_-5px_rgba(var(--primary),0.8)] cursor-pointer"
                >
                  <span
                    class="absolute inset-0 bg-white/20 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out"
                  ></span>
                  <span class="relative z-10 text-lg submit-text"
                    >Send Message</span
                  >
                  <Send
                    className="w-5 h-5 relative z-10 transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1 group-hover:scale-110 submit-icon"
                  />
                </button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;
      const submitText = form.querySelector(".submit-text");
      const submitIcon = form.querySelector(".submit-icon");
      const originalText = submitText?.textContent || "Send Message";

      if (submitBtn && submitText) {
        submitBtn.disabled = true;
        submitText.textContent = "Sending...";
        if (submitIcon) submitIcon.classList.add("hidden");
      }

      const formData = new FormData(form);
      const firstName = formData.get("firstName") as string;
      const lastName = formData.get("lastName") as string;
      const phone = formData.get("phone") as string;
      const email = formData.get("email") as string;
      const address = formData.get("address") as string;

      try {
        const { error } = await supabase.from("leads").insert([
          {
            name: `${firstName} ${lastName}`.trim(),
            phone,
            email,
            address,
            source: "contact_page",
          },
        ]);

        if (error) throw error;

        alert("Thank you! Your message has been sent successfully.");
        form.reset();
      } catch (err) {
        console.error("Error submitting form:", err);
        alert(
          "There was an error sending your message. Please try again later.",
        );
      } finally {
        if (submitBtn && submitText) {
          submitBtn.disabled = false;
          submitText.textContent = originalText;
          if (submitIcon) submitIcon.classList.remove("hidden");
        }
      }
    });
  }
</script>
