---
export const prerender = false;

import Layout from '@/layouts/Layout.astro';
import { getQuizById } from '@/lib/currentAffairs.ts';

const { id } = Astro.params;
const quiz = id ? await getQuizById(id) : null;

if (!quiz) {
  Astro.response.status = 404;
} else {
  Astro.response.headers.set(
    'Cache-Control',
    'public, s-maxage=1800, stale-while-revalidate=86400',
  );
}

const DATE_FORMAT = new Intl.DateTimeFormat('en-IN', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

const OPTION_LETTERS = ['A', 'B', 'C', 'D', 'E', 'F'];
---

<Layout
  title={quiz
    ? `${quiz.title} | Takshasheela School of Civil Services`
    : 'Quiz Not Found | Takshasheela School of Civil Services'}
  description={quiz
    ? `Take the ${quiz.title} — a ${quiz.questions.length}-question current affairs quiz with instant grading and explanations.`
    : "This quiz doesn't exist or is no longer published."}
>
  {
    !quiz ? (
      <div class='min-h-[50vh] flex flex-col items-center justify-center text-center px-4 py-20 bg-primary-500/5 border-b border-gray-200'>
        <span class='text-sm font-semibold text-primary-500 uppercase tracking-widest mb-4'>
          Error 404
        </span>
        <h1 class='text-4xl md:text-5xl font-light tracking-tight text-gray-900 mb-6 leading-tight'>
          Quiz <span class='text-primary-500 font-medium'>Not Found</span>
        </h1>
        <p class='text-gray-600 text-lg font-light max-w-xl mb-10 leading-relaxed'>
          This quiz doesn't exist, or isn't published yet.
        </p>
        <a
          href='/quiz/'
          class='inline-flex items-center gap-2 px-6 py-3 rounded-full bg-primary-500 text-white font-medium hover:bg-primary-600 transition-colors shadow-lg shadow-primary-500/20'
        >
          &larr; All quizzes
        </a>
      </div>
    ) : (
      <>
        <div class='bg-primary-500/5 py-16 flex flex-col items-center justify-center text-center px-4 border-b border-gray-200'>
          <p class='text-xs font-medium text-primary-500 mb-3'>
            {DATE_FORMAT.format(new Date(quiz.date))}
          </p>
          <h1 class='text-3xl md:text-4xl lg:text-5xl font-light tracking-tight text-gray-900 max-w-3xl mb-4 leading-tight'>
            {quiz.title}
          </h1>
          {quiz.categories.length > 0 && (
            <div class='flex flex-wrap justify-center gap-2'>
              {quiz.categories.map((c) => (
                <span class='text-xs font-medium text-gray-600 bg-white border border-gray-200 rounded-full px-3 py-1'>
                  {c.name}
                </span>
              ))}
            </div>
          )}
        </div>

        <div class='quiz-app px-4 py-16 md:px-6 max-w-3xl mx-auto w-full'>
          <a
            href='/quiz/'
            class='inline-flex items-center gap-1.5 text-sm font-medium text-gray-600 hover:text-primary-500 transition-colors mb-8'
          >
            &larr; All quizzes
          </a>

          {quiz.questions.length === 0 ? (
            <div class='text-center py-20 bg-gray-100/20 border border-dashed border-gray-200 rounded-3xl px-6'>
              <h3 class='text-xl font-medium mb-2'>No Questions Yet</h3>
              <p class='text-gray-600 font-light text-sm'>
                This quiz doesn't have any questions published yet.
              </p>
            </div>
          ) : (
            <form class='quiz-form flex flex-col gap-6'>
              {quiz.questions.map((q, qi) => (
                <fieldset
                  class='quiz-question bg-white rounded-3xl border border-gray-200 p-6 md:p-8'
                  data-correct={q.correctOptionIndex}
                  data-explanation={q.explanation}
                >
                  <legend class='font-medium text-gray-900 tracking-tight  text-base md:text-lg mb-5 px-0'>
                    <span class='text-primary-500 mr-2'>Q{qi + 1}.</span>
                    {q.question}
                  </legend>
                  <div class='flex flex-col gap-2.5'>
                    {q.options.map((option, oi) => (
                      <label class='quiz-option flex items-center gap-3 rounded-2xl border border-gray-200 px-4 py-3 cursor-pointer hover:border-primary-500/40 transition-colors'>
                        <input
                          type='radio'
                          name={`q${qi}`}
                          value={oi}
                          class='quiz-radio h-4 w-4 accent-primary-500 shrink-0'
                          required
                        />
                        <span class='quiz-option-letter text-xs font-semibold text-gray-500 w-5 shrink-0'>
                          {OPTION_LETTERS[oi] ?? oi + 1}
                        </span>
                        <span class='text-sm text-gray-800'>{option}</span>
                      </label>
                    ))}
                  </div>
                  <p class='quiz-explanation hidden mt-4 text-sm text-gray-600 bg-gray-100/60 border border-gray-200 rounded-2xl px-4 py-3 leading-relaxed' />
                </fieldset>
              ))}

              <div class='quiz-submit-row flex flex-col items-center gap-4 pt-2'>
                <button
                  type='submit'
                  class='quiz-submit-btn inline-flex w-full md:w-auto md:px-16 h-12 items-center justify-center rounded-2xl bg-primary-500 text-white hover:bg-primary-500/95 transition-colors font-semibold text-sm'
                >
                  Submit Quiz
                </button>
              </div>
            </form>
          )}

          <div class='quiz-results hidden flex-col items-center gap-4 bg-primary-500/5 border border-primary-500/10 rounded-3xl px-6 py-10 text-center mt-2'>
            <p class='text-xs font-semibold text-primary-500 uppercase tracking-widest'>
              Your Score
            </p>
            <p class='quiz-score-text text-4xl md:text-5xl font-light tracking-tight text-gray-900' />
            <a
              href='/quiz/'
              class='inline-flex items-center justify-center rounded-2xl bg-primary-500 text-white hover:bg-primary-500/95 transition-colors font-semibold text-sm px-8 h-11 mt-2'
            >
              More Quizzes
            </a>
          </div>
        </div>
      </>
    )
  }
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.quiz-app');
  const form = root?.querySelector<HTMLFormElement>('.quiz-form');
  if (root && form) {
    const questions = Array.from(
      form.querySelectorAll<HTMLFieldSetElement>('.quiz-question'),
    );
    const results = root.querySelector<HTMLElement>('.quiz-results');
    const scoreText = root.querySelector<HTMLElement>('.quiz-score-text');
    const submitRow = root.querySelector<HTMLElement>('.quiz-submit-row');

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let score = 0;

      questions.forEach((fieldset) => {
        const correctIndex = Number(fieldset.dataset.correct);
        const explanation = fieldset.dataset.explanation ?? '';
        const options = Array.from(
          fieldset.querySelectorAll<HTMLLabelElement>('.quiz-option'),
        );
        const selected = fieldset.querySelector<HTMLInputElement>(
          'input[type=radio]:checked',
        );
        const selectedIndex = selected ? Number(selected.value) : -1;
        const isCorrect = selectedIndex === correctIndex;
        if (isCorrect) score++;

        options.forEach((label, oi) => {
          const input = label.querySelector('input');
          if (input) input.disabled = true;
          label.classList.remove(
            'border-primary-500/40',
            'hover:border-primary-500/40',
          );
          label.classList.add('cursor-default');
          if (oi === correctIndex) {
            label.classList.add(
              'border-green-500',
              'bg-green-50',
              'text-green-900',
            );
          } else if (oi === selectedIndex) {
            label.classList.add('border-red-400', 'bg-red-50');
          }
        });

        const explanationEl =
          fieldset.querySelector<HTMLElement>('.quiz-explanation');
        if (explanationEl && explanation) {
          explanationEl.textContent = `${isCorrect ? 'Correct. ' : 'Incorrect. '}${explanation}`;
          explanationEl.classList.remove('hidden');
          explanationEl.classList.toggle('border-green-200', isCorrect);
          explanationEl.classList.toggle('border-red-200', !isCorrect);
        }
      });

      submitRow?.classList.add('hidden');
      if (results && scoreText) {
        scoreText.textContent = `${score} / ${questions.length}`;
        results.classList.remove('hidden');
        results.classList.add('flex');
        results.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  }
</script>
