---
import Layout from "@/layouts/Layout.astro";
import QuizGrid from "@/components/QuizGrid.astro";
---

<Layout
  title="Daily Current Affairs Quiz | Takshasheela School of Civil Services"
  description="Test your UPSC and APSC preparation with our daily current affairs quiz — instant grading, explanations, and category-wise sets."
>
  <div
    class="bg-primary-500/5 py-16 flex flex-col items-center justify-center text-center px-4 border-b border-gray-200"
  >
    <h1
      class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-gray-900 max-w-4xl mb-4 leading-tight"
    >
      Daily <span class="text-primary-500 font-medium">Quiz</span>
    </h1>
    <p class="text-gray-600 font-light text-lg max-w-2xl leading-relaxed">
      Sharpen your current affairs prep with a fresh multiple-choice quiz
      every day — instant grading with explanations for every question.
    </p>
  </div>

  <QuizGrid server:defer>
    <div slot="fallback" class="px-4 py-16 md:px-6 max-w-7xl mx-auto w-full">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {Array.from({ length: 6 }).map(() => (
          <div class="h-52 rounded-3xl border border-gray-200 bg-gray-100/50 animate-pulse" />
        ))}
      </div>
    </div>
  </QuizGrid>
</Layout>
