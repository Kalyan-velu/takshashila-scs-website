---
import Layout from "@/layouts/Layout.astro";
import GalleryGrid from "@/components/GalleryGrid.astro";
---

<Layout
  title="Photo Gallery | Takshasheela School of Civil Services"
  description="Browse photos from campus life, classes, and events at Takshasheela School of Civil Services, Guwahati — organized by category."
>
  <div
    class="bg-primary-500/5 py-16 flex flex-col items-center justify-center text-center px-4 border-b border-gray-200"
  >
    <h1
      class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-gray-900 max-w-4xl mb-4 leading-tight"
    >
      Photo <span class="text-primary-500 font-medium">Gallery</span>
    </h1>
    <p class="text-gray-600 font-light text-lg max-w-2xl leading-relaxed">
      Glimpses of campus life, classes, and events at Takshasheela School of
      Civil Services — browse by category.
    </p>
  </div>

  <GalleryGrid server:defer>
    <div slot="fallback" class="px-4 py-16 md:px-6 max-w-7xl mx-auto w-full">
      <div class="flex flex-wrap gap-2 mb-10">
        {Array.from({ length: 4 }).map(() => (
          <div class="h-9 w-20 rounded-full bg-gray-100/50 animate-pulse" />
        ))}
      </div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {Array.from({ length: 8 }).map(() => (
          <div class="aspect-square rounded-2xl border border-gray-200 bg-gray-100/50 animate-pulse" />
        ))}
      </div>
    </div>
  </GalleryGrid>
</Layout>
