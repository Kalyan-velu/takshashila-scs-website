---
import Layout from "@/layouts/Layout.astro";
import { EMAIL } from "@/config/CONSTANTS.ts";

const title = "Refund & Cancellation Policy | Takshasheela School of Civil Services";
const description = "Read the Refund & Cancellation Policy for Takshasheela School of Civil Services courses, study materials, and enrollment terms.";
---

<Layout title={title} description={description}>
  <div class="bg-primary-500/5 py-12 md:py-20 border-b border-gray-200">
    <div class="container mx-auto px-4 lg:px-24">
      <h1
        class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-gray-900 max-w-4xl mb-6 leading-tight"
      >
        Refund <span class="text-primary-500 font-medium">Policy </span>
      </h1>
      <p
        class="text-lg md:text-xl text-gray-600 max-w-3xl font-light mb-8 leading-relaxed"
      >
        Takshasheela School of Civil Services is a unit of <strong>Takshashila Educational Trust</strong> (formerly known as <strong>Takshashila School of Civil Services</strong>).
      </p>
    </div>
  </div>
  <div
    class="container px-4 lg:px-24 mx-auto py-16 md:py-24 space-y-12 text-gray-600 leading-relaxed"
  >
    <section>
      <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-4">
        Refund & Cancellation Policy
      </h2>
      <p class="mb-4">
        Welcome to Takshasheela School of Civil Services, a unit of <strong>Takshashila Educational Trust</strong> (formerly known as <strong>Takshashila School of Civil Services</strong>). We strive to provide
        the best educational experience for our students. However, we understand
        that situations may arise where refunds or cancellations are necessary.
        Please review our Refund & Cancellation Policy below:
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-6">
        Refund Policy
      </h2>

      <h3 class="text-xl font-medium text-gray-900 mt-6 mb-3">Course Fees</h3>
      <p class="mb-4">
        All course fees paid to Takshasheela School of Civil Services are
        non-refundable except under the following circumstances:
      </p>
      <ul class="list-disc pl-6 space-y-3 mb-6 marker:text-primary-500">
        <li>
          If a course is canceled by Takshasheela School of Civil Services due
          to unforeseen circumstances, students will receive a full refund of
          the course fees.
        </li>
        <li>
          If a student withdraws from a course within the first week of
          enrollment, they may be eligible for a partial refund. The amount
          refunded will be determined on a case-by-case basis.
        </li>
      </ul>

      <h3 class="text-xl font-medium text-gray-900 mt-6 mb-3">
        Study Materials
      </h3>
      <p class="mb-4">
        Fees paid for study materials, books, or any other supplementary
        resources are non-refundable once delivered.
      </p>

      <h3 class="text-xl font-medium text-gray-900 mt-6 mb-3">
        Online Courses
      </h3>
      <p class="mb-4">
        No refunds will be provided once a student gains access to online course
        materials or has attended any online sessions.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-6">
        Cancellation Policy
      </h2>

      <h3 class="text-xl font-medium text-gray-900 mt-6 mb-3">
        Course Enrollment
      </h3>
      <p class="mb-4">
        Students may cancel their enrollment in a course at any time before the
        commencement of the course. To cancel enrollment, students must notify
        Takshasheela School of Civil Services via email or phone. If
        cancellation is made before the course begins, the student may be
        eligible for a partial refund as per the Refund Policy stated above.
      </p>

      <h3 class="text-xl font-medium text-gray-900 mt-6 mb-3">Services</h3>
      <p class="mb-4">
        Services such as counseling, mentoring, or any other personalized
        assistance provided by Takshasheela School of Civil Services are
        non-cancellable once initiated.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-4">
        How to Request a Refund or Cancellation
      </h2>
      <p class="mb-4">
        To request a refund or cancel your enrollment, please contact us at <a
          href={`mailto:${EMAIL}`}
          class="text-primary-500 hover:underline font-medium transition-colors"
          >{EMAIL}</a
        > or call <a
          href="tel:6913203751"
          class="text-primary-500 hover:underline font-medium transition-colors"
          >+91 6913203751</a
        >. Ensure to include your full name, course name, and reason for the
        refund or cancellation request in your communication.
      </p>
    </section>

    <section>
      <h2 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-4">
        Policy Changes
      </h2>
      <p class="mb-4">
        Takshasheela School of Civil Services reserves the right to modify or
        update this Refund & Cancellation Policy at any time without prior
        notice. Any changes will be effective immediately upon posting on our
        website.
      </p>
      <p class="mb-4">
        For any further inquiries or clarification regarding our Refund &
        Cancellation Policy, please contact us. Thank you for choosing
        Takshasheela School of Civil Services for your educational needs. We
        appreciate your understanding and cooperation.
      </p>
    </section>
  </div>
</Layout>
