---
import Layout from "@/layouts/Layout.astro";
import { getFacultyList } from "@/lib/team";

const facultyList = getFacultyList();

const seoTitle = "Our Team | Takshasheela School of Civil Services";
const seoDescription =
  "Meet the expert faculties and mentoring guiding our students to success in UPSC and APSC examinations.";
---

<Layout title={seoTitle} description={seoDescription}>
  <div class="bg-primary-500/5 py-12 md:py-20 border-b border-gray-200">
    <div class="container mx-auto px-4 lg:px-24">
      <div
        class="inline-flex items-center shrink-0 max-w-fit flex-nowrap rounded-full border border-gray-200 bg-white px-3 py-1 text-sm font-medium text-gray-600 mb-6 shadow-sm"
      >
        <span
          class="flex h-2 w-2 rounded-full bg-primary-500 mr-2 animate-pulse"
        ></span>
        Our Faculties
      </div>
      <h1
        class="text-4xl md:text-5xl lg:text-7xl font-light tracking-tight text-gray-900 max-w-4xl mb-6 leading-tight"
      >
        Meet The <span class="text-primary-500 font-medium">Team</span>
      </h1>
      <p
        class="text-lg md:text-xl text-gray-600 max-w-2xl font-light mb-8 leading-relaxed"
      >
        Our highly experienced and dedicated team of experts bring decades of
        knowledge to guide your journey in cracking the toughest civil service
        exams.
      </p>
    </div>
  </div>

  <div class="container mx-auto px-4 lg:px-24 py-16 md:py-24">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        facultyList.map((member) => (
          <a
            href={`/faculty/${member.slug}/`}
            class="group flex flex-col bg-white border aspect-2/3 border-gray-200/70 rounded-3xl overflow-hidden hover:shadow-2xl hover:border-primary-500/30 transition-all duration-500"
          >
            <div class="relative w-full overflow-hidden bg-gray-100/20">
              <img
                src={member.image}
                alt={member.name}
                height="350"
                width="300"
                class="object-cover object-top mx-auto aspect-3/4 transform scale-100 group-hover:scale-105 transition-transform duration-700 ease-in-out"
                loading="lazy"
              />
            </div>

            {/* Card Content Block */}
            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-lg font-bold text-gray-900 mb-2.5 leading-tight group-hover:text-primary-500 transition-colors">
                {member.name}
              </h3>

              <div class="flex flex-wrap gap-1.5 mb-3">
                {member.expertise.map((subject) => (
                  <span class="inline-block px-2.5 py-0.5 bg-primary-500/10 text-primary-500 text-[11px] font-semibold rounded-full">
                    {subject}
                  </span>
                ))}
              </div>

              <p class="text-gray-600 text-sm font-light leading-relaxed grow line-clamp-3 mb-4">
                {member.description}
              </p>

              <div class="mt-auto inline-flex items-center text-sm font-medium text-gray-900 group-hover:text-primary-500 transition-colors">
                View Profile
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="ml-1 w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all"
                >
                  <line x1="7" y1="17" x2="17" y2="7" />
                  <polyline points="7 7 17 7 17 17" />
                </svg>
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</Layout>
