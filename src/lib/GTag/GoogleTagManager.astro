---
export interface Props {
  id?: string;
}
const { id = import.meta.env.PUBLIC_GTM_CONTAINER } = Astro.props;
---

{
  id && (
    <script type="text/partytown" is:inline define:vars={{ id }}>
      (function () {
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        window.gtag = gtag;

        // Read stored consent
        var CONSENT_KEY = "takshashila_cookie_consent_v1";
        function readConsent() {
          try {
            var raw = localStorage.getItem(CONSENT_KEY);
            return raw ? JSON.parse(raw) : null;
          } catch (e) {
            return null;
          }
        }

        var savedConsent = readConsent();
        var analyticsGranted = savedConsent ? !!savedConsent.analytics : false;
        var marketingGranted = savedConsent ? !!savedConsent.marketing : false;

        // 1. Google Consent Mode v2 default settings (must run before GTM loads).
        // GTM's own "Consent Initialization" trigger also runs on load and every
        // tag (e.g. the Microsoft Clarity tag) checks analytics_storage/ad_storage
        // via its own Consent Settings — this just sets the state as early as
        // possible, before gtm.js is even requested.
        gtag("consent", "default", {
          ad_storage: marketingGranted ? "granted" : "denied",
          ad_user_data: marketingGranted ? "granted" : "denied",
          ad_personalization: marketingGranted ? "granted" : "denied",
          analytics_storage: analyticsGranted ? "granted" : "denied",
          functionality_storage: "granted",
          security_storage: "granted",
          wait_for_update: 500,
        });

        // 2. Google Tag Manager
        window.dataLayer.push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js",
        });
        var f = document.getElementsByTagName("script")[0];
        var j = document.createElement("script");
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + id;
        if (f && f.parentNode) {
          f.parentNode.insertBefore(j, f);
        } else {
          document.head.appendChild(j);
        }

        // 3. Keep GTM's tags (GA4, Clarity, Ads) in sync when the visitor
        // updates their cookie preferences later without a page reload.
        window.addEventListener("cookie_consent_updated", function (e) {
          var prefs = e.detail || {};
          gtag("consent", "update", {
            ad_storage: prefs.marketing ? "granted" : "denied",
            ad_user_data: prefs.marketing ? "granted" : "denied",
            ad_personalization: prefs.marketing ? "granted" : "denied",
            analytics_storage: prefs.analytics ? "granted" : "denied",
          });
        });
      })();
    </script>
  )
}
<!-- End Google Tag Manager (GA4, Google Ads, and Microsoft Clarity are all configured as tags inside GTM-{id} — see Tag Manager) -->
