---
export interface Props {
  id?: string;
  clarityId?: string;
}
const {
  id = import.meta.env.PUBLIC_GTM_CONTAINER,
  clarityId = import.meta.env.PUBLIC_CLARITY_PROJECT_ID,
} = Astro.props;
---

<!-- Google Consent Mode v2, Google Tag Manager & Microsoft Clarity -->
<script is:inline define:vars={{ id, clarityId }}>
  (function () {
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    window.gtag = gtag;

    // Read stored consent
    var CONSENT_KEY = "takshashila_cookie_consent_v1";
    var savedConsent = null;
    try {
      var raw = localStorage.getItem(CONSENT_KEY);
      if (raw) savedConsent = JSON.parse(raw);
    } catch (e) {}

    var analyticsGranted = savedConsent ? !!savedConsent.analytics : false;
    var marketingGranted = savedConsent ? !!savedConsent.marketing : false;

    // 1. Google Consent Mode v2 Default Settings (must run BEFORE GTM script)
    gtag("consent", "default", {
      ad_storage: marketingGranted ? "granted" : "denied",
      ad_user_data: marketingGranted ? "granted" : "denied",
      ad_personalization: marketingGranted ? "granted" : "denied",
      analytics_storage: analyticsGranted ? "granted" : "denied",
      functionality_storage: "granted",
      security_storage: "granted",
      wait_for_update: 500,
    });

    // 2. Inject Google Tag Manager Container
    if (id) {
      window.dataLayer.push({
        "gtm.start": new Date().getTime(),
        event: "gtm.js",
      });
      var f = document.getElementsByTagName("script")[0];
      var j = document.createElement("script");
      j.async = true;
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + id;
      if (f && f.parentNode) {
        f.parentNode.insertBefore(j, f);
      } else {
        document.head.appendChild(j);
      }
    }

    // 3. Inject Microsoft Clarity if analytics consent is granted
    if (analyticsGranted && clarityId) {
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        if (y && y.parentNode) {
          y.parentNode.insertBefore(t, y);
        } else {
          document.head.appendChild(t);
        }
      })(window, document, "clarity", "script", clarityId);
    }
  })();
</script>
<!-- End Google Tag Manager & Microsoft Clarity -->
