---
import { SEO } from "astro-seo";
import { Schema } from "astro-seo-schema";
import { Font } from "astro:assets";
import "../styles/globals.css";
import Navbar from "@/components/Header.vue";
import LeadPopup from "@/components/LeadPopup.vue";
import Footer from "@/components/Footer.astro";
import GoogleTagManager from "@/lib/GTag/GoogleTagManager.astro";
import GoogleTagManagerNoscript from "@/lib/GTag/GoogleTagManagerNoscript.astro";
import { SITE_URL } from "@/config/CONSTANTS.ts";

// variables.CRM_URL always resolves to the private server value in frontmatter; this needs the public origin.
const crmOrigin =
  import.meta.env.PUBLIC_CRM_URL || "https://crm.takshashilascs.com";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  keywords?: string;
}

const defaultKeywords =
  "apsc coaching in guwahati, apsc coaching, adre coaching, upsc, apsc full form, upsc full form, best apsc coaching in guwahati, adre syllabus, apsc syllabus, upsc syllabus, apsc cce full form, scs current affairs, upsc coaching in assam, apsc coaching in assam, upsc strategy, upsc 2026 exam date, adre exam date,  guwahati apsc coaching centre, difference between apsc and upsc, apsc vs upsc, best coaching center in Northeast India, guwahati upsc coaching centre, syllabus of upsc, civil service exam, coaching center, coaching centre in guwahati, assam coaching centre";

// Normalize to the canonical host + trailing slash regardless of which
// host/slash variant the page was actually requested on.
let normalizedPath = Astro.url.pathname;
if (!normalizedPath.endsWith("/")) normalizedPath += "/";
const defaultCanonical = new URL(normalizedPath, SITE_URL).href;

const {
  title = "The Best UPSC and APSC Coaching in Guwahati - Takshasheela School of Civil Services",
  description = "At Takshasheela School of Civil Services, the best UPSC and APSC coaching in Guwahati, we are committed to helping you achieve your dream of becoming a civil servant. Prepare for ADRE, APSC, and UPSC. Both online and offline batches are available, best coaching institute in guwahati",
  image = "/og/index.png",
  canonical = defaultCanonical,
  keywords = defaultKeywords,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <GoogleTagManager />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href={crmOrigin} />
    <link rel="preconnect" href={SITE_URL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="keywords" content={keywords} />
    <title>{title}</title>
    <slot name="head_data" />
    <SEO
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: title,
          type: "website",
          image: new URL(image, Astro.url).href,
        },
        optional: {
          description: description,
          siteName: "Takshasheela School of Civil Services",
        },
      }}
      twitter={{
        creator: "@takshashila",
        card: "summary_large_image",
        title: title,
        description: description,
        image: new URL(image, Astro.url).href,
      }}
    />
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        name: "Takshasheela School of Civil Services",
        description: description,
        url: Astro.site ? Astro.site.href : SITE_URL,
        logo: `${SITE_URL}/favicon.svg`,
        address: {
          "@type": "PostalAddress",
          addressLocality: "Guwahati",
          addressRegion: "Assam",
          addressCountry: "IN",
        },
      }}
    />
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <Font cssVariable="--geist-sans" preload />
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer></script>
  </head>
  <body
    class="antialiased overflow-x-hidden selection:bg-primary/20 selection:text-primary"
  >
    <GoogleTagManagerNoscript />
    <Navbar client:load />
    <main class="flex flex-col gap-8">
      <slot />
    </main>
    <LeadPopup client:only="vue" />
    <Footer />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
