---
import "../styles/globals.css";

import SEO from "@/components/SEO.astro";
import { Schema } from "astro-seo-schema";
import { Font } from "astro:assets";

import variables from "@/config/variables.ts";

import Navbar from "@/components/header/Header.astro";
import LeadPopup from "@/components/LeadPopup.vue";
import CookieConsent from "@/components/CookieConsent.vue";
import Footer from "@/components/Footer.astro";
import GoogleTagManager from "@/lib/GTag/GoogleTagManager.astro";
import GoogleTagManagerNoscript from "@/lib/GTag/GoogleTagManagerNoscript.astro";
import { SITE_URL, PHONE_TEL, EMAIL, socials } from "@/config/CONSTANTS.ts";

// variables.CRM_URL always resolves to the private server value in frontmatter; this needs the public origin.
const crmOrigin =
  import.meta.env.PUBLIC_CRM_URL || "https://crm.takshashilascs.com";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
}

// Normalizing to the canonical host + trailing slash regardless of which
// host/slash variant the page was actually requested on.
let normalizedPath = Astro.url.pathname;
if (!normalizedPath.endsWith("/")) normalizedPath += "/";
const defaultCanonical = new URL(normalizedPath, SITE_URL).href;

const isHomePage = Astro.url.pathname === "/" || Astro.url.pathname === "";

const {
  title = "Best UPSC & APSC Coaching in Guwahati | Takshasheela SCS",
  description = "Join Takshasheela School of Civil Services for expert UPSC, APSC & ADRE coaching in Guwahati. Online/offline batches with comprehensive study material.",
  image = "/og/index.png",
  canonical = defaultCanonical,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <GoogleTagManager />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Preconnects for critical third-party origins -->
    <link rel="preconnect" href="https://challenges.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://api.iconify.design" crossorigin />

    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
    />
    <Schema
      item={{
        "@context": "https://schema.org",
        "@type": ["EducationalOrganization", "LocalBusiness"],
        "@id": `${SITE_URL}/#organization`,
        name: "Takshashila School of Civil Services",
        alternateName: "Takshasheela SCS",
        description: description,
        url: Astro.site ? Astro.site.href : SITE_URL,
        logo: `${SITE_URL}/logo-full-black.png`,
        image: new URL(image, Astro.url).href,
        telephone: [
          "+91 60016 57575",
          "+91 69132 03751"
        ],
        email: EMAIL,
        address: {
          "@type": "PostalAddress",
          addressLocality: "Guwahati",
          addressRegion: "Assam",
          addressCountry: "IN",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: 26.1411661,
          longitude: 91.7962836,
        },
        openingHoursSpecification: {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: [
            "Monday",
            "Tuesday",
            "Wednesday",
            "Thursday",
            "Friday",
            "Saturday",
            "Sunday",
          ],
          opens: "10:00",
          closes: "19:00",
        },
        areaServed: { "@type": "State", name: "Assam" },
        sameAs: [
          socials.FACEBOOK,
          socials.INSTAGRAM,
          socials.TWITTER,
          socials.YOUTUBE,
          socials.LINKEDIN,
        ],
      }}
    />
    <slot name="head_data" />
    <script is:inline defer src="https://code.iconify.design/iconify-icon/2.3.0/iconify-icon.min.js"></script>
    <Font cssVariable="--geist-sans" preload />
  </head>
  <body
    class="antialiased overflow-x-hidden selection:bg-primary-500/20 selection:text-primary-500"
  >
    <GoogleTagManagerNoscript />
    <Navbar />
    <main>
      <slot />
    </main>
    {!isHomePage && <LeadPopup client:only="vue" />}
    <CookieConsent client:only="vue" />
    <Footer />
  </body>
</html>
<script>
  import "iconify-icon";
  import { trackContactClick } from "@/lib/analytics";

  document.addEventListener("click", (e) => {
    const target = (e.target as HTMLElement | null)?.closest("a");
    if (!target) return;
    const href = target.getAttribute("href") || "";

    if (href.startsWith("tel:")) {
      trackContactClick("phone", href.replace("tel:", ""));
    } else if (href.includes("wa.me") || href.includes("whatsapp")) {
      trackContactClick("whatsapp", href);
    }
  });
</script>
<style>
  @reference "../styles/globals.css";
  main {
    @apply flex flex-col  w-full;
  }
</style>
