---
import { SEO } from "astro-seo";
import '../styles/globals.css';
import Hero from "@/components/Hero.astro";
import Features from "@/components/Features.astro";
import Header from '@/components/Header.astro';
import LeadPopup from '@/components/LeadPopup.vue';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const { 
  title = "Takshashila School of Civil Services | Best UPSC & APSC Coaching in Guwahati", 
  description = "At Takshashila School of Civil Services, the best UPSC and APSC coaching in Guwahati, we are committed to helping you achieve your dream of becoming a civil servant.",
  image = "/Takshashila/students-view-back.jpg"
} = Astro.props;
---
<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="preconnect" href="https://takshashilascs.com" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<SEO
          title={title}
          description={description}
          openGraph={{
            basic: {
              title: title,
              type: "website",
              image: image,
            }
          }}
          twitter={{
            creator: "@takshashila"
          }}
        />
	</head>
	<body class="antialiased overflow-x-hidden selection:bg-primary/20 selection:text-primary">
	<Header />
	<main class="flex flex-col gap-8 ">
		<slot />
	</main>
	<LeadPopup client:only="vue" />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
